# Configure these in each Wappler target/environment. Never commit real secrets.
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=
EMAIL_REPLY_TO=
EMAIL_ARCHIVE_BCC=
APP_BASE_URL=http://localhost:3000
EMAIL_ENABLED=false
RESEND_WEBHOOK_SECRET=

# Metipath tenant encryption. Generate a different Base64 32-byte key per environment.
METIPATH_ENCRYPTION_KEY_VERSION=1
METIPATH_ENCRYPTION_MASTER_KEY_V1=

# Nylas v3 Sandbox foundation (server-side only).
NYLAS_API_KEY=
NYLAS_API_URI=https://api.us.nylas.com
NYLAS_CLIENT_ID=
NYLAS_CALLBACK_URL=http://localhost:3000/api/email/oauth/callback
NYLAS_WEBHOOK_SECRET=
NYLAS_WEBHOOK_SECRET=
