<!-- Wappler include head-page="layouts/main_shell" fontawesome_5="cdn" bootstrap5="local" is="dmx-app" id="commercial_configuration" appConnect="local" -->
<dmx-serverconnect id="scCommercialConfig" url="/api/commercial/configuration" dmx-param:workflowTypeId="query.id"></dmx-serverconnect>
<div class="d-flex justify-content-between align-items-start gap-3 mb-4"><div><h1 class="mb-1">Commercial / Funding configuration</h1><p class="text-muted mb-0"><span dmx-text="scCommercialConfig.data.commercial.workflowType.typeName"></span> determines the sections and questions; Dictionary settings control language only.</p></div><a class="btn btn-outline-secondary" href="/workflow-types">Back to workflow types</a></div>
<div class="row g-4"><div class="col-12"><div class="card border-0 shadow-sm"><div class="card-header bg-white"><h2 class="h5 mb-0">Sections</h2></div><div class="card-body vstack gap-3" is="dmx-repeat" id="commercialSectionConfig" dmx-bind:repeat="scCommercialConfig.data.commercial.sections"><form class="row g-2 align-items-end border-bottom pb-3" is="dmx-serverconnect-form" method="post" action="/api/commercial/saveConfiguration" dmx-on:success="scCommercialConfig.load()"><%- _csrfInput() %><input type="hidden" name="workflowTypeId" dmx-bind:value="query.id"><input type="hidden" name="entity" value="section"><input type="hidden" name="id" dmx-bind:value="id"><input type="hidden" name="sectionKey" dmx-bind:value="sectionKey"><div class="col-md-3"><label class="form-label">Section</label><div class="form-control-plaintext text-capitalize" dmx-text="sectionKey.replace('_',' ')"></div></div><div class="col-md-4"><label class="form-label">Heading</label><input class="form-control" name="label" dmx-bind:value="heading"></div><div class="col-md-2"><label class="form-label">Order</label><input class="form-control" type="number" name="sortOrder" dmx-bind:value="sortOrder"></div><div class="col-md-2"><label class="form-label">Enabled</label><select class="form-select" name="isActive" dmx-bind:value="isEnabled"><option value="1">Yes</option><option value="0">No</option></select></div><div class="col-md-1"><button class="btn btn-primary" type="submit">Save</button></div></form></div></div></div>
<div class="col-lg-6"><div class="card border-0 shadow-sm"><div class="card-header bg-white"><h2 class="h5 mb-0">Agreement &amp; responsibility options</h2></div><div class="card-body"><div class="vstack gap-3 mb-4" is="dmx-repeat" id="commercialOptionConfig" dmx-bind:repeat="scCommercialConfig.data.commercial.options"><form class="border-bottom pb-3" is="dmx-serverconnect-form" method="post" action="/api/commercial/saveConfiguration" dmx-on:success="scCommercialConfig.load()"><%- _csrfInput() %><input type="hidden" name="workflowTypeId" dmx-bind:value="query.id"><input type="hidden" name="entity" value="option"><input type="hidden" name="id" dmx-bind:value="id"><input type="hidden" name="optionGroup" dmx-bind:value="optionGroup"><input type="hidden" name="itemKey" dmx-bind:value="optionKey"><div class="row g-2"><div class="col-12 small text-muted text-capitalize" dmx-text="optionGroup.replace('_',' ')"></div><div class="col-md-5"><input class="form-control" name="label" dmx-bind:value="label" required></div><div class="col-md-2"><input class="form-control" type="number" name="sortOrder" dmx-bind:value="sortOrder" title="Sort order"></div><div class="col-md-3"><select class="form-select" name="isActive" dmx-bind:value="isActive"><option value="1">Active</option><option value="0">Disabled</option></select></div><div class="col-md-2"><button class="btn btn-primary w-100" type="submit">Save</button></div><div class="col-12" dmx-show="optionGroup == 'agreement_type'"><input class="form-control form-control-sm font-monospace" name="fieldRulesJson" dmx-bind:value="fieldRulesJson" title="Conditional field visibility rules"></div></div></form></div><form is="dmx-serverconnect-form" method="post" action="/api/commercial/saveConfiguration" dmx-on:success="reset();scCommercialConfig.load()"><%- _csrfInput() %><input type="hidden" name="workflowTypeId" dmx-bind:value="query.id"><input type="hidden" name="entity" value="option"><input type="hidden" name="isActive" value="1"><div class="row g-2"><div class="col-md-4"><select class="form-select" name="optionGroup"><option value="agreement_type">Agreement type</option><option value="responsibility">Responsibility</option></select></div><div class="col-md-4"><input class="form-control" name="label" placeholder="Label" required></div><div class="col-md-4"><input class="form-control" name="itemKey" placeholder="Stable key" required></div><div class="col-12"><input class="form-control font-monospace" name="fieldRulesJson" value="{}" placeholder='Conditional rules JSON'></div><div class="col-12 text-end"><button class="btn btn-primary" type="submit">Add option</button></div></div></form></div></div></div>
<div class="col-lg-6"><div class="card border-0 shadow-sm"><div class="card-header bg-white"><h2 class="h5 mb-0">Responsibility item definitions</h2></div><div class="card-body"><div class="vstack gap-3 mb-4" is="dmx-repeat" id="commercialDefinitionConfig" dmx-bind:repeat="scCommercialConfig.data.commercial.definitions"><form class="border-bottom pb-3" is="dmx-serverconnect-form" method="post" action="/api/commercial/saveConfiguration" dmx-on:success="scCommercialConfig.load()"><%- _csrfInput() %><input type="hidden" name="workflowTypeId" dmx-bind:value="query.id"><input type="hidden" name="entity" value="definition"><input type="hidden" name="id" dmx-bind:value="id"><input type="hidden" name="itemKey" dmx-bind:value="itemKey"><input type="hidden" name="askResponsibility" dmx-bind:value="askResponsibility"><input type="hidden" name="allowNotes" dmx-bind:value="allowNotes"><div class="row g-2"><div class="col-12"><input class="form-control" name="label" dmx-bind:value="label" required></div><div class="col-4"><label class="small">Amount</label><select class="form-select form-select-sm" name="allowAmount" dmx-bind:value="allowAmount"><option value="1">Yes</option><option value="0">No</option></select></div><div class="col-4"><label class="small">Percentage</label><select class="form-select form-select-sm" name="allowPercentage" dmx-bind:value="allowPercentage"><option value="1">Yes</option><option value="0">No</option></select></div><div class="col-4"><label class="small">Quantity</label><select class="form-select form-select-sm" name="allowQuantity" dmx-bind:value="allowQuantity"><option value="1">Yes</option><option value="0">No</option></select></div><div class="col-4"><label class="small">VAT</label><select class="form-select form-select-sm" name="allowVat" dmx-bind:value="allowVat"><option value="1">Yes</option><option value="0">No</option></select></div><div class="col-4"><label class="small">Required</label><select class="form-select form-select-sm" name="isRequired" dmx-bind:value="isRequired"><option value="1">Yes</option><option value="0">No</option></select></div><div class="col-4"><label class="small">Status</label><select class="form-select form-select-sm" name="isActive" dmx-bind:value="isActive"><option value="1">Active</option><option value="0">Disabled</option></select></div><div class="col-8"><input class="form-control form-control-sm" type="number" name="sortOrder" dmx-bind:value="sortOrder" title="Sort order"></div><div class="col-4"><button class="btn btn-primary btn-sm w-100" type="submit">Save</button></div></div></form></div><form is="dmx-serverconnect-form" method="post" action="/api/commercial/saveConfiguration" dmx-on:success="reset();scCommercialConfig.load()"><%- _csrfInput() %><input type="hidden" name="workflowTypeId" dmx-bind:value="query.id"><input type="hidden" name="entity" value="definition"><input type="hidden" name="isActive" value="1"><input type="hidden" name="askResponsibility" value="1"><input type="hidden" name="allowNotes" value="1"><div class="row g-2"><div class="col-6"><input class="form-control" name="label" placeholder="Item label" required></div><div class="col-6"><input class="form-control" name="itemKey" placeholder="Stable key" required></div><div class="col-4 form-check ms-2"><input class="form-check-input" type="checkbox" name="allowAmount" value="1" id="cfgAmount"><label class="form-check-label" for="cfgAmount">Amount</label></div><div class="col-4 form-check"><input class="form-check-input" type="checkbox" name="allowPercentage" value="1" id="cfgPercentage"><label class="form-check-label" for="cfgPercentage">Percentage</label></div><div class="col-3 form-check"><input class="form-check-input" type="checkbox" name="allowQuantity" value="1" id="cfgQuantity"><label class="form-check-label" for="cfgQuantity">Quantity</label></div><div class="col-12 text-end"><button class="btn btn-primary" type="submit">Add item</button></div></div></form></div></div></div></div>
<meta name="ac:route" content="/workflow-types/commercial">
