<!-- Wappler include head-page="layouts/main_shell" fontawesome_5="cdn" bootstrap5="local" is="dmx-app" id="connected_mailbox" appConnect="local" -->
<dmx-value id="hoverCommunicationId"></dmx-value>
<dmx-value id="selectedCommunicationId"></dmx-value>
<dmx-serverconnect id="scUnmatched" url="/api/communications/unmatched"></dmx-serverconnect>
<dmx-serverconnect id="scEventSearch" url="/api/communications/searchRecords" noload></dmx-serverconnect>
<dmx-serverconnect id="scIntegrationStatus" url="/api/email/integration/status"></dmx-serverconnect>

<div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
  <div><h1 class="mb-1">Communications</h1><p class="text-muted mb-0">Review email that has not yet been linked to an event</p></div>
  <div class="d-flex flex-wrap gap-2">
    <form is="dmx-serverconnect-form" method="post" action="/api/communications/syncMailbox" dmx-on:success="scUnmatched.load()" dmx-show="scIntegrationStatus.data.mailbox.canManage && scIntegrationStatus.data.mailbox.connections.count() > 0"><%- _csrfInput() %><input type="hidden" name="emailConnectionId" dmx-bind:value="scIntegrationStatus.data.mailbox.connections[0].id"><button class="btn btn-primary" type="submit"><i class="fas fa-cloud-download-alt me-2"></i>Process Recent Email</button></form>
    <a href="/settings/integrations/email" class="btn btn-outline-secondary">Email Integration</a>
  </div>
</div>

<div class="d-flex align-items-center gap-2 mb-3" dmx-show="scIntegrationStatus.data.mailbox.canManage"><h2 class="h5 mb-0"><i class="fas fa-question-circle me-2"></i>Unmatched email</h2><span class="badge bg-warning text-dark" dmx-text="scUnmatched.data.email.communications.count()">0</span></div>

<section dmx-show="scIntegrationStatus.data.mailbox.canManage">
  <div class="alert alert-info"><strong>Only unmatched incoming messages appear here.</strong> Use Process Recent Email above when testing locally. Ambiguous messages are never linked automatically.</div>
  <div class="vstack gap-3" is="dmx-repeat" id="unmatchedRows" dmx-bind:repeat="scUnmatched.data.email.communications">
    <article class="card border-0 shadow-sm" tabindex="0" dmx-on:mouseenter="hoverCommunicationId.setValue(id)" dmx-on:mouseleave="hoverCommunicationId.setValue('')" dmx-on:focus="hoverCommunicationId.setValue(id)" dmx-on:blur="hoverCommunicationId.setValue('')">
      <div class="card-body p-4">
        <div class="d-flex justify-content-between gap-3"><div><h2 class="h5 mb-1" dmx-text="subject"></h2><div class="small text-muted"><span dmx-text="sender[0].name.default(sender[0].email)"></span> &middot; <span dmx-text="date.formatDate('dd MMM yyyy HH:mm')"></span></div></div><span class="badge bg-warning text-dark align-self-start">Unmatched</span></div>
        <div class="border rounded p-3 my-3 bg-light" dmx-show="suggestions.count() > 0"><div class="fw-semibold mb-2">Suggested event</div><div class="vstack gap-2" is="dmx-repeat" dmx-bind:repeat="suggestions"><div class="d-flex justify-content-between align-items-center gap-2"><div><strong dmx-text="referenceCode"></strong> &mdash; <span dmx-text="workflowName"></span></div><form is="dmx-serverconnect-form" method="post" action="/api/communications/assign" dmx-on:success="scUnmatched.load()"><%- _csrfInput() %><input type="hidden" name="communicationId" dmx-bind:value="$parent.id"><input type="hidden" name="workflowId" dmx-bind:value="id"><button class="btn btn-primary btn-sm" type="submit">Assign to Event</button></form></div></div></div>
        <div class="d-flex flex-wrap gap-2"><button class="btn btn-primary" type="button" dmx-on:click="selectedCommunicationId.setValue(id);eventSearchInput.setValue('');assignEventModal.show()"><i class="fas fa-link me-2"></i>Assign to Event</button><button class="btn btn-outline-primary" type="button" dmx-on:click="selectedCommunicationId.setValue(id);eventSearchInput.setValue('');assignEventModal.show()"><i class="fas fa-search me-2"></i>Search Events</button><form is="dmx-serverconnect-form" method="post" action="/api/communications/ignore" dmx-on:success="scUnmatched.load()"><%- _csrfInput() %><input type="hidden" name="communicationId" dmx-bind:value="id"><button class="btn btn-outline-secondary" type="submit">Not Relevant</button></form></div>
      </div>
      <aside class="card shadow-lg border-primary position-fixed bottom-0 end-0 m-4 communication-hover-preview" style="z-index:1080;width:min(30rem,calc(100vw - 2rem))" dmx-show="hoverCommunicationId.value == id"><div class="card-body"><div class="fw-semibold mb-2" dmx-text="subject"></div><div class="small" dmx-text="preview"></div></div></aside>
    </article>
  </div>
  <div class="card border-0 shadow-sm" dmx-show="scUnmatched.data.email.communications.count() == 0"><div class="card-body text-center py-5 text-muted"><i class="fas fa-check-circle fa-2x mb-3"></i><div>No unmatched email requires review.</div><div class="small mt-2">Click Process Recent Email when testing locally.</div></div></div>
</section>

<div class="modal fade" id="assignEventModal" is="dmx-bs5-modal" tabindex="-1" aria-labelledby="assignEventTitle" aria-hidden="true"><div class="modal-dialog modal-lg modal-dialog-centered"><div class="modal-content"><div class="modal-header"><div><h2 class="modal-title h5" id="assignEventTitle">Assign Email to Event</h2><p class="small text-muted mb-0">Search by event, reference, promoter, contact, organisation or email.</p></div><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body"><div class="input-group mb-3"><input id="eventSearchInput" class="form-control" type="search" placeholder="Search events" dmx-on:input.debounce:350="scEventSearch.load({q:value})"><button class="btn btn-outline-secondary" type="button" dmx-on:click="scEventSearch.load({q:eventSearchInput.value})"><i class="fas fa-search"></i></button></div><div class="text-muted text-center py-4" dmx-show="eventSearchInput.value.length < 2">Enter at least two characters.</div><div class="list-group" is="dmx-repeat" id="eventSearchResults" dmx-bind:repeat="scEventSearch.data.email.records"><form class="list-group-item list-group-item-action d-flex justify-content-between align-items-center gap-3" is="dmx-serverconnect-form" method="post" action="/api/communications/assign" dmx-on:success="assignEventModal.hide();scUnmatched.load()"><%- _csrfInput() %><input type="hidden" name="communicationId" dmx-bind:value="selectedCommunicationId.value"><input type="hidden" name="workflowId" dmx-bind:value="id"><div><strong dmx-text="referenceCode"></strong> &mdash; <span dmx-text="workflowName"></span></div><button class="btn btn-primary btn-sm" type="submit">Assign to Event</button></form></div></div></div></div></div>
<meta name="ac:route" content="/communications/mailbox">
