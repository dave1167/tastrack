<!-- Wappler include head-page="layouts/main_shell" fontawesome_5="cdn" bootstrap5="local" is="dmx-app" id="connected_mailbox" appConnect="local" -->
<dmx-serverconnect id="scMessages" url="/api/email/mailbox/messages" dmx-param:cursor="query.cursor" dmx-param:sender="query.sender" dmx-param:subject="query.subject" dmx-param:unread="query.unread" dmx-param:has-attachment="query.hasAttachment"></dmx-serverconnect>
<div class="d-flex justify-content-between mb-4"><div><h1 class="mb-1">Communications</h1><p class="text-muted">Connected Mailbox</p></div><a href="/settings/integrations/email" class="btn btn-outline-secondary">Email Integration</a></div><div class="alert alert-danger" dmx-show="scMessages.data.mailbox.success == false"><span dmx-text="scMessages.data.mailbox.message"></span><a class="alert-link ms-2" href="/settings/integrations/email" dmx-show="scMessages.data.mailbox.errorCode == 'REAUTHENTICATION_REQUIRED'">Reconnect</a></div><div dmx-show="scMessages.data.mailbox.success"><div class="card border-0 shadow-sm mb-3"><div class="card-body d-flex gap-4"><div><small class="text-muted d-block">Workflow Mailbox</small><strong dmx-text="scMessages.data.mailbox.mailbox.address"></strong></div><div><small class="text-muted d-block">Provider</small><span dmx-text="scMessages.data.mailbox.mailbox.provider"></span></div><div><small class="text-muted d-block">Purpose</small><span dmx-text="scMessages.data.mailbox.mailbox.purpose"></span></div><span class="badge bg-success align-self-start">Connected</span></div></div><form method="get" class="card border-0 shadow-sm mb-3"><div class="card-body row g-2"><div class="col-md-4"><input name="sender" class="form-control" placeholder="Sender email" dmx-bind:value="query.sender"></div><div class="col-md-4"><input name="subject" class="form-control" placeholder="Subject contains" dmx-bind:value="query.subject"></div><div class="col-auto form-check align-self-center"><input class="form-check-input" type="checkbox" name="unread" value="true" id="unread"><label class="form-check-label" for="unread">Unread</label></div><div class="col-auto form-check align-self-center"><input class="form-check-input" type="checkbox" name="hasAttachment" value="true" id="attach"><label class="form-check-label" for="attach">Attachments</label></div><div class="col-auto"><button class="btn btn-primary">Filter</button></div></div></form><div class="card border-0 shadow-sm"><div class="list-group list-group-flush" is="dmx-repeat" id="messageRows" dmx-bind:repeat="scMessages.data.mailbox.messages"><a class="list-group-item list-group-item-action py-3" dmx-bind:href="'/communications/mailbox/message?message=' + messageToken"><div class="d-flex justify-content-between gap-3"><div class="text-truncate"><strong><span dmx-text="direction == 'incoming' ? '↓ ' : '↑ '"></span><span dmx-text="subject"></span></strong><div class="small text-muted text-truncate"><span dmx-text="from[0].name.default(from[0].email)"></span> · <span dmx-text="snippet"></span></div></div><div class="text-nowrap small"><i class="fas fa-paperclip me-2" dmx-show="hasAttachments"></i><span class="badge bg-primary me-2" dmx-show="unread">Unread</span><span dmx-text="date.toDateTime().formatDate('dd MMM HH:mm')"></span></div></div></a></div><div class="card-body text-center text-muted" dmx-show="scMessages.data.mailbox.messages.count() == 0">No messages found.</div></div><div class="text-end mt-3"><a class="btn btn-outline-primary" dmx-show="scMessages.data.mailbox.nextCursor" dmx-bind:href="'/communications/mailbox?cursor=' + scMessages.data.mailbox.nextCursor">Next 25</a></div></div><meta name="ac:route" content="/communications/mailbox">
