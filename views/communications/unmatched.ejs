<!-- Wappler include head-page="layouts/main_shell" fontawesome_5="cdn" bootstrap5="local" is="dmx-app" id="unmatched_email" appConnect="local" -->
<dmx-serverconnect id="scUnmatched" url="/api/communications/unmatched"></dmx-serverconnect>
<dmx-serverconnect id="scRecordSearch" url="/api/communications/searchRecords" dmx-param:q="recordSearch.value"></dmx-serverconnect>
<div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4"><div><h1 class="mb-1">Unmatched Email</h1><p class="text-muted mb-0">Review incoming operational email that could not be linked safely.</p></div><a class="btn btn-outline-secondary" href="/communications/mailbox"><i class="fas fa-inbox me-2"></i>Mailbox browser</a></div>
<div class="alert alert-info"><strong>Ambiguous email is never linked automatically.</strong> Choose the correct record or mark the message as not relevant.</div>
<div class="card border-0 shadow-sm mb-4"><div class="card-body"><label class="form-label" for="recordSearch">Search records</label><input id="recordSearch" class="form-control" type="search" placeholder="Reference or record name" dmx-on:input.debounce:400="scRecordSearch.load()"></div></div>
<div class="vstack gap-3" is="dmx-repeat" id="unmatchedRows" dmx-bind:repeat="scUnmatched.data.email.communications">
  <article class="card border-0 shadow-sm"><div class="card-body"><div class="d-flex justify-content-between gap-3"><div><h2 class="h5 mb-1" dmx-text="subject"></h2><div class="small text-muted"><span dmx-text="sender[0].name.default(sender[0].email)"></span> &middot; <span dmx-text="date.formatDate('dd MMM yyyy HH:mm')"></span> &middot; <span dmx-text="provider"></span></div></div><span class="badge bg-warning text-dark align-self-start">Unmatched</span></div><p class="mt-3 mb-3" dmx-text="preview"></p>
    <div class="mb-3" dmx-show="suggestions.count()"><div class="small fw-semibold mb-2">Suggested records</div><div class="d-flex flex-wrap gap-2" is="dmx-repeat" dmx-bind:repeat="suggestions"><form is="dmx-serverconnect-form" method="post" action="/api/communications/assign" dmx-on:success="scUnmatched.load()"><%- _csrfInput() %><input type="hidden" name="communicationId" dmx-bind:value="$parent.id"><input type="hidden" name="workflowId" dmx-bind:value="id"><button class="btn btn-sm btn-outline-primary" type="submit"><span dmx-text="referenceCode + ' — ' + workflowName"></span></button></form></div></div>
    <div class="row g-2"><div class="col-md"><form is="dmx-serverconnect-form" method="post" action="/api/communications/assign" class="d-flex gap-2" dmx-on:success="scUnmatched.load()"><%- _csrfInput() %><input type="hidden" name="communicationId" dmx-bind:value="id"><select class="form-select form-select-sm" name="workflowId" required dmx-bind:options="scRecordSearch.data.email.records" optionvalue="id" optiontext="referenceCode + ' — ' + workflowName"><option value="">Choose searched record</option></select><button class="btn btn-primary btn-sm" type="submit">Assign</button></form></div><div class="col-md-auto"><form is="dmx-serverconnect-form" method="post" action="/api/communications/ignore" dmx-on:success="scUnmatched.load()"><%- _csrfInput() %><input type="hidden" name="communicationId" dmx-bind:value="id"><button class="btn btn-outline-secondary btn-sm" type="submit">Not relevant to Metipath</button></form></div></div>
  </div></article>
</div>
<div class="card border-0 shadow-sm" dmx-show="scUnmatched.data.email.communications.count() == 0"><div class="card-body text-center py-5 text-muted"><i class="fas fa-check-circle fa-2x mb-3"></i><div>No unmatched incoming email requires review.</div></div></div>
<meta name="ac:route" content="/communications/unmatched">
