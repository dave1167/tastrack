<!-- Wappler include head-page="layouts/main_shell" fontawesome_5="cdn" bootstrap5="local" is="dmx-app" id="mailbox_message" appConnect="local" -->
<dmx-serverconnect id="scMessage" url="/api/email/mailbox/message" dmx-param:message="query.message"></dmx-serverconnect><a href="/communications/mailbox" class="small text-decoration-none">← Connected Mailbox</a><div class="alert alert-danger mt-3" dmx-show="scMessage.data.mailbox.success == false" dmx-text="scMessage.data.mailbox.message"></div><div class="card border-0 shadow-sm mt-3" dmx-show="scMessage.data.mailbox.success"><div class="card-body p-4"><div class="d-flex justify-content-between"><h1 class="h4" dmx-text="scMessage.data.mailbox.message.subject"></h1><span dmx-text="scMessage.data.mailbox.message.direction == 'incoming' ? '↓ Incoming' : '↑ Outgoing'"></span></div><hr><p><strong>From:</strong> <span dmx-text="scMessage.data.mailbox.message.from[0].name.default(scMessage.data.mailbox.message.from[0].email)"></span></p><p><strong>To:</strong> <span dmx-text="scMessage.data.mailbox.message.to.map('email').join(', ')"></span></p><p dmx-show="scMessage.data.mailbox.message.cc.count()"><strong>CC:</strong> <span dmx-text="scMessage.data.mailbox.message.cc.map('email').join(', ')"></span></p><pre class="bg-body-tertiary rounded p-3" style="white-space:pre-wrap;font-family:inherit" dmx-text="scMessage.data.mailbox.message.bodyText"></pre><div dmx-show="scMessage.data.mailbox.message.attachments.count()"><h2 class="h6">Attachments</h2><ul class="list-group" is="dmx-repeat" id="attachmentRows" dmx-bind:repeat="scMessage.data.mailbox.message.attachments"><li class="list-group-item"><i class="fas fa-paperclip me-2"></i><span dmx-text="filename"></span> <small class="text-muted" dmx-text="contentType"></small></li></ul></div></div></div><meta name="ac:route" content="/communications/mailbox/message">
