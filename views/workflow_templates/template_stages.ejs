<!-- Wappler include head-page="layouts/main_shell" fontawesome_5="cdn" bootstrap5="local" is="dmx-app" id="template_stages" appConnect="local" components="{dmxStateManagement:{}}" -->
<dmx-serverconnect id="scTemplate" url="/api/templates/get" dmx-param:id="query.id"></dmx-serverconnect>
<dmx-serverconnect id="scStages" url="/api/workflow_templates/list_stages" dmx-param:templateid="query.id"></dmx-serverconnect>

<div class="row g-4">
    <div class="col-12">
        <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3">
            <div><h1 class="mb-1">Edit Template Structure</h1><p class="text-muted mb-0"><span dmx-text="scTemplate.data.query[0].templateName"></span><span> · Review </span><span dmx-text="scTerminology.data.query[0].stagePlural.default('Phases').lowercase()">phases</span><span>, edit their settings, or manage their questions.</span></p></div>
            <div class="d-flex flex-wrap gap-2"><button class="btn btn-primary" type="button" data-bs-toggle="collapse" data-bs-target="#addPhasePanel" aria-expanded="false" aria-controls="addPhasePanel"><i class="fas fa-plus me-1"></i><span dmx-text="'Add ' + scTerminology.data.query[0].stageSingular.default('Phase')">Add Phase</span></button><a class="btn btn-outline-secondary" href="/workflow_templates">Templates</a><a class="btn btn-outline-secondary" dmx-bind:href="'/workflow_templates/template_structure?id=' + query.id"><i class="fas fa-sitemap me-1"></i>Preview</a><a class="btn btn-outline-primary" dmx-bind:href="'/workflow_templates/template_task_dependencies?templateId=' + query.id">Dependencies</a></div>
        </div>
    </div>

    <div class="col-12 order-2 collapse" id="addPhasePanel">
        <div class="card border-0 shadow-sm"><div class="card-header bg-white d-flex justify-content-between align-items-center"><h2 class="h5 mb-0" dmx-text="'Add ' + scTerminology.data.query[0].stageSingular.lowercase()">Add phase</h2><button class="btn-close" type="button" data-bs-toggle="collapse" data-bs-target="#addPhasePanel" aria-label="Close add phase form"></button></div><div class="card-body">
            <form method="post" action="/api/workflow_templates/create_stage"><%- _csrfInput() %>
                <input type="hidden" name="templateId" dmx-bind:value="query.id">
                <div class="mb-3"><label class="form-label" dmx-text="scTerminology.data.query[0].stageSingular.default('Phase') + ' name'">Phase name</label><input class="form-control" name="stageName" required></div>
                <div class="mb-3"><label class="form-label">Description</label><textarea class="form-control" name="description" rows="3"></textarea></div>
                <div class="mb-3"><label class="form-label">Colour</label><input class="form-control form-control-color" name="colour" type="color" value="#0d6efd"></div>
                <div class="mb-4"><label class="form-label">Require all tasks complete</label><select class="form-select" name="requiresAllTasksComplete"><option value="0" selected>No</option><option value="1">Yes</option></select></div>
                <div class="mb-4"><label class="form-label">Approval required to move to the next phase?</label><select class="form-select" name="requiresProgressionApproval"><option value="0" selected>No — move forward when ready</option><option value="1">Yes — require authorised approval</option></select><div class="form-text">Turn this on for formal gates such as contract, finance or safety approval.</div></div>
                <div class="mb-4"><label class="form-label">Allow the next phase to start early?</label><select class="form-select" name="allowNextStageEarlyStart"><option value="0" selected>No — finish this phase first</option><option value="1">Yes — allow phases to overlap</option></select><div class="form-text">The current phase remains open while work begins in the next phase.</div></div>
                <div class="border rounded p-3 bg-light mb-4"><h3 class="h6 mb-1">Default task schedule</h3><p class="small text-muted mb-3">Tasks in this phase inherit this deadline unless individually overridden.</p><div class="row g-3"><div class="col-md-5"><label class="form-label">Calculate deadlines from</label><select class="form-select" name="defaultDueOffsetType"><option value="">No automatic deadline</option><option value="event_target_date" selected>Show date</option><option value="workflow_start_date">Planning start date</option><option value="workflow_creation_date">Event creation date</option></select></div><div class="col-md-3"><label class="form-label">Days</label><input class="form-control" name="defaultDueOffsetDays" type="number" min="0" value="0"></div><div class="col-md-4"><label class="form-label">Timing</label><select class="form-select" name="defaultDueRelation"><option value="before" selected>Before the date</option><option value="after">After the date</option></select></div></div></div>
                <button class="btn btn-primary" type="submit" dmx-text="'Add ' + scTerminology.data.query[0].stageSingular.default('Phase')">Add Phase</button>
            </form>
        </div></div>
    </div>

    <div class="col-12 order-1">
        <div class="d-flex justify-content-between align-items-center mb-3"><h2 class="h5 mb-0" dmx-text="'Ordered ' + scTerminology.data.query[0].stagePlural.lowercase()">Ordered stages</h2><span class="badge rounded-pill bg-primary" dmx-text="scStages.data.query.count() + ' ' + (scStages.data.query.count() == 1 ? scTerminology.data.query[0].stageSingular.lowercase() : scTerminology.data.query[0].stagePlural.lowercase())"></span></div>

        <div is="dmx-repeat" id="repStages" dmx-bind:repeat="scStages.data.query">
            <div class="card border-0 shadow-sm mb-3"><div class="card-body">
                <form method="post" action="/api/workflow_templates/update_stage"><%- _csrfInput() %>
                    <input type="hidden" name="id" dmx-bind:value="$value.id">
                    <input type="hidden" name="templateId" dmx-bind:value="$value.templateId">
                    <div class="row g-3 align-items-end">
                        <div class="col-md-2"><label class="form-label">Order</label><input class="form-control" name="sortOrder" type="number" min="1" dmx-bind:value="$value.sortOrder"></div>
                        <div class="col-md-5"><label class="form-label" dmx-text="scTerminology.data.query[0].stageSingular.default('Phase')">Phase</label><input class="form-control" name="stageName" required dmx-bind:value="$value.stageName"></div>
                        <div class="col-md-3"><label class="form-label">Status</label><select class="form-select" name="status" dmx-bind:value="$value.status"><option value="active">Active</option><option value="inactive">Inactive</option><option value="archived">Archived</option></select></div>
                        <div class="col-md-2"><label class="form-label">Colour</label><input class="form-control form-control-color" name="colour" type="color" dmx-bind:value="$value.colour"></div>
                        <div class="col-12"><label class="form-label">Description</label><textarea class="form-control" name="description" rows="2" dmx-bind:value="$value.description"></textarea></div>
                        <div class="col-md-5"><label class="form-label">Require all tasks complete</label><select class="form-select" name="requiresAllTasksComplete" dmx-bind:value="$value.requiresAllTasksComplete"><option value="0">No</option><option value="1">Yes</option></select></div>
                        <div class="col-md-7"><label class="form-label">Approval required to move on?</label><select class="form-select" name="requiresProgressionApproval" dmx-bind:value="$value.requiresProgressionApproval"><option value="0">No — move forward when ready</option><option value="1">Yes — require authorised approval</option></select></div>
                        <div class="col-md-7"><label class="form-label">Allow next phase to start early?</label><select class="form-select" name="allowNextStageEarlyStart" dmx-bind:value="$value.allowNextStageEarlyStart"><option value="0">No — finish this phase first</option><option value="1">Yes — allow phases to overlap</option></select></div>
                        <div class="col-12"><div class="border rounded p-3 bg-light"><h3 class="h6 mb-1">Default task schedule</h3><p class="small text-muted mb-3">Questions in this phase inherit this deadline unless they have their own override.</p><div class="row g-3"><div class="col-md-5"><label class="form-label">Calculate deadlines from</label><select class="form-select" name="defaultDueOffsetType" dmx-bind:value="$value.defaultDueOffsetType"><option value="">No automatic deadline</option><option value="event_target_date">Show date</option><option value="workflow_start_date">Planning start date</option><option value="workflow_creation_date">Event creation date</option></select></div><div class="col-md-3"><label class="form-label">Days</label><input class="form-control" name="defaultDueOffsetDays" type="number" min="0" dmx-bind:value="$value.defaultDueOffsetDays.default(0)"></div><div class="col-md-4"><label class="form-label">Timing</label><select class="form-select" name="defaultDueRelation" dmx-bind:value="$value.defaultDueRelation.default('before')"><option value="before">Before the date</option><option value="after">After the date</option></select></div></div></div></div>
                        <div class="col-md-7 text-md-end"><span class="text-muted small me-3" dmx-text="$value.taskCount + ($value.taskCount == 1 ? ' question' : ' questions')"></span><a class="btn btn-sm btn-primary me-2" dmx-bind:href="'/workflow_templates/template_tasks?templateId=' + $value.templateId + '&stageId=' + $value.id">Manage Questions</a><button class="btn btn-sm btn-outline-primary" type="submit">Save</button></div>
                    </div>
                </form>
            </div></div>
        </div>

        <div class="text-muted" dmx-show="!scStages.state.executing && scStages.data.query.count() == 0">No stages yet. Add the first stage to begin shaping the workflow.</div>
    </div>
</div>
<meta name="ac:route" content="/workflow_templates/template_stages">
