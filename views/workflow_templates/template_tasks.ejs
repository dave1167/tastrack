<!-- Wappler include head-page="layouts/main_shell" fontawesome_5="cdn" bootstrap5="local" is="dmx-app" id="task_question_designer" appConnect="local" components="{dmxStateManagement:{},dmxBrowser:{}}" -->
<dmx-browser id="browserTaskDesigner"></dmx-browser>
<dmx-serverconnect id="scTaskDesigner" url="/api/task_questions/overview" dmx-param:templateid="query.templateId" dmx-on:updated="query.questionId && scQuestionEditor.load()"></dmx-serverconnect>
<dmx-serverconnect id="scQuestionEditor" url="/api/task_questions/get" dmx-param:questionid="query.questionId" dmx-show="query.questionId"></dmx-serverconnect>
<dmx-serverconnect id="scTemplateTeams" url="/api/teams/list_teams"></dmx-serverconnect>
<dmx-serverconnect id="scTemplateTeamMembers" url="/api/tasks/team_member_options" dmx-param:teamid="templateDefaultTeam.value"></dmx-serverconnect>
<dmx-value id="selectedQuestionId"></dmx-value>
<div class="alert alert-warning" dmx-show="query.questionId && scQuestionEditor.lastError.status"><strong>Question not found.</strong> It may have been archived. <a class="alert-link" dmx-bind:href="'/workflow_templates/template_tasks?templateId=' + query.templateId + '&stageId=' + query.stageId">Return to questions</a>.</div>
<div class="d-flex justify-content-between align-items-start gap-3 mb-4"><div><h1 class="mb-1"><span dmx-text="scTerminology.data.query[0].taskSingular.default('Task')"></span> Template Designer</h1><p class="text-muted mb-0"><span dmx-text="scTaskDesigner.data.result.template.templateName"></span> · <span dmx-text="scTerminology.data.query[0].stageSingular.default('Phase')"></span> questions and actions</p></div><a class="btn btn-outline-secondary" dmx-bind:href="'/workflow_templates/template_stages?id=' + query.templateId">Back to phases</a></div>
<div class="alert alert-info">Each row becomes one real <span dmx-text="scTerminology.data.query[0].taskSingular.lowercase().default('task')"></span> when a record is created. Existing records keep their original snapshot if this template changes later.</div>

<div class="row g-4" dmx-hide="query.questionId">
  <div class="col-xl-5"><div class="card border-0 shadow-sm"><div class="card-header bg-white"><h2 class="h5 mb-0">Add <span dmx-text="scTerminology.data.query[0].taskSingular.default('Task')"></span> Question</h2></div><div class="card-body">
    <form id="frmAddTaskQuestion" is="dmx-serverconnect-form" method="post" action="/api/task_questions/save" dmx-on:success="reset();scTaskDesigner.load()"><%- _csrfInput() %><input type="hidden" name="templateId" dmx-bind:value="query.templateId"><div class="row g-3">
      <div class="col-8"><label class="form-label" dmx-text="scTerminology.data.query[0].stageSingular.default('Phase')">Phase</label><select class="form-select" name="templateStageId" dmx-bind:options="scTaskDesigner.data.result.phases" optiontext="stageName" optionvalue="id" dmx-bind:value="query.stageId" required><option value="">Select phase</option></select></div><div class="col-4"><label class="form-label">Order</label><input class="form-control" name="sortOrder" type="number" value="10" min="0" required></div>
      <div class="col-12"><label class="form-label">Question / action</label><input class="form-control" name="taskName" maxlength="180" placeholder="Has the contract been signed?" required></div>
      <div class="col-12"><label class="form-label" for="newTaskAnswerType">Answer type</label><select class="form-select" id="newTaskAnswerType" name="answerType" dmx-bind:options="scTaskDesigner.data.result.answerTypes" optiontext="label" optionvalue="value" required></select></div>
      <div class="col-12"><label class="form-label">Help / instruction text</label><textarea class="form-control" name="description" rows="3"></textarea></div>
      <div class="col-md-6"><label class="form-label">Required?</label><select class="form-select" name="isRequired"><option value="1">Yes</option><option value="0">No</option></select></div><div class="col-md-6"><label class="form-label" dmx-text="scTerminology.data.query[0].taskAttachmentLabel.default('Attachment')">Attachment</label><select class="form-select" name="attachmentRequirement"><option value="none">None</option><option value="optional">Optional</option><option value="required">Required</option></select></div>
      <div class="col-12"><div class="border rounded p-3 bg-light"><h3 class="h6 mb-1">Deadline</h3><p class="small text-muted mb-3">Normally inherit the phase schedule. Choose an override only when this task needs different timing.</p><div class="row g-3"><div class="col-md-5"><label class="form-label">Schedule</label><select class="form-select" name="dueOffsetType"><option value="" selected>Inherit phase default</option><option value="event_target_date">Override: show date</option><option value="workflow_start_date">Override: planning start date</option><option value="workflow_creation_date">Override: event creation date</option></select></div><div class="col-md-3"><label class="form-label">Days</label><input class="form-control" name="dueOffsetDays" type="number" min="0" value="0"></div><div class="col-md-4"><label class="form-label">Timing</label><select class="form-select" name="dueRelation"><option value="before" selected>Before the date</option><option value="after">After the date</option></select></div></div></div></div>
      <div class="col-6 form-check ms-2"><input class="form-check-input" type="checkbox" name="showStartDate" value="1" id="addShowStart"><label class="form-check-label" for="addShowStart">Show start date</label></div><div class="col-5 form-check"><input class="form-check-input" type="checkbox" name="showDeadline" value="1" id="addShowDue" checked><label class="form-check-label" for="addShowDue">Show deadline</label></div><div class="col-6 form-check ms-2"><input class="form-check-input" type="checkbox" name="showFinishDate" value="1" id="addShowFinish"><label class="form-check-label" for="addShowFinish">Show finish date</label></div><div class="col-5 form-check"><input class="form-check-input" type="checkbox" name="allowNotes" value="1" id="addNotes"><label class="form-check-label" for="addNotes">Allow notes</label></div>
      <div class="col-12"><div class="alert alert-danger" dmx-show="frmAddTaskQuestion.lastError.status" dmx-text="frmAddTaskQuestion.lastError.response.message.default('The question could not be added.')"></div><button class="btn btn-primary" type="submit" dmx-bind:disabled="frmAddTaskQuestion.state.executing"><span dmx-show="!frmAddTaskQuestion.state.executing">Add Question</span><span dmx-show="frmAddTaskQuestion.state.executing">Adding…</span></button></div>
    </div></form>
  </div></div></div>

  <div class="col-xl-7"><div is="dmx-repeat" id="designerPhases" dmx-bind:repeat="scTaskDesigner.data.result.phases"><section class="card border-0 shadow-sm mb-3"><div class="card-header bg-white d-flex justify-content-between"><div><span class="small text-muted" dmx-text="sortOrder"></span><h2 class="h5 mb-0" dmx-text="stageName"></h2><div class="small text-muted"><span dmx-show="defaultDueOffsetType" dmx-text="'Default: ' + defaultDueOffsetDays.default(0) + ' days ' + defaultDueRelation.default('before') + ' ' + (defaultDueOffsetType == 'event_target_date' ? 'show date' : (defaultDueOffsetType == 'workflow_start_date' ? 'planning start' : 'event creation'))"></span><span dmx-hide="defaultDueOffsetType">No automatic phase deadline</span></div></div><span class="badge bg-light text-dark" dmx-text="questions.count() + ' questions'"></span></div><div class="list-group list-group-flush"><div class="list-group-item" is="dmx-repeat" id="phaseQuestions" dmx-bind:repeat="questions"><div class="d-flex justify-content-between align-items-center gap-3"><div><strong><span dmx-text="sortOrder"></span> — <span dmx-text="taskName"></span></strong><div class="small text-muted" dmx-text="description"></div><div class="small text-primary"><span dmx-show="dueOffsetType" dmx-text="'Task override: ' + dueOffsetDays.default(0) + ' days ' + dueRelation.default('before')"></span><span dmx-hide="dueOffsetType">Inherits phase schedule</span></div></div><a class="btn btn-sm btn-outline-primary" dmx-bind:href="'/workflow_templates/template_tasks?templateId=' + templateId + '&stageId=' + templateStageId + '&questionId=' + id">Edit</a></div></div><div class="list-group-item text-muted" dmx-show="questions.count() == 0">No questions in this phase.</div></div></section></div></div>
</div>

<div class="card border-0 shadow-sm mt-4" id="questionEditor" dmx-show="query.questionId"><div class="card-header bg-white d-flex justify-content-between align-items-center"><h2 class="h5 mb-0">Edit Question</h2><a class="btn btn-sm btn-outline-secondary" dmx-bind:href="'/workflow_templates/template_tasks?templateId=' + query.templateId + '&stageId=' + query.stageId">Close</a></div><div class="card-body" is="dmx-repeat" id="selectedQuestion" dmx-bind:repeat="scQuestionEditor.data.result.questions">
  <form is="dmx-serverconnect-form" method="post" action="/api/task_questions/save" dmx-on:success="scTaskDesigner.load()"><%- _csrfInput() %><input type="hidden" name="id" dmx-bind:value="$value.id"><input type="hidden" name="templateId" dmx-bind:value="$value.templateId"><div class="row g-3"><div class="col-8"><label class="form-label">Phase</label><select class="form-select" name="templateStageId" dmx-bind:options="scTaskDesigner.data.result.phases" optiontext="stageName" optionvalue="id" dmx-bind:value="$value.templateStageId"></select></div><div class="col-4"><label class="form-label">Order</label><input class="form-control" name="sortOrder" type="number" dmx-bind:value="$value.sortOrder"></div><div class="col-12"><label class="form-label">Question / action</label><input class="form-control" name="taskName" dmx-bind:value="$value.taskName" required></div><div class="col-12"><label class="form-label">Help / instruction</label><textarea class="form-control" name="description" rows="3" dmx-bind:value="$value.description"></textarea></div><div class="col-12"><label class="form-label">Answer type</label><select class="form-select" name="answerType" dmx-bind:options="scTaskDesigner.data.result.answerTypes" optiontext="label" optionvalue="value" dmx-bind:value="$value.answerType"></select></div><div class="col-6"><label class="form-label">Required?</label><select class="form-select" name="isRequired" dmx-bind:value="$value.isRequired"><option value="1">Yes</option><option value="0">No</option></select></div><div class="col-6"><label class="form-label">Attachment</label><select class="form-select" name="attachmentRequirement" dmx-bind:value="$value.attachmentRequirement"><option value="none">None</option><option value="optional">Optional</option><option value="required">Required</option></select></div><div class="col-12"><div class="border rounded p-3 bg-light"><h3 class="h6 mb-1">Deadline</h3><p class="small text-muted mb-3">Leave this inherited unless this task needs different timing from its phase.</p><div class="row g-3"><div class="col-md-5"><label class="form-label">Schedule</label><select class="form-select" name="dueOffsetType" dmx-bind:value="$value.dueOffsetType"><option value="">Inherit phase default</option><option value="event_target_date">Override: show date</option><option value="workflow_start_date">Override: planning start date</option><option value="workflow_creation_date">Override: event creation date</option></select></div><div class="col-md-3"><label class="form-label">Days</label><input class="form-control" name="dueOffsetDays" type="number" min="0" dmx-bind:value="$value.dueOffsetDays.default(0)"></div><div class="col-md-4"><label class="form-label">Timing</label><select class="form-select" name="dueRelation" dmx-bind:value="$value.dueRelation.default('before')"><option value="before">Before the date</option><option value="after">After the date</option></select></div></div></div></div><div class="col-6 form-check ms-2"><input class="form-check-input" name="showStartDate" value="1" type="checkbox" dmx-bind:checked="$value.showStartDate"><label class="form-check-label">Show start date</label></div><div class="col-5 form-check"><input class="form-check-input" name="showDeadline" value="1" type="checkbox" dmx-bind:checked="$value.showDeadline"><label class="form-check-label">Show deadline</label></div><div class="col-6 form-check ms-2"><input class="form-check-input" name="showFinishDate" value="1" type="checkbox" dmx-bind:checked="$value.showFinishDate"><label class="form-check-label">Show finish date</label></div><div class="col-5 form-check"><input class="form-check-input" name="allowNotes" value="1" type="checkbox" dmx-bind:checked="$value.allowNotes"><label class="form-check-label">Allow notes</label></div><div class="col-12"><button class="btn btn-primary" type="submit">Save Question</button></div></div></form><form class="mt-3" is="dmx-serverconnect-form" method="post" action="/api/task_questions/archive" dmx-on:success="selectedQuestionId.setValue('');scTaskDesigner.load()"><%- _csrfInput() %><input type="hidden" name="id" dmx-bind:value="$value.id"><div class="alert alert-warning small">Removing this question archives it from the template. Existing workflows keep their original question snapshot.</div><button class="btn btn-outline-danger" type="submit" onclick="return confirm('Archive this question from the template?')">Archive Question</button></form>
  <div><hr><h3 class="h6">Answer Options</h3><p class="small text-muted">Used for radio, checkbox and dropdown answer types. Yes/No and text answers do not need options.</p><div class="list-group mb-3"><div class="list-group-item d-flex justify-content-between" is="dmx-repeat" dmx-bind:repeat="$value.options"><span><span dmx-text="$value.displayOrder"></span> — <span dmx-text="$value.optionLabel"></span></span><code dmx-text="$value.optionValue"></code></div></div><form is="dmx-serverconnect-form" method="post" action="/api/task_questions/saveOption" dmx-on:success="reset();scQuestionEditor.load()"><%- _csrfInput() %><input type="hidden" name="templateTaskId" dmx-bind:value="$value.id"><div class="row g-2"><div class="col-7"><input class="form-control" name="optionLabel" placeholder="Option label" required></div><div class="col-3"><input class="form-control" name="displayOrder" type="number" value="10"></div><div class="col-2"><button class="btn btn-outline-primary w-100" type="submit">Add</button></div></div></form></div>
  <div><hr><h3 class="h6">Default allocation</h3><p class="small text-muted">The team owns this task. A preferred person is optional; other members of the team may still complete it.</p><form is="dmx-serverconnect-form" method="post" action="/api/task_questions/saveAssignment" dmx-on:success="scQuestionEditor.load()"><%- _csrfInput() %><input type="hidden" name="id" dmx-bind:value="$value.id"><div class="row g-3"><div class="col-md-6"><label class="form-label" for="templateDefaultTeam">Default team</label><select class="form-select" id="templateDefaultTeam" name="defaultTeamId" dmx-bind:options="scTemplateTeams.data.query" optiontext="teamName" optionvalue="id" dmx-bind:value="$value.defaultTeamId" dmx-on:changed="templateDefaultUser.setValue('');scTemplateTeamMembers.load()"><option value="">Unallocated</option></select></div><div class="col-md-6"><label class="form-label" for="templateDefaultUser">Preferred team member <span class="text-muted">(optional)</span></label><select class="form-select" id="templateDefaultUser" name="defaultUserId" dmx-bind:options="scTemplateTeamMembers.data.query" optiontext="memberName" optionvalue="userId" dmx-bind:value="$value.defaultUserId" dmx-bind:disabled="!templateDefaultTeam.value"><option value="">Team only</option></select></div><div class="col-12"><button class="btn btn-outline-primary" type="submit">Save allocation</button></div></div></form></div>
</div></div>
<script>
document.addEventListener('DOMContentLoaded', function () {
  const editor = document.getElementById('questionEditor');
  if (!editor) return;
  const enhanceEditor = function () {
    const saveForm = editor.querySelector('form[action="/api/task_questions/save"]');
    if (saveForm) {
      const saveButton = saveForm.querySelector('button[type="submit"]');
      if (saveButton) {
        if (saveButton.textContent !== 'Save Changes') saveButton.textContent = 'Save Changes';
        saveButton.setAttribute('aria-label', 'Save Question');
      }
      const fields = Array.from(saveForm.querySelectorAll('.row.g-3 > .col-12'));
      const answerType = fields.find(field => field.querySelector('label')?.textContent.trim() === 'Answer type');
      const helpText = fields.find(field => field.querySelector('label')?.textContent.trim() === 'Help / instruction');
      if (answerType && helpText && answerType.nextElementSibling !== helpText) helpText.parentNode.insertBefore(answerType, helpText);
      const answerTypeSelect = saveForm.querySelector('select[name="answerType"]');
      const optionsHeading = Array.from(editor.querySelectorAll('h3')).find(heading => heading.textContent.trim() === 'Answer Options');
      const optionsPanel = optionsHeading?.parentElement;
      const updateOptionsVisibility = () => {
        if (optionsPanel && answerTypeSelect) optionsPanel.hidden = !['radio', 'checkbox_multi', 'dropdown_single', 'dropdown_multi'].includes(answerTypeSelect.value);
      };
      updateOptionsVisibility();
      if (answerTypeSelect && !answerTypeSelect.dataset.optionsVisibility) {
        answerTypeSelect.dataset.optionsVisibility = '1';
        answerTypeSelect.addEventListener('change', updateOptionsVisibility);
      }
    }
    const deleteForm = editor.querySelector('form[action="/api/task_questions/archive"]');
    const deleteButton = deleteForm?.querySelector('button[type="submit"]');
    if (deleteButton) {
      if (deleteButton.textContent !== 'Delete Question') deleteButton.textContent = 'Delete Question';
      deleteButton.setAttribute('aria-label', 'Archive Question');
    }
    if (deleteForm && !deleteForm.dataset.returnAfterDelete) {
      deleteForm.dataset.returnAfterDelete = '1';
      deleteForm.addEventListener('success', function () {
        const params = new URLSearchParams(window.location.search);
        browserTaskDesigner.goto('/workflow_templates/template_tasks?templateId=' + encodeURIComponent(params.get('templateId') || '') + '&stageId=' + encodeURIComponent(params.get('stageId') || ''));
      });
    }
    const optionForm = editor.querySelector('form[action="/api/task_questions/saveOption"]');
    if (optionForm && !optionForm.dataset.clearAfterAdd) {
      optionForm.dataset.clearAfterAdd = '1';
      optionForm.addEventListener('success', function () {
        const label = optionForm.querySelector('input[name="optionLabel"]');
        const order = optionForm.querySelector('input[name="displayOrder"]');
        if (label) label.value = '';
        if (order) order.value = '10';
        let confirmation = optionForm.querySelector('.js-option-added');
        if (!confirmation) {
          confirmation = document.createElement('div');
          confirmation.className = 'small text-success mt-2 js-option-added';
          optionForm.appendChild(confirmation);
        }
        confirmation.textContent = 'Answer option added.';
        window.setTimeout(() => { confirmation.textContent = ''; }, 2500);
        if (label) label.focus();
      });
    }
  };
  enhanceEditor();
  new MutationObserver(enhanceEditor).observe(editor, { childList: true, subtree: true });
});
</script>
<meta name="ac:route" content="/workflow_templates/template_tasks">
