<% const source=formSource||'scRecordForm.data.result', values=valueSource||`${source}.values`, location=formLocation||''; %>
<div class="configurable-form"><div is="dmx-repeat" id="dynamicFormSections" dmx-bind:repeat="<%= source %>.sections"><section class="mb-4" dmx-show="!'<%= location %>' || displayLocation == '<%= location %>'"><h3 class="h5 mb-1" dmx-text="sectionName"></h3><p class="small text-muted" dmx-show="sectionDescription" dmx-text="sectionDescription"></p><div class="row g-3" is="dmx-repeat" id="dynamicFormFields" dmx-bind:repeat="fields"><div dmx-bind:class="'col-12 col-md-' + columnWidth" dmx-bind:data-config-field="id" dmx-bind:data-field-key="fieldKey" dmx-bind:data-required="isRequired" dmx-bind:data-conditions="conditions.toJSON()"><label class="form-label" dmx-show="fieldType != 'checkbox'"><span dmx-text="fieldLabel"></span><span class="text-danger" dmx-show="isRequired"> *</span></label>
<input class="form-control" dmx-show="fieldType == 'single_line_text' || fieldType == 'email' || fieldType == 'telephone' || fieldType == 'url'" dmx-bind:type="fieldType == 'email' ? 'email' : fieldType == 'url' ? 'url' : fieldType == 'telephone' ? 'tel' : 'text'" dmx-bind:name="'field_' + id" dmx-bind:placeholder="placeholderText" dmx-bind:value="<%= values %>[fieldKey]" dmx-bind:readonly="isReadOnly">
<textarea class="form-control" rows="4" dmx-show="fieldType == 'long_text'" dmx-bind:name="'field_' + id" dmx-bind:placeholder="placeholderText" dmx-bind:value="<%= values %>[fieldKey]"></textarea>
<input class="form-control" dmx-show="fieldType == 'number' || fieldType == 'currency' || fieldType == 'percentage'" type="number" dmx-bind:step="fieldType == 'number' ? '1' : '0.01'" dmx-bind:min="fieldType == 'percentage' ? 0 : validation.min" dmx-bind:max="fieldType == 'percentage' ? 100 : validation.max" dmx-bind:name="'field_' + id" dmx-bind:value="<%= values %>[fieldKey]">
<input class="form-control" dmx-show="fieldType == 'date' || fieldType == 'datetime' || fieldType == 'time'" dmx-bind:type="fieldType == 'datetime' ? 'datetime-local' : fieldType" dmx-bind:name="'field_' + id" dmx-bind:value="<%= values %>[fieldKey]">
<select class="form-select" dmx-show="fieldType == 'dropdown'" dmx-bind:name="'field_' + id" dmx-bind:options="options" optiontext="optionLabel" optionvalue="optionValue" dmx-bind:value="<%= values %>[fieldKey]"><option value="">Select...</option></select><select class="form-select" dmx-show="fieldType == 'yes_no'" dmx-bind:name="'field_' + id" dmx-bind:value="<%= values %>[fieldKey]"><option value="">Select...</option><option value="1">Yes</option><option value="0">No</option></select>
<div dmx-show="fieldType == 'radio'" is="dmx-repeat" id="dynamicRadios" dmx-bind:repeat="options"><div class="form-check"><input class="form-check-input" type="radio" dmx-bind:name="'field_' + parent.id" dmx-bind:value="optionValue"><label class="form-check-label" dmx-text="optionLabel"></label></div></div>
<div class="form-check" dmx-show="fieldType == 'checkbox'"><input class="form-check-input" type="checkbox" value="1" dmx-bind:name="'field_' + id" dmx-bind:checked="<%= values %>[fieldKey]"><label class="form-check-label" dmx-text="fieldLabel"></label></div>
<select class="form-select" multiple dmx-show="fieldType == 'multi_select'" dmx-bind:name="'field_' + id" dmx-bind:options="options" optiontext="optionLabel" optionvalue="optionValue" dmx-bind:value="<%= values %>[fieldKey]"></select>
<div class="repeatable-table" dmx-show="fieldType == 'repeatable_table'" dmx-bind:data-columns="repeatableColumns.toJSON()" dmx-bind:data-value="<%= values %>[fieldKey].toJSON()"><input type="hidden" dmx-bind:name="'field_' + id"><div class="table-responsive"></div><button class="btn btn-sm btn-outline-primary mt-2 repeatable-add" type="button"><i class="fas fa-plus me-1"></i>Add Row</button></div>
<div class="form-text" dmx-show="helpText" dmx-text="helpText"></div></div></div></section></div></div>
