<dmx-value id="commercialItemKind" value="price"></dmx-value>
<dmx-value id="commercialSelectedDefinitionId"></dmx-value>

<div class="col-12" id="eventCommercialTermsSection" role="tabpanel" aria-labelledby="eventCommercialTab" dmx-show="query.section == 'commercial' && scTenantModules.data.commercialAccess[0].hasAccess == 1">
  <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
    <div><h2 class="h4 mb-1" dmx-text="scCommercialTerms.data.commercial.terminology['commercial.section_name'].default('Commercial Terms')">Commercial Terms</h2><p class="small text-muted mb-0">Structured agreement terms only. This does not create invoices or process payments.</p></div>
    <button class="btn btn-primary" type="button" data-bs-toggle="modal" data-bs-target="#editCommercialTermsModal" dmx-show="scCommercialTerms.data.commercial.canEdit"><i class="fas fa-pen me-2"></i>Edit</button>
  </div>

  <div class="card border-0 shadow-sm mb-4" dmx-show="scCommercialTerms.data.commercial.sections.where('sectionKey','agreement').count()">
    <div class="card-header bg-white"><h3 class="h5 mb-0" dmx-text="scCommercialTerms.data.commercial.sections.where('sectionKey','agreement')[0].heading.default('Agreement')">Agreement</h3></div>
    <div class="card-body"><div class="row g-3">
      <div class="col-md-4"><div class="small text-muted">Arrangement</div><div class="fw-semibold" dmx-text="scCommercialTerms.data.commercial.record.agreementTypeLabel.default('Not recorded')"></div></div>
      <div class="col-md-4" dmx-show="scCommercialTerms.data.commercial.record.fixedAmount != null"><div class="small text-muted">Fixed amount</div><div class="fw-semibold"><span dmx-text="scCommercialTerms.data.commercial.record.currencyCode"></span> <span dmx-text="scCommercialTerms.data.commercial.record.fixedAmount.formatNumber(2,'.',',')"></span></div></div>
      <div class="col-md-4" dmx-show="scCommercialTerms.data.commercial.record.guaranteeAmount != null"><div class="small text-muted">Guarantee</div><div class="fw-semibold"><span dmx-text="scCommercialTerms.data.commercial.record.currencyCode"></span> <span dmx-text="scCommercialTerms.data.commercial.record.guaranteeAmount.formatNumber(2,'.',',')"></span></div></div>
      <div class="col-md-4" dmx-show="scCommercialTerms.data.commercial.record.minimumAmount != null"><div class="small text-muted">Minimum amount</div><div class="fw-semibold"><span dmx-text="scCommercialTerms.data.commercial.record.currencyCode"></span> <span dmx-text="scCommercialTerms.data.commercial.record.minimumAmount.formatNumber(2,'.',',')"></span></div></div>
      <div class="col-md-4" dmx-show="scCommercialTerms.data.commercial.record.organisationPercentage != null"><div class="small text-muted">Organisation / counterparty split</div><div class="fw-semibold"><span dmx-text="scCommercialTerms.data.commercial.record.organisationPercentage"></span>% / <span dmx-text="scCommercialTerms.data.commercial.record.counterpartyPercentage"></span>%</div></div>
      <div class="col-md-4"><div class="small text-muted">Contract</div><div class="fw-semibold text-capitalize" dmx-text="scCommercialTerms.data.commercial.contract.status.default('No linked contract')"></div><a class="small" dmx-show="scCommercialTerms.data.commercial.contract.id" dmx-bind:href="'/contracts/generated?id=' + scCommercialTerms.data.commercial.contract.id">View contract</a></div>
      <div class="col-12" dmx-show="scCommercialTerms.data.commercial.record.settlementBasis"><div class="small text-muted">Settlement basis</div><div dmx-text="scCommercialTerms.data.commercial.record.settlementBasis"></div></div>
    </div></div>
  </div>

  <div class="card border-0 shadow-sm mb-4" dmx-show="scCommercialTerms.data.commercial.sections.where('sectionKey','prices').count()">
    <div class="card-header bg-white d-flex justify-content-between align-items-center"><h3 class="h5 mb-0" dmx-text="scCommercialTerms.data.commercial.sections.where('sectionKey','prices')[0].heading.default(scCommercialTerms.data.commercial.terminology['commercial.price_items'].default('Price Items'))">Price Items</h3><button class="btn btn-sm btn-outline-primary" type="button" data-bs-toggle="modal" data-bs-target="#addCommercialItemModal" dmx-on:click="commercialItemKind.setValue('price')" dmx-show="scCommercialTerms.data.commercial.canEdit"><i class="fas fa-plus me-1"></i>Add</button></div>
    <div class="table-responsive" dmx-show="scCommercialTerms.data.commercial.children.price.count()"><table class="table table-sm align-middle mb-0"><thead><tr><th>Description</th><th>Quantity</th><th>VAT</th><th class="text-end">Amount</th><th></th></tr></thead><tbody is="dmx-repeat" dmx-bind:repeat="scCommercialTerms.data.commercial.children.price"><tr><td><strong dmx-text="description"></strong><div class="small text-muted" dmx-text="notes"></div></td><td dmx-text="quantity"></td><td dmx-text="vatTreatment"></td><td class="text-end text-nowrap"><span dmx-text="scCommercialTerms.data.commercial.record.currencyCode"></span> <span dmx-text="amount.formatNumber(2,'.',',')"></span></td><td class="text-end"><form is="dmx-serverconnect-form" method="post" action="/api/commercial/removeItem" dmx-on:success="scCommercialTerms.load()" dmx-show="scCommercialTerms.data.commercial.canEdit"><%- _csrfInput() %><input type="hidden" name="workflowId" dmx-bind:value="query.id"><input type="hidden" name="kind" value="price"><input type="hidden" name="id" dmx-bind:value="id"><button class="btn btn-sm btn-outline-danger" type="submit" title="Remove"><i class="fas fa-times"></i></button></form></td></tr></tbody></table></div><div class="card-body text-muted" dmx-show="scCommercialTerms.data.commercial.children.price.count() == 0">No price items recorded.</div>
  </div>

  <div class="card border-0 shadow-sm mb-4" dmx-show="scCommercialTerms.data.commercial.sections.where('sectionKey','responsibilities').count()">
    <div class="card-header bg-white d-flex justify-content-between align-items-center"><h3 class="h5 mb-0" dmx-text="scCommercialTerms.data.commercial.sections.where('sectionKey','responsibilities')[0].heading.default(scCommercialTerms.data.commercial.terminology['commercial.responsibilities'].default('Costs & Responsibilities'))">Costs &amp; Responsibilities</h3><button class="btn btn-sm btn-outline-primary" type="button" data-bs-toggle="modal" data-bs-target="#addCommercialItemModal" dmx-on:click="commercialItemKind.setValue('responsibility');commercialSelectedDefinitionId.setValue('')" dmx-show="scCommercialTerms.data.commercial.canEdit"><i class="fas fa-plus me-1"></i>Add</button></div>
    <div class="table-responsive" dmx-show="scCommercialTerms.data.commercial.children.responsibility.count()"><table class="table table-sm align-middle mb-0"><thead><tr><th>Item</th><th>Responsibility</th><th>Basis</th><th class="text-end">Value</th><th></th></tr></thead><tbody is="dmx-repeat" dmx-bind:repeat="scCommercialTerms.data.commercial.children.responsibility"><tr><td><strong dmx-text="definitionLabel.default(description)"></strong><div class="small text-muted" dmx-text="notes"></div></td><td dmx-text="responsibilityLabel"></td><td dmx-text="basis"></td><td class="text-end text-nowrap"><span dmx-show="amount != null"><span dmx-text="scCommercialTerms.data.commercial.record.currencyCode"></span> <span dmx-text="amount.formatNumber(2,'.',',')"></span></span><span dmx-show="percentage != null"><span dmx-text="percentage"></span>%</span></td><td class="text-end"><form is="dmx-serverconnect-form" method="post" action="/api/commercial/removeItem" dmx-on:success="scCommercialTerms.load()" dmx-show="scCommercialTerms.data.commercial.canEdit"><%- _csrfInput() %><input type="hidden" name="workflowId" dmx-bind:value="query.id"><input type="hidden" name="kind" value="responsibility"><input type="hidden" name="id" dmx-bind:value="id"><button class="btn btn-sm btn-outline-danger" type="submit" title="Remove"><i class="fas fa-times"></i></button></form></td></tr></tbody></table></div><div class="card-body text-muted" dmx-show="scCommercialTerms.data.commercial.children.responsibility.count() == 0">No responsibility items recorded.</div>
  </div>

  <div class="card border-0 shadow-sm mb-4" dmx-show="scCommercialTerms.data.commercial.sections.where('sectionKey','adjustments').count()">
    <div class="card-header bg-white d-flex justify-content-between align-items-center"><h3 class="h5 mb-0" dmx-text="scCommercialTerms.data.commercial.sections.where('sectionKey','adjustments')[0].heading.default('Adjustments / Deductions')">Adjustments / Deductions</h3><button class="btn btn-sm btn-outline-primary" type="button" data-bs-toggle="modal" data-bs-target="#addCommercialItemModal" dmx-on:click="commercialItemKind.setValue('adjustment')" dmx-show="scCommercialTerms.data.commercial.canEdit"><i class="fas fa-plus me-1"></i>Add</button></div>
    <div class="table-responsive" dmx-show="scCommercialTerms.data.commercial.children.adjustment.count()"><table class="table table-sm align-middle mb-0"><thead><tr><th>Description</th><th>Basis</th><th class="text-end">Value</th><th></th></tr></thead><tbody is="dmx-repeat" dmx-bind:repeat="scCommercialTerms.data.commercial.children.adjustment"><tr><td dmx-text="description"></td><td class="text-capitalize" dmx-text="calculationType.replace('_',' ')"></td><td class="text-end"><span dmx-show="amount != null"><span dmx-text="scCommercialTerms.data.commercial.record.currencyCode"></span> <span dmx-text="amount.formatNumber(2,'.',',')"></span></span><span dmx-show="percentage != null"><span dmx-text="percentage"></span>%</span><span dmx-show="unitAmount != null"><span dmx-text="scCommercialTerms.data.commercial.record.currencyCode"></span> <span dmx-text="unitAmount.formatNumber(2,'.',',')"></span> per unit</span></td><td class="text-end"><form is="dmx-serverconnect-form" method="post" action="/api/commercial/removeItem" dmx-on:success="scCommercialTerms.load()" dmx-show="scCommercialTerms.data.commercial.canEdit"><%- _csrfInput() %><input type="hidden" name="workflowId" dmx-bind:value="query.id"><input type="hidden" name="kind" value="adjustment"><input type="hidden" name="id" dmx-bind:value="id"><button class="btn btn-sm btn-outline-danger" type="submit"><i class="fas fa-times"></i></button></form></td></tr></tbody></table></div><div class="card-body text-muted" dmx-show="scCommercialTerms.data.commercial.children.adjustment.count() == 0">No adjustments recorded.</div>
  </div>

  <div class="card border-0 shadow-sm mb-4" dmx-show="scCommercialTerms.data.commercial.sections.where('sectionKey','payment_terms').count()">
    <div class="card-header bg-white"><h3 class="h5 mb-0" dmx-text="scCommercialTerms.data.commercial.sections.where('sectionKey','payment_terms')[0].heading.default('Payment / Settlement Terms')">Payment / Settlement Terms</h3></div><div class="card-body"><div class="row g-3"><div class="col-md-4" dmx-show="scCommercialTerms.data.commercial.record.depositAmount != null"><div class="small text-muted">Deposit</div><div class="fw-semibold"><span dmx-text="scCommercialTerms.data.commercial.record.currencyCode"></span> <span dmx-text="scCommercialTerms.data.commercial.record.depositAmount.formatNumber(2,'.',',')"></span></div></div><div class="col-md-4" dmx-show="scCommercialTerms.data.commercial.record.depositDueDate"><div class="small text-muted">Deposit due</div><div dmx-text="scCommercialTerms.data.commercial.record.depositDueDate.formatDate('dd MMM yyyy')"></div></div><div class="col-md-4" dmx-show="scCommercialTerms.data.commercial.record.balanceDueDate"><div class="small text-muted">Balance due</div><div dmx-text="scCommercialTerms.data.commercial.record.balanceDueDate.formatDate('dd MMM yyyy')"></div></div><div class="col-md-6" dmx-show="scCommercialTerms.data.commercial.record.paymentTerms"><div class="small text-muted">Payment terms</div><div dmx-text="scCommercialTerms.data.commercial.record.paymentTerms"></div></div><div class="col-md-6" dmx-show="scCommercialTerms.data.commercial.record.settlementPeriod"><div class="small text-muted">Settlement period</div><div dmx-text="scCommercialTerms.data.commercial.record.settlementPeriod"></div></div><div class="col-12 text-muted" dmx-show="!scCommercialTerms.data.commercial.record.depositAmount && !scCommercialTerms.data.commercial.record.paymentTerms && !scCommercialTerms.data.commercial.record.settlementPeriod">No payment or settlement terms recorded.</div></div></div>
  </div>

  <div class="card border-0 shadow-sm mb-4" dmx-show="scCommercialTerms.data.commercial.sections.where('sectionKey','payment_schedule').count()">
    <div class="card-header bg-white d-flex justify-content-between align-items-center"><h3 class="h5 mb-0" dmx-text="scCommercialTerms.data.commercial.sections.where('sectionKey','payment_schedule')[0].heading.default('Payment Schedule')">Payment Schedule</h3><button class="btn btn-sm btn-outline-primary" type="button" data-bs-toggle="modal" data-bs-target="#addCommercialItemModal" dmx-on:click="commercialItemKind.setValue('schedule')" dmx-show="scCommercialTerms.data.commercial.canEdit"><i class="fas fa-plus me-1"></i>Add milestone</button></div>
    <div class="table-responsive" dmx-show="scCommercialTerms.data.commercial.children.schedule.count()"><table class="table table-sm align-middle mb-0"><thead><tr><th>Milestone</th><th>Due / trigger</th><th>Status</th><th class="text-end">Amount</th><th></th></tr></thead><tbody is="dmx-repeat" dmx-bind:repeat="scCommercialTerms.data.commercial.children.schedule"><tr><td dmx-text="description"></td><td><span dmx-text="dueDate ? dueDate.formatDate('dd MMM yyyy') : triggerText"></span></td><td class="text-capitalize" dmx-text="status"></td><td class="text-end"><span dmx-show="amount != null"><span dmx-text="scCommercialTerms.data.commercial.record.currencyCode"></span> <span dmx-text="amount.formatNumber(2,'.',',')"></span></span><span dmx-show="percentage != null"><span dmx-text="percentage"></span>%</span></td><td><form is="dmx-serverconnect-form" method="post" action="/api/commercial/removeItem" dmx-on:success="scCommercialTerms.load()" dmx-show="scCommercialTerms.data.commercial.canEdit"><%- _csrfInput() %><input type="hidden" name="workflowId" dmx-bind:value="query.id"><input type="hidden" name="kind" value="schedule"><input type="hidden" name="id" dmx-bind:value="id"><button class="btn btn-sm btn-outline-danger" type="submit"><i class="fas fa-times"></i></button></form></td></tr></tbody></table></div><div class="card-body text-muted" dmx-show="scCommercialTerms.data.commercial.children.schedule.count() == 0">No payment milestones recorded.</div>
  </div>

  <div class="card border-0 shadow-sm" dmx-show="scCommercialTerms.data.commercial.sections.where('sectionKey','additional').count() && scCommercialTerms.data.commercial.record.notes"><div class="card-header bg-white"><h3 class="h5 mb-0" dmx-text="scCommercialTerms.data.commercial.sections.where('sectionKey','additional')[0].heading.default('Additional Terms')">Additional Terms</h3></div><div class="card-body" style="white-space:pre-wrap" dmx-text="scCommercialTerms.data.commercial.record.notes"></div></div>
</div>

<div class="modal fade" id="editCommercialTermsModal" is="dmx-bs5-modal" tabindex="-1"><div class="modal-dialog modal-lg modal-dialog-scrollable"><div class="modal-content"><form is="dmx-serverconnect-form" method="post" action="/api/commercial/saveAgreement" dmx-on:success="editCommercialTermsModal.hide();scCommercialTerms.load()"><%- _csrfInput() %><input type="hidden" name="workflowId" dmx-bind:value="query.id"><div class="modal-header"><h2 class="modal-title h5">Edit agreement terms</h2><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body"><div class="row g-3">
  <div class="col-md-6"><label class="form-label">Agreement type</label><select id="commercialAgreementType" class="form-select" name="agreementTypeId" dmx-bind:options="scCommercialTerms.data.commercial.options.where('optionGroup','agreement_type')" optiontext="label" optionvalue="id" dmx-bind:value="scCommercialTerms.data.commercial.record.agreementTypeId"><option value="">Select</option></select></div><div class="col-md-3"><label class="form-label">Currency</label><input class="form-control text-uppercase" name="currencyCode" maxlength="3" dmx-bind:value="scCommercialTerms.data.commercial.record.currencyCode"></div>
  <div class="col-md-3" dmx-show="commercialAgreementType.value && scCommercialTerms.data.commercial.options.where('id',commercialAgreementType.value)[0].fieldRulesJson.parseJSON().fixedAmount"><label class="form-label">Fixed amount</label><input class="form-control" type="number" min="0" step="0.01" name="fixedAmount" dmx-bind:value="scCommercialTerms.data.commercial.record.fixedAmount"></div>
  <div class="col-md-3" dmx-show="commercialAgreementType.value && scCommercialTerms.data.commercial.options.where('id',commercialAgreementType.value)[0].fieldRulesJson.parseJSON().guaranteeAmount"><label class="form-label">Guarantee</label><input class="form-control" type="number" min="0" step="0.01" name="guaranteeAmount" dmx-bind:value="scCommercialTerms.data.commercial.record.guaranteeAmount"></div>
  <div class="col-md-3" dmx-show="commercialAgreementType.value && scCommercialTerms.data.commercial.options.where('id',commercialAgreementType.value)[0].fieldRulesJson.parseJSON().minimumAmount"><label class="form-label">Minimum amount</label><input class="form-control" type="number" min="0" step="0.01" name="minimumAmount" dmx-bind:value="scCommercialTerms.data.commercial.record.minimumAmount"></div>
  <div class="col-md-3" dmx-show="commercialAgreementType.value && scCommercialTerms.data.commercial.options.where('id',commercialAgreementType.value)[0].fieldRulesJson.parseJSON().organisationPercentage"><label class="form-label">Organisation %</label><input class="form-control" type="number" min="0" max="100" step="0.01" name="organisationPercentage" dmx-bind:value="scCommercialTerms.data.commercial.record.organisationPercentage"></div><div class="col-md-3" dmx-show="commercialAgreementType.value && scCommercialTerms.data.commercial.options.where('id',commercialAgreementType.value)[0].fieldRulesJson.parseJSON().counterpartyPercentage"><label class="form-label">Counterparty %</label><input class="form-control" type="number" min="0" max="100" step="0.01" name="counterpartyPercentage" dmx-bind:value="scCommercialTerms.data.commercial.record.counterpartyPercentage"></div>
  <div class="col-12" dmx-show="commercialAgreementType.value && scCommercialTerms.data.commercial.options.where('id',commercialAgreementType.value)[0].fieldRulesJson.parseJSON().settlementBasis"><label class="form-label">Settlement basis</label><input class="form-control" name="settlementBasis" maxlength="500" dmx-bind:value="scCommercialTerms.data.commercial.record.settlementBasis"></div><div class="col-md-6" dmx-show="commercialAgreementType.value && scCommercialTerms.data.commercial.options.where('id',commercialAgreementType.value)[0].fieldRulesJson.parseJSON().vatTreatment"><label class="form-label">VAT treatment</label><input class="form-control" name="vatTreatment" dmx-bind:value="scCommercialTerms.data.commercial.record.vatTreatment"></div>
  <div class="col-12"><hr><h3 class="h6">Payment / settlement terms</h3></div><div class="col-md-3"><label class="form-label">Deposit amount</label><input class="form-control" type="number" min="0" step="0.01" name="depositAmount" dmx-bind:value="scCommercialTerms.data.commercial.record.depositAmount"></div><div class="col-md-3"><label class="form-label">Deposit %</label><input class="form-control" type="number" min="0" max="100" step="0.01" name="depositPercentage" dmx-bind:value="scCommercialTerms.data.commercial.record.depositPercentage"></div><div class="col-md-3"><label class="form-label">Deposit due</label><input class="form-control" type="date" name="depositDueDate" dmx-bind:value="scCommercialTerms.data.commercial.record.depositDueDate.formatDate('yyyy-MM-dd')"></div><div class="col-md-3"><label class="form-label">Balance due</label><input class="form-control" type="date" name="balanceDueDate" dmx-bind:value="scCommercialTerms.data.commercial.record.balanceDueDate.formatDate('yyyy-MM-dd')"></div><div class="col-md-6"><label class="form-label">Payment terms</label><input class="form-control" name="paymentTerms" dmx-bind:value="scCommercialTerms.data.commercial.record.paymentTerms"></div><div class="col-md-6"><label class="form-label">Settlement period</label><input class="form-control" name="settlementPeriod" dmx-bind:value="scCommercialTerms.data.commercial.record.settlementPeriod"></div><div class="col-12"><label class="form-label">Cancellation terms</label><textarea class="form-control" name="cancellationTerms" rows="2" dmx-bind:value="scCommercialTerms.data.commercial.record.cancellationTerms"></textarea></div><div class="col-12"><label class="form-label">Additional terms</label><textarea class="form-control" name="notes" rows="3" dmx-bind:value="scCommercialTerms.data.commercial.record.notes"></textarea></div>
</div></div><div class="modal-footer"><button class="btn btn-light" type="button" data-bs-dismiss="modal">Cancel</button><button class="btn btn-primary" type="submit">Save terms</button></div></form></div></div></div>

<div class="modal fade" id="addCommercialItemModal" is="dmx-bs5-modal" tabindex="-1"><div class="modal-dialog"><div class="modal-content"><form is="dmx-serverconnect-form" method="post" action="/api/commercial/saveItem" dmx-on:success="addCommercialItemModal.hide();reset();commercialSelectedDefinitionId.setValue('');scCommercialTerms.load()"><%- _csrfInput() %><input type="hidden" name="workflowId" dmx-bind:value="query.id"><input type="hidden" name="kind" dmx-bind:value="commercialItemKind.value"><div class="modal-header"><h2 class="modal-title h5">Add item</h2><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body"><div class="row g-3">
  <div class="col-12" dmx-show="commercialItemKind.value == 'responsibility'"><label class="form-label">Configured item</label><select id="commercialDefinitionSelect" class="form-select" name="definitionId" dmx-bind:options="scCommercialTerms.data.commercial.definitions.where('sectionKey','responsibilities')" optiontext="label" optionvalue="id" dmx-on:changed="commercialSelectedDefinitionId.setValue(value)"><option value="">Select</option></select></div><div class="col-12" dmx-show="commercialItemKind.value == 'responsibility'"><label class="form-label">Responsibility</label><select class="form-select" name="responsibilityOptionId" dmx-bind:options="scCommercialTerms.data.commercial.options.where('optionGroup','responsibility')" optiontext="label" optionvalue="id"><option value="">Select</option></select></div>
  <div class="col-12" dmx-show="commercialItemKind.value != 'responsibility'"><label class="form-label">Description / milestone</label><input class="form-control" name="description"></div><div class="col-12" dmx-show="commercialItemKind.value == 'adjustment'"><label class="form-label">Calculation type</label><select id="commercialCalculationType" class="form-select" name="calculationType"><option value="fixed">Fixed amount</option><option value="percentage">Percentage</option><option value="per_unit">Per unit</option><option value="included">Included</option><option value="manual">Manual / other</option></select></div>
  <div class="col-6" dmx-show="commercialItemKind.value == 'price' || commercialItemKind.value == 'schedule' || (commercialItemKind.value == 'responsibility' && commercialSelectedDefinitionId.value && scCommercialTerms.data.commercial.definitions.where('id',commercialSelectedDefinitionId.value)[0].allowAmount) || (commercialItemKind.value == 'adjustment' && commercialCalculationType.value == 'fixed')"><label class="form-label">Amount</label><input class="form-control" type="number" min="0" step="0.01" name="amount"></div><div class="col-6" dmx-show="commercialItemKind.value == 'adjustment' && commercialCalculationType.value == 'per_unit'"><label class="form-label">Per-unit amount</label><input class="form-control" type="number" min="0" step="0.01" name="unitAmount"></div><div class="col-6" dmx-show="commercialItemKind.value == 'schedule' || (commercialItemKind.value == 'responsibility' && commercialSelectedDefinitionId.value && scCommercialTerms.data.commercial.definitions.where('id',commercialSelectedDefinitionId.value)[0].allowPercentage) || (commercialItemKind.value == 'adjustment' && commercialCalculationType.value == 'percentage')"><label class="form-label">Percentage</label><input class="form-control" type="number" min="0" max="100" step="0.01" name="percentage"></div><div class="col-6" dmx-show="commercialItemKind.value == 'price' || (commercialItemKind.value == 'responsibility' && commercialSelectedDefinitionId.value && scCommercialTerms.data.commercial.definitions.where('id',commercialSelectedDefinitionId.value)[0].allowQuantity)"><label class="form-label">Quantity</label><input class="form-control" type="number" min="0" step="0.001" name="quantity"></div>
  <div class="col-6" dmx-show="commercialItemKind.value == 'schedule'"><label class="form-label">Due date</label><input class="form-control" type="date" name="dueDate"></div><div class="col-6" dmx-show="commercialItemKind.value == 'schedule'"><label class="form-label">Status</label><select class="form-select" name="status"><option value="planned">Planned</option><option value="due">Due</option><option value="satisfied">Satisfied</option><option value="cancelled">Cancelled</option></select></div><div class="col-12" dmx-show="commercialItemKind.value == 'schedule'"><label class="form-label">Trigger / milestone</label><input class="form-control" name="triggerText"></div><div class="col-12" dmx-show="commercialItemKind.value == 'responsibility'"><label class="form-label">Basis / treatment</label><input class="form-control" name="basis"></div><div class="col-12"><label class="form-label">Notes</label><textarea class="form-control" name="notes" rows="2"></textarea></div>
</div></div><div class="modal-footer"><button class="btn btn-light" type="button" data-bs-dismiss="modal">Cancel</button><button class="btn btn-primary" type="submit">Add item</button></div></form></div></div></div>
