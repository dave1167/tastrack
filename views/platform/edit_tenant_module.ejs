<!-- Wappler include head-page="layouts/platform_shell" fontawesome_5="cdn" bootstrap5="local" is="dmx-app" id="platform_edit_tenant_module" appConnect="local" -->
<dmx-serverconnect id="scTenantModule" url="/api/platform/tenantModules/get" dmx-param:tenantid="query.tenantId" dmx-param:moduleid="query.moduleId"></dmx-serverconnect>
<div class="row g-4">
    <div class="col-12"><div class="d-flex justify-content-between align-items-center"><div><h1 class="mb-1">Edit Tenant Module</h1><p class="text-muted mb-0"><span dmx-text="scTenantModule.data.entitlement[0].tenantName"></span> · <span dmx-text="scTenantModule.data.entitlement[0].moduleName"></span></p></div><a class="btn btn-outline-secondary" dmx-bind:href="'/platform/tenant-modules?tenantId=' + query.tenantId">Back to tenant modules</a></div></div>
    <div class="col-12 col-xl-9"><div class="card border-0 shadow-sm" dmx-show="scTenantModule.data.entitlement.count() > 0"><div class="card-body p-4">
        <form method="post" action="/api/platform/tenantModules/update">
            <%- _csrfInput() %><input type="hidden" name="tenantId" dmx-bind:value="query.tenantId"><input type="hidden" name="moduleId" dmx-bind:value="query.moduleId">
            <div class="row g-3">
                <div class="col-md-4"><label class="form-label">Status</label><select class="form-select" name="status" dmx-bind:value="scTenantModule.data.entitlement[0].status" dmx-bind:disabled="scTenantModule.data.entitlement[0].isCore == 1"><option value="ACTIVE">Active</option><option value="TRIAL">Trial</option><option value="DISABLED">Disabled</option><option value="SUSPENDED">Suspended</option><option value="EXPIRED">Expired</option></select><input type="hidden" name="status" value="ACTIVE" dmx-show="scTenantModule.data.entitlement[0].isCore == 1" dmx-bind:disabled="scTenantModule.data.entitlement[0].isCore != 1"></div>
                <div class="col-md-4"><label class="form-label">Billing interval</label><select class="form-select" name="billingInterval" dmx-bind:value="scTenantModule.data.entitlement[0].billingInterval"><option value="INCLUDED">Included / free</option><option value="MONTHLY">Monthly</option><option value="ANNUAL">Annual</option><option value="MANUAL">Manual</option></select></div>
                <div class="col-md-4"><label class="form-label">Currency</label><input class="form-control text-uppercase" name="currencyCode" maxlength="3" dmx-bind:value="scTenantModule.data.entitlement[0].currencyCode"></div>
                <div class="col-md-6"><label class="form-label">Tenant monthly price</label><input class="form-control" name="monthlyPrice" type="number" min="0" step="0.01" dmx-bind:value="scTenantModule.data.entitlement[0].monthlyPrice != null ? scTenantModule.data.entitlement[0].monthlyPrice : scTenantModule.data.entitlement[0].defaultMonthlyPrice"><div class="form-text">Catalogue: <span dmx-text="scTenantModule.data.entitlement[0].defaultMonthlyPrice || 'Not set'"></span></div></div>
                <div class="col-md-6"><label class="form-label">Tenant annual price</label><input class="form-control" name="annualPrice" type="number" min="0" step="0.01" dmx-bind:value="scTenantModule.data.entitlement[0].annualPrice != null ? scTenantModule.data.entitlement[0].annualPrice : scTenantModule.data.entitlement[0].defaultAnnualPrice"><div class="form-text">Catalogue: <span dmx-text="scTenantModule.data.entitlement[0].defaultAnnualPrice || 'Not set'"></span></div></div>
                <div class="col-md-4"><label class="form-label">Access starts</label><input class="form-control" name="accessStartDate" type="datetime-local" dmx-bind:value="scTenantModule.data.entitlement[0].accessStartDate ? scTenantModule.data.entitlement[0].accessStartDate.formatDate('yyyy-MM-dd HH:mm').replace(' ','T') : ''"></div>
                <div class="col-md-4"><label class="form-label">Access ends</label><input class="form-control" name="accessEndDate" type="datetime-local" dmx-bind:value="scTenantModule.data.entitlement[0].accessEndDate ? scTenantModule.data.entitlement[0].accessEndDate.formatDate('yyyy-MM-dd HH:mm').replace(' ','T') : ''"></div>
                <div class="col-md-4"><label class="form-label">Trial ends</label><input class="form-control" name="trialEndsDate" type="datetime-local" dmx-bind:value="scTenantModule.data.entitlement[0].trialEndsDate ? scTenantModule.data.entitlement[0].trialEndsDate.formatDate('yyyy-MM-dd HH:mm').replace(' ','T') : ''"></div>
                <div class="col-md-4"><label class="form-label">Auto renew</label><select class="form-select" name="autoRenew" dmx-bind:value="scTenantModule.data.entitlement[0].autoRenew"><option value="0">No</option><option value="1">Yes</option></select></div>
                <div class="col-md-8"><label class="form-label">Billing reference</label><input class="form-control" name="billingReference" dmx-bind:value="scTenantModule.data.entitlement[0].billingReference"></div>
                <div class="col-12"><label class="form-label">Commercial notes</label><textarea class="form-control" name="notes" rows="3" dmx-bind:value="scTenantModule.data.entitlement[0].notes"></textarea></div>
                <div class="col-12"><label class="form-label">Reason for change</label><input class="form-control" name="changeNote" required></div>
            </div>
            <div class="d-flex justify-content-end gap-2 mt-4"><a class="btn btn-light" dmx-bind:href="'/platform/tenant-modules?tenantId=' + query.tenantId">Cancel</a><button class="btn btn-primary" type="submit">Save tenant module</button></div>
        </form>
    </div></div></div>
</div>
<meta name="ac:route" content="/platform/tenant-modules/edit">
