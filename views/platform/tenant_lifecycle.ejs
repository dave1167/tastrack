<!-- Wappler include head-page="layouts/platform_shell" fontawesome_5="cdn" bootstrap5="local" is="dmx-app" id="platform_tenant_lifecycle" appConnect="local" -->
<dmx-serverconnect id="scTenantLifecycle" url="/api/platform/tenantLifecycle/list"></dmx-serverconnect>
<div class="row g-4">
  <div class="col-12"><h1 class="mb-1">Tenant lifecycle</h1><p class="text-muted mb-0">Manage tenant classification, access dates and the H1 test scenario.</p></div>
  <div class="col-12"><div class="alert alert-success" dmx-show="query.saved == 1">Tenant lifecycle saved.</div></div>
  <div class="col-12"><div class="card border-0 shadow-sm"><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Tenant</th><th>Type</th><th>Status</th><th>Expiry</th><th>Scenario</th><th>Progress</th><th></th></tr></thead><tbody is="dmx-repeat" dmx-bind:repeat="scTenantLifecycle.data.tenants"><tr><td dmx-text="$value.tenantName"></td><td dmx-text="$value.tenantType"></td><td dmx-text="$value.lifecycleStatus"></td><td dmx-text="$value.accessEndDate ? $value.accessEndDate.formatDate('dd MMM yyyy HH:mm') : 'No expiry'"></td><td dmx-text="$value.scenarioName || 'None'"></td><td dmx-text="$value.scenarioStatus ? $value.scenarioStatus + ($value.currentStep ? ' / step ' + $value.currentStep : '') : '—'"></td><td><button class="btn btn-sm btn-outline-primary" type="button" dmx-on:click="selectedTenant.setValue($value);lifecycleModal.show()">Manage</button></td></tr></tbody></table></div></div></div>
</div>
<dmx-value id="selectedTenant"></dmx-value>
<div class="modal fade" id="lifecycleModal" is="dmx-bs5-modal" tabindex="-1"><div class="modal-dialog"><form class="modal-content" method="post" action="/api/platform/tenantLifecycle/update"><%- _csrfInput() %><div class="modal-header"><h2 class="modal-title h5">Manage tenant lifecycle</h2><button class="btn-close" type="button" data-bs-dismiss="modal"></button></div><div class="modal-body"><input type="hidden" name="tenantId" dmx-bind:value="selectedTenant.value.tenantId"><div class="mb-3"><label class="form-label">Tenant type</label><select class="form-select" name="tenantType" dmx-bind:value="selectedTenant.value.tenantType" required><option value="live">Live</option><option value="demo">Demo</option><option value="trial">Trial</option></select></div><div class="mb-3"><label class="form-label">Lifecycle status</label><select class="form-select" name="lifecycleStatus" dmx-bind:value="selectedTenant.value.lifecycleStatus" required><option value="active">Active</option><option value="expired">Expired</option><option value="read_only">Read only</option><option value="suspended">Suspended</option><option value="closed">Closed</option></select></div><div class="row g-3"><div class="col-6"><label class="form-label">Access starts</label><input class="form-control" type="datetime-local" name="accessStartDate" dmx-bind:value="selectedTenant.value.accessStartDate.formatDate('yyyy-MM-dd HH:mm')"></div><div class="col-6"><label class="form-label">Access expires</label><input class="form-control" type="datetime-local" name="accessEndDate" dmx-bind:value="selectedTenant.value.accessEndDate.formatDate('yyyy-MM-dd HH:mm')"></div><div class="col-6"><label class="form-label">Retention ends</label><input class="form-control" type="datetime-local" name="retentionEndDate" dmx-bind:value="selectedTenant.value.retentionEndDate.formatDate('yyyy-MM-dd HH:mm')"></div><div class="col-6"><label class="form-label">Cleanup eligible</label><input class="form-control" type="datetime-local" name="cleanupEligibleDate" dmx-bind:value="selectedTenant.value.cleanupEligibleDate.formatDate('yyyy-MM-dd HH:mm')"></div></div><div class="mt-3"><label class="form-label">Scenario pack</label><select class="form-select" name="scenarioPackId" dmx-bind:options="scTenantLifecycle.data.scenarioPacks" optiontext="scenarioName" optionvalue="id" dmx-bind:value="selectedTenant.value.scenarioPackId"><option value="0">No new scenario</option></select><div class="form-text">A scenario instance is created only for a demo tenant.</div></div><div class="mt-3"><label class="form-label">Reason</label><textarea class="form-control" name="reason" maxlength="500" required></textarea></div></div><div class="modal-footer"><button class="btn btn-secondary" type="button" data-bs-dismiss="modal">Cancel</button><button class="btn btn-primary" type="submit">Save lifecycle</button></div></form></div></div>
<meta name="ac:route" content="/platform/tenant-lifecycle">
