<!-- Wappler include head-page="layouts/platform_shell" fontawesome_5="cdn" bootstrap5="local" is="dmx-app" id="platform_modules" appConnect="local" -->
<dmx-serverconnect id="scModuleCatalogue" url="/api/platform/modules/catalogue"></dmx-serverconnect>

<div class="row g-4">
    <div class="col-12">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
            <div><h1 class="mb-1">Module Catalogue</h1><p class="text-muted mb-0">Modules available across the Meldren platform.</p></div>
            <div class="d-flex gap-2"><a class="btn btn-outline-primary" href="/platform/tenant-modules">Tenant Modules</a><a class="btn btn-primary" href="/platform/modules/add"><i class="fas fa-plus me-2"></i>Add module</a></div>
        </div>
        <div class="alert alert-success mt-3 mb-0" dmx-show="query.saved == 1">Module saved.</div>
    </div>
    <div class="col-12">
        <div class="card border-0 shadow-sm">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light"><tr><th>Module</th><th>Category</th><th>Type</th><th>Monthly</th><th>Annual</th><th>Status</th><th class="text-end">Actions</th></tr></thead>
                        <tbody is="dmx-repeat" dmx-bind:repeat="scModuleCatalogue.data.modules">
                            <tr>
                                <td><div class="fw-semibold" dmx-text="$value.moduleName"></div><code dmx-text="$value.moduleCode"></code><div class="small text-muted mt-1" dmx-text="$value.moduleDescription"></div></td>
                                <td dmx-text="$value.moduleCategory || '—'"></td>
                                <td><span class="badge" dmx-class:bg-primary="$value.isCore == 1" dmx-class:bg-secondary="$value.isCore != 1" dmx-text="$value.isCore == 1 ? 'Core' : ($value.isBillable == 1 ? 'Paid' : 'Included')"></span></td>
                                <td dmx-text="$value.defaultMonthlyPrice != null ? $value.currencyCode + ' ' + $value.defaultMonthlyPrice : '—'"></td>
                                <td dmx-text="$value.defaultAnnualPrice != null ? $value.currencyCode + ' ' + $value.defaultAnnualPrice : '—'"></td>
                                <td><span class="badge bg-success" dmx-show="$value.isActive == 1">Active</span><span class="badge bg-secondary" dmx-show="$value.isActive != 1">Retired</span></td>
                                <td class="text-end"><a class="btn btn-sm btn-outline-primary" dmx-bind:href="'/platform/modules/edit?id=' + $value.id"><i class="fas fa-pen me-1"></i>Edit</a></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <div class="text-center text-muted py-5" dmx-show="!scModuleCatalogue.state.executing && scModuleCatalogue.data.modules.count() == 0">No modules have been created.</div>
            </div>
        </div>
    </div>
</div>
<meta name="ac:route" content="/platform/modules">
