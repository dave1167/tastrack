<!-- Wappler include head-page="layouts/main_shell" fontawesome_5="cdn" bootstrap5="local" is="dmx-app" id="organisation_settings" appConnect="local" -->
<div class="row g-4">
    <div class="col-12"><div class="card border-0 shadow-sm"><div class="card-header bg-white"><h2 class="h5 mb-0">Contract Management</h2></div><div class="card-body"><p class="text-muted">Manage tenant-specific approved wording and assemble reusable contract templates.</p><div class="d-flex flex-wrap gap-2"><a class="btn btn-outline-primary" href="/contract-clauses"><i class="fas fa-paragraph me-2"></i>Clause Library</a><a class="btn btn-outline-primary" href="/contract-templates"><i class="fas fa-file-contract me-2"></i>Contract Templates</a></div></div></div></div>
    <div class="col-12"><div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3"><div><h1 class="mb-1">Terminology</h1><p class="text-muted mb-0">Use the language your organisation uses every day.</p></div><div class="d-flex align-items-center gap-2"><span class="badge rounded-pill bg-success px-3 py-2" dmx-show="query.saved == 1 || query.commercial_saved == 1"><i class="fas fa-check me-2"></i>Terminology saved</span><a class="btn btn-outline-secondary" href="/configuration">Back to Configuration</a></div></div></div>
    <div class="col-12 col-xl-8"><div class="card border-0 shadow-sm"><div class="card-header bg-white py-3"><h2 class="h5 mb-1">Terminology</h2><p class="text-muted small mb-0">These labels are used in navigation, headings and forms for this organisation.</p></div><div class="card-body p-4">
        <form method="post" action="/api/settings/update_terminology"><%- _csrfInput() %><input type="hidden" name="tenantId" dmx-bind:value="scWelcome.data.TENANT_ID">
            <div class="row g-3 align-items-end mb-3"><div class="col-md-4"><div class="fw-semibold">Workflow</div><div class="small text-muted">For example Event, Show or Project</div></div><div class="col-md-4"><label class="form-label" for="workflowSingular">Singular</label><input class="form-control" id="workflowSingular" name="workflowSingular" maxlength="100" required dmx-bind:value="scTerminology.data.query[0].workflowSingular"></div><div class="col-md-4"><label class="form-label" for="workflowPlural">Plural</label><input class="form-control" id="workflowPlural" name="workflowPlural" maxlength="100" required dmx-bind:value="scTerminology.data.query[0].workflowPlural"></div></div><hr>
            <div class="row g-3 align-items-end my-3"><div class="col-md-4"><div class="fw-semibold">Performance type</div><div class="small text-muted">For example Performance Type, Event Type or Project Type</div></div><div class="col-md-4"><label class="form-label" for="performanceTypeSingular">Singular</label><input class="form-control" id="performanceTypeSingular" name="performanceTypeSingular" maxlength="100" required dmx-bind:value="scTerminology.data.query[0].performanceTypeSingular"></div><div class="col-md-4"><label class="form-label" for="performanceTypePlural">Plural</label><input class="form-control" id="performanceTypePlural" name="performanceTypePlural" maxlength="100" required dmx-bind:value="scTerminology.data.query[0].performanceTypePlural"></div></div><hr>
            <div class="row g-3 align-items-end my-3"><div class="col-md-4"><div class="fw-semibold">Stage</div><div class="small text-muted">The sections within a workflow</div></div><div class="col-md-4"><label class="form-label" for="stageSingular">Singular</label><input class="form-control" id="stageSingular" name="stageSingular" maxlength="100" required dmx-bind:value="scTerminology.data.query[0].stageSingular"></div><div class="col-md-4"><label class="form-label" for="stagePlural">Plural</label><input class="form-control" id="stagePlural" name="stagePlural" maxlength="100" required dmx-bind:value="scTerminology.data.query[0].stagePlural"></div></div><hr>
            <div class="row g-3 align-items-end my-3"><div class="col-md-4"><div class="fw-semibold">Task</div><div class="small text-muted">The individual pieces of work</div></div><div class="col-md-4"><label class="form-label" for="taskSingular">Singular</label><input class="form-control" id="taskSingular" name="taskSingular" maxlength="100" required dmx-bind:value="scTerminology.data.query[0].taskSingular"></div><div class="col-md-4"><label class="form-label" for="taskPlural">Plural</label><input class="form-control" id="taskPlural" name="taskPlural" maxlength="100" required dmx-bind:value="scTerminology.data.query[0].taskPlural"></div></div><hr>
            <div class="row g-3 align-items-end my-3"><div class="col-md-4"><div class="fw-semibold">Location</div><div class="small text-muted">For example Venue, Site or Building</div></div><div class="col-md-4"><label class="form-label" for="locationSingular">Singular</label><input class="form-control" id="locationSingular" name="locationSingular" maxlength="100" required dmx-bind:value="scTerminology.data.query[0].locationSingular"></div><div class="col-md-4"><label class="form-label" for="locationPlural">Plural</label><input class="form-control" id="locationPlural" name="locationPlural" maxlength="100" required dmx-bind:value="scTerminology.data.query[0].locationPlural"></div></div><hr>
            <div class="row g-3 align-items-end my-3"><div class="col-md-4"><div class="fw-semibold">Space</div><div class="small text-muted">For example Room, Auditorium or Hall</div></div><div class="col-md-4"><label class="form-label" for="spaceSingular">Singular</label><input class="form-control" id="spaceSingular" name="spaceSingular" maxlength="100" required dmx-bind:value="scTerminology.data.query[0].spaceSingular"></div><div class="col-md-4"><label class="form-label" for="spacePlural">Plural</label><input class="form-control" id="spacePlural" name="spacePlural" maxlength="100" required dmx-bind:value="scTerminology.data.query[0].spacePlural"></div></div><hr>
            <div class="row g-3 align-items-end mt-3"><div class="col-md-4"><div class="fw-semibold">Configuration</div><div class="small text-muted">For example Layout, Setup or Seating plan</div></div><div class="col-md-4"><label class="form-label" for="configurationSingular">Singular</label><input class="form-control" id="configurationSingular" name="configurationSingular" maxlength="100" required dmx-bind:value="scTerminology.data.query[0].configurationSingular"></div><div class="col-md-4"><label class="form-label" for="configurationPlural">Plural</label><input class="form-control" id="configurationPlural" name="configurationPlural" maxlength="100" required dmx-bind:value="scTerminology.data.query[0].configurationPlural"></div></div>
            <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top"><a class="btn btn-light" href="/configuration">Cancel</a><button class="btn btn-primary" type="submit"><i class="fas fa-save me-2"></i>Save terminology</button></div>
        </form>
    </div></div></div>
    <div class="col-12 col-xl-4"><div class="card border-0 shadow-sm bg-light"><div class="card-body p-4"><h2 class="h6">Example</h2><p class="text-muted small mb-3">For an events organisation you might use:</p><div class="d-flex flex-wrap gap-2"><span class="badge bg-white text-dark border">Event / Events</span><span class="badge bg-white text-dark border">Stage / Stages</span><span class="badge bg-white text-dark border">Task / Tasks</span></div></div></div></div>
    <div class="col-12" dmx-show="scTenantModules.data.commercialAccess[0].hasAccess == 1"><div class="card border-0 shadow-sm"><div class="card-header bg-white py-3"><h2 class="h5 mb-1">Commercial terminology</h2><p class="text-muted small mb-0">Choose language that fits your sector. For example, theatres can use ticket terminology while funders can use award terminology.</p></div><div class="card-body p-4"><form method="post" action="/api/settings/saveCommercialTerminology"><%- _csrfInput() %><div class="row g-3">
        <div class="col-md-6"><label class="form-label" for="commercialSingular">Section name</label><input class="form-control" id="commercialSingular" name="commercialSingular" maxlength="100" required dmx-bind:value="scTerminology.data.query[0].commercialSingular"><div class="form-text">For example Commercial Details, Pricing or Funding</div></div>
        <div class="col-md-6"><label class="form-label" for="commercialPlural">Section plural</label><input class="form-control" id="commercialPlural" name="commercialPlural" maxlength="100" required dmx-bind:value="scTerminology.data.query[0].commercialPlural"></div>
        <div class="col-md-6"><label class="form-label" for="commercialDateLabel">Availability date label</label><input class="form-control" id="commercialDateLabel" name="commercialDateLabel" maxlength="100" required dmx-bind:value="scTerminology.data.query[0].commercialDateLabel"><div class="form-text">For example On-sale Date, Applications Open or Available From</div></div>
        <div class="col-md-6"><label class="form-label" for="commercialCapacityLabel">Capacity label</label><input class="form-control" id="commercialCapacityLabel" name="commercialCapacityLabel" maxlength="100" required dmx-bind:value="scTerminology.data.query[0].commercialCapacityLabel"><div class="form-text">For example Ticket Capacity, Places Available or Units</div></div>
        <div class="col-md-6"><label class="form-label" for="commercialTargetLabel">Target label</label><input class="form-control" id="commercialTargetLabel" name="commercialTargetLabel" maxlength="100" required dmx-bind:value="scTerminology.data.query[0].commercialTargetLabel"><div class="form-text">For example Box Office Target, Funding Target or Contract Value</div></div>
        <div class="col-md-3"><label class="form-label" for="commercialPriceSingular">Price/value singular</label><input class="form-control" id="commercialPriceSingular" name="commercialPriceSingular" maxlength="100" required dmx-bind:value="scTerminology.data.query[0].commercialPriceSingular"></div>
        <div class="col-md-3"><label class="form-label" for="commercialPricePlural">Price/value plural</label><input class="form-control" id="commercialPricePlural" name="commercialPricePlural" maxlength="100" required dmx-bind:value="scTerminology.data.query[0].commercialPricePlural"></div>
        <div class="col-md-6"><label class="form-label" for="commercialEligibilityLabel">Eligibility label</label><input class="form-control" id="commercialEligibilityLabel" name="commercialEligibilityLabel" maxlength="100" required dmx-bind:value="scTerminology.data.query[0].commercialEligibilityLabel"><div class="form-text">For example Discount Eligibility or Applicant Eligibility</div></div>
        <div class="col-md-6"><label class="form-label" for="commercialTaxLabel">Tax/charging notes label</label><input class="form-control" id="commercialTaxLabel" name="commercialTaxLabel" maxlength="100" required dmx-bind:value="scTerminology.data.query[0].commercialTaxLabel"></div>
        <div class="col-12"><button class="btn btn-primary" type="submit"><i class="fas fa-save me-2"></i>Save commercial terminology</button></div>
    </div></form></div></div></div>
</div>
<meta name="ac:route" content="/settings">
