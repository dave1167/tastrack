<!-- Wappler include head-page="layouts/main_shell" fontawesome_5="cdn" bootstrap5="local" is="dmx-app" id="forms_designer" appConnect="local" components="{dmxStateManagement:{},dmxBrowser:{}}" -->
<dmx-browser id="browserFormsDesigner"></dmx-browser>
<dmx-serverconnect id="scForm" url="/api/forms/get" dmx-param:id="query.id"></dmx-serverconnect>
<dmx-value id="selectedFieldId"></dmx-value>

<div class="d-flex justify-content-between align-items-start gap-3 mb-4">
  <div><h1 class="mb-1" dmx-text="scForm.data.result.form.formName">Form Designer</h1><p class="text-muted mb-0"><span class="text-capitalize" dmx-text="scForm.data.result.form.formType"></span> form, version <span dmx-text="scForm.data.result.form.version"></span> · <span class="text-capitalize" dmx-text="scForm.data.result.form.status"></span></p></div>
  <div class="d-flex gap-2"><a class="btn btn-outline-secondary" href="/forms">Back</a>
    <form id="frmCreateFormVersion" is="dmx-serverconnect-form" method="post" action="/api/forms/newVersion" dmx-on:success="browserFormsDesigner.goto('/forms/designer?id=' + frmCreateFormVersion.data.result.id)"><%- _csrfInput() %><input type="hidden" name="id" dmx-bind:value="query.id"><button type="submit" class="btn btn-outline-primary" dmx-show="scForm.data.result.form.status == 'published'" dmx-bind:disabled="frmCreateFormVersion.state.executing"><span dmx-show="!frmCreateFormVersion.state.executing">Create New Version</span><span dmx-show="frmCreateFormVersion.state.executing">Creating…</span></button></form>
    <form is="dmx-serverconnect-form" method="post" action="/api/forms/publish" dmx-on:success="scForm.load()"><%- _csrfInput() %><input type="hidden" name="id" dmx-bind:value="query.id"><button class="btn btn-success" dmx-show="scForm.data.result.form.status == 'draft'">Publish</button></form>
  </div>
</div>
<div class="alert alert-info" dmx-show="scForm.data.result.form.status != 'draft'">Published forms are read-only. Create a new version to change their structure without altering existing responses.</div>
<div class="alert alert-danger" dmx-show="frmCreateFormVersion.data.message" dmx-text="frmCreateFormVersion.data.message"></div>
<div class="alert alert-primary" dmx-show="scForm.data.result.form.formType == 'task' && scForm.data.result.form.status == 'draft'"><strong>Build your Task Form:</strong> add a question under “Task Questions,” choose how the user should answer it, then publish the form when it is ready. Dropdown and radio answers can be configured after selecting the question.</div>

<div class="row g-4">
  <aside class="col-xl-3">
    <div class="card border-0 shadow-sm"><div class="card-header bg-white"><h2 class="h6 mb-0" dmx-text="scForm.data.result.form.formType == 'task' ? 'Optional Question Group' : 'Add Section'">Add Section</h2></div><div class="card-body">
      <form id="frmAddRecordSection" is="dmx-serverconnect-form" method="post" action="/api/forms/saveSection" dmx-on:success="scForm.load();reset()"><%- _csrfInput() %><input type="hidden" name="formTemplateId" dmx-bind:value="query.id"><label class="form-label" for="newSectionName">Section name</label><input id="newSectionName" class="form-control mb-2" name="sectionName" placeholder="e.g. Event details" maxlength="160" required><label class="form-label" for="newSectionKey">Stable key <span class="text-muted">(optional)</span></label><input id="newSectionKey" class="form-control mb-2" name="sectionKey" placeholder="Generated from the section name"><label class="form-label" for="newSectionLocation">Display location</label><select id="newSectionLocation" class="form-select mb-2" name="displayLocation"><option value="details">Details</option><option value="commercial">Commercial</option><option value="assessment">Assessment</option></select><label class="form-label" for="newSectionOrder">Display order</label><input id="newSectionOrder" class="form-control mb-2" name="displayOrder" type="number" value="100"><div class="form-check mb-2"><input class="form-check-input" type="checkbox" name="isCollapsible" value="1" id="newSectionCollapsible"><label class="form-check-label" for="newSectionCollapsible">Collapsible</label></div><div class="alert alert-danger py-2" dmx-show="frmAddRecordSection.lastError.status" dmx-text="frmAddRecordSection.lastError.response.message.default('The section could not be added.')"></div><button type="submit" class="btn btn-primary w-100" dmx-bind:disabled="scForm.data.result.form.status != 'draft' || frmAddRecordSection.state.executing"><span dmx-show="!frmAddRecordSection.state.executing">Add Section</span><span dmx-show="frmAddRecordSection.state.executing">Adding…</span></button></form>
    </div></div>
    <div class="card border-0 shadow-sm mt-3"><div class="card-header bg-white"><h2 class="h6 mb-0">What is a group?</h2></div><div class="card-body small text-muted"><span dmx-show="scForm.data.result.form.formType == 'task'">A group is just a heading for related questions. Most Task Forms only need the default “Task Questions” group.</span><span dmx-show="scForm.data.result.form.formType != 'task'">Sections group related fields and control where they appear on a record.</span></div></div>
  </aside>

  <main class="col-xl-6">
    <div class="card border-0 shadow-sm"><div class="card-header bg-white"><h2 class="h5 mb-0" dmx-text="scForm.data.result.form.formType == 'task' ? 'Questions in this Task Form' : 'Fields in this Record Form'">Form Fields</h2></div><div class="card-body">
      <div is="dmx-repeat" id="designerSections" dmx-bind:repeat="scForm.data.result.sections">
        <section class="border rounded p-3 mb-3">
          <div class="d-flex justify-content-between align-items-center mb-2" dmx-show="scForm.data.result.form.formType == 'task'"><div><h3 class="h6 mb-0" dmx-text="sectionName">Task Questions</h3><div class="small text-muted" dmx-text="sectionDescription"></div></div><span class="badge bg-light text-dark">Question group</span></div><form class="row g-2 align-items-end mb-3" is="dmx-serverconnect-form" method="post" action="/api/forms/saveSection" dmx-on:success="scForm.load()" dmx-show="scForm.data.result.form.formType != 'task'"><%- _csrfInput() %><input type="hidden" name="id" dmx-bind:value="$value.id"><input type="hidden" name="formTemplateId" dmx-bind:value="$value.formTemplateId"><input type="hidden" name="sectionKey" dmx-bind:value="$value.sectionKey"><div class="col-6"><label class="form-label small">Section name</label><input class="form-control form-control-sm" name="sectionName" dmx-bind:value="$value.sectionName"></div><div class="col-3"><label class="form-label small">Location</label><input class="form-control form-control-sm" name="displayLocation" dmx-bind:value="$value.displayLocation"></div><div class="col-2"><label class="form-label small">Order</label><input class="form-control form-control-sm" name="displayOrder" type="number" dmx-bind:value="$value.displayOrder"></div><div class="col-1"><button type="submit" class="btn btn-sm btn-outline-secondary" title="Save section"><i class="fas fa-save"></i></button></div></form>
          <div class="row g-2" is="dmx-repeat" id="designerFields" dmx-bind:repeat="fields"><div dmx-bind:class="'col-md-' + columnWidth"><button class="btn btn-light border text-start w-100" type="button" dmx-class:border-primary="selectedFieldId.value == id" dmx-on:click="selectedFieldId.setValue(id)"><strong dmx-text="fieldLabel"></strong><div class="small text-muted"><span dmx-text="fieldType.replace('_',' ')"></span> · order <span dmx-text="displayOrder"></span></div></button></div></div>
          <form class="row g-2 mt-3 border-top pt-3" is="dmx-serverconnect-form" method="post" action="/api/forms/saveField" dmx-on:success="reset();scForm.load()"><%- _csrfInput() %><input type="hidden" name="formTemplateId" dmx-bind:value="query.id"><input type="hidden" name="formSectionId" dmx-bind:value="$value.id"><div class="col-md-5"><label class="form-label small fw-semibold">Question</label><input class="form-control" name="fieldLabel" placeholder="e.g. Was the safety check completed?" required></div><div class="col-md-4"><label class="form-label small fw-semibold">Answer type</label><select class="form-select" name="fieldType"><option value="single_line_text">Short text</option><option value="long_text">Long text / notes</option><option value="yes_no">Yes or No</option><option value="checkbox">Single checkbox</option><option value="dropdown">Dropdown list</option><option value="radio">Radio buttons</option><option value="multi_select">Choose several options</option><option value="number">Number</option><option value="currency">Currency</option><option value="percentage">Percentage</option><option value="date">Date</option><option value="datetime">Date and time</option><option value="time">Time</option><option value="email">Email address</option><option value="telephone">Telephone</option><option value="url">Web address</option><option value="user_lookup">Choose a user</option><option value="team_lookup">Choose a team</option><option value="contact_lookup">Choose a contact</option><option value="organisation_lookup">Choose an organisation</option><option value="location_lookup">Choose a location</option><option value="document">Upload document</option><option value="repeatable_table">Table with multiple rows</option></select></div><div class="col-md-3 d-flex align-items-end"><button type="submit" class="btn btn-primary w-100" dmx-bind:disabled="scForm.data.result.form.status != 'draft'">Add Question</button></div></form>
        </section>
      </div>
    </div></div>
    <div class="card border-0 shadow-sm mt-4"><div class="card-header bg-white"><h2 class="h5 mb-0">Live Preview</h2></div><div class="card-body"><%- await include('../partials/configurable_form', {formSource:'scForm.data.result', valueSource:'{}', formLocation:''}); %></div></div>
  </main>

  <aside class="col-xl-3">
    <div class="card border-0 shadow-sm"><div class="card-header bg-white"><h2 class="h6 mb-0">Selected Field</h2></div>
      <div class="card-body" is="dmx-repeat" id="selectedField" dmx-bind:repeat="scForm.data.result.fields.where('id', selectedFieldId.value)">
        <form is="dmx-serverconnect-form" method="post" action="/api/forms/saveField" dmx-on:success="scForm.load()"><%- _csrfInput() %><input type="hidden" name="id" dmx-bind:value="$value.id"><input type="hidden" name="formTemplateId" dmx-bind:value="$value.formTemplateId"><input type="hidden" name="fieldType" dmx-bind:value="$value.fieldType"><label class="form-label small">Group</label><select class="form-select form-select-sm mb-2" name="formSectionId" dmx-bind:options="scForm.data.result.sections" optiontext="sectionName" optionvalue="id" dmx-bind:value="$value.formSectionId"></select><label class="form-label small">Question</label><input class="form-control form-control-sm mb-2" name="fieldLabel" dmx-bind:value="$value.fieldLabel"><label class="form-label small">Stable key</label><input class="form-control form-control-sm mb-2" dmx-bind:value="$value.fieldKey" readonly><label class="form-label small">Help text</label><textarea class="form-control form-control-sm mb-2" name="helpText" dmx-bind:value="$value.helpText"></textarea><label class="form-label small">Placeholder</label><input class="form-control form-control-sm mb-2" name="placeholderText" dmx-bind:value="$value.placeholderText"><label class="form-label small">Default value</label><input class="form-control form-control-sm mb-2" name="defaultValue" dmx-bind:value="$value.defaultValue">
          <div class="row g-2"><div class="col-6"><label class="small">Width</label><select class="form-select form-select-sm" name="columnWidth" dmx-bind:value="$value.columnWidth"><option>3</option><option>4</option><option>6</option><option>8</option><option>12</option></select></div><div class="col-6"><label class="small">Order</label><input class="form-control form-control-sm" name="displayOrder" type="number" dmx-bind:value="$value.displayOrder"></div><div class="col-6"><label class="small">Minimum</label><input class="form-control form-control-sm" name="min" type="number" step="any" dmx-bind:value="$value.validation.min"></div><div class="col-6"><label class="small">Maximum</label><input class="form-control form-control-sm" name="max" type="number" step="any" dmx-bind:value="$value.validation.max"></div><div class="col-6"><label class="small">Min length</label><input class="form-control form-control-sm" name="minLength" type="number" dmx-bind:value="$value.validation.minLength"></div><div class="col-6"><label class="small">Max length</label><input class="form-control form-control-sm" name="maxLength" type="number" dmx-bind:value="$value.validation.maxLength"></div>
          <div class="col-12"><div class="form-check"><input class="form-check-input" type="checkbox" name="isRequired" value="1" dmx-bind:checked="$value.isRequired"><label class="form-check-label">Required</label></div><div class="form-check"><input class="form-check-input" type="checkbox" name="isReadOnly" value="1" dmx-bind:checked="$value.isReadOnly"><label class="form-check-label">Read only</label></div><div class="form-check"><input class="form-check-input" type="checkbox" name="isHidden" value="1" dmx-bind:checked="$value.isHidden"><label class="form-check-label">Hidden initially</label></div></div></div><button class="btn btn-primary btn-sm w-100 mt-3" dmx-bind:disabled="scForm.data.result.form.status != 'draft'">Save Question</button>
        </form>

        <div dmx-show="$value.fieldType == 'dropdown' || $value.fieldType == 'radio' || $value.fieldType == 'multi_select'"><hr><h3 class="h6">Answer choices</h3><p class="small text-muted">Add the choices users can select.</p><ul class="list-group list-group-flush small mb-2"><li class="list-group-item px-0 py-1" is="dmx-repeat" id="selectedOptions" dmx-bind:repeat="$value.options"><span dmx-text="$value.optionLabel"></span><code class="float-end" dmx-text="$value.optionValue"></code></li></ul><form id="frmAddAnswerChoice" is="dmx-serverconnect-form" method="post" action="/api/forms/saveOption" dmx-on:success="scForm.load();reset()"><%- _csrfInput() %><input type="hidden" name="formFieldId" dmx-bind:value="$value.id"><label class="form-label small">Choice label</label><input class="form-control form-control-sm mb-2" name="optionLabel" placeholder="e.g. Yes" required><label class="form-label small">Stable value <span class="text-muted">(optional)</span></label><input class="form-control form-control-sm mb-2" name="optionValue" placeholder="Generated from the label"><label class="form-label small">Display order</label><input class="form-control form-control-sm mb-2" name="displayOrder" type="number" value="100"><div class="alert alert-danger py-2" dmx-show="frmAddAnswerChoice.lastError.status" dmx-text="frmAddAnswerChoice.lastError.response.message.default('The answer choice could not be added.')"></div><button type="submit" class="btn btn-outline-primary btn-sm w-100" dmx-bind:disabled="frmAddAnswerChoice.state.executing"><span dmx-show="!frmAddAnswerChoice.state.executing">Add Choice</span><span dmx-show="frmAddAnswerChoice.state.executing">Adding…</span></button></form></div>

        <hr><h3 class="h6">Conditions</h3><div class="small text-muted mb-2" dmx-show="conditions.count() == 0">No rules configured.</div><ul class="list-group list-group-flush small mb-2"><li class="list-group-item px-0 py-1" is="dmx-repeat" id="selectedConditions" dmx-bind:repeat="conditions"><strong class="text-capitalize" dmx-text="conditionAction"></strong> when field <span dmx-text="controllingFieldId"></span> <span dmx-text="operator.replace('_',' ')"></span> <span dmx-text="comparisonValue"></span></li></ul><form is="dmx-serverconnect-form" method="post" action="/api/forms/saveCondition" dmx-on:success="reset();scForm.load()"><%- _csrfInput() %><input type="hidden" name="formFieldId" dmx-bind:value="id"><select class="form-select form-select-sm mb-2" name="controllingFieldId" dmx-bind:options="scForm.data.result.fields.where('id', id, '!=')" optiontext="fieldLabel" optionvalue="id" required><option value="">Controlling field</option></select><select class="form-select form-select-sm mb-2" name="operator"><option value="equals">Equals</option><option value="not_equals">Does not equal</option><option value="contains">Contains</option><option value="greater_than">Greater than</option><option value="less_than">Less than</option><option value="is_empty">Is empty</option><option value="is_not_empty">Is not empty</option></select><input class="form-control form-control-sm mb-2" name="comparisonValue" placeholder="Comparison value"><select class="form-select form-select-sm mb-2" name="conditionAction"><option value="show">Show field</option><option value="hide">Hide field</option><option value="require">Make required</option><option value="make_optional">Make optional</option></select><button class="btn btn-outline-primary btn-sm w-100">Add Rule</button></form>

        <div dmx-show="$value.fieldType == 'repeatable_table'"><hr><h3 class="h6">Table Columns</h3><ul class="list-group list-group-flush small mb-2"><li class="list-group-item px-0 py-1" is="dmx-repeat" id="selectedColumns" dmx-bind:repeat="$value.repeatableColumns"><span dmx-text="$value.columnLabel"></span><span class="float-end text-muted" dmx-text="$value.columnType"></span></li></ul><form is="dmx-serverconnect-form" method="post" action="/api/forms/saveRepeatableColumn" dmx-on:success="reset();scForm.load()"><%- _csrfInput() %><input type="hidden" name="formFieldId" dmx-bind:value="$parent.$value.id"><input class="form-control form-control-sm mb-2" name="columnLabel" placeholder="Column label" required><input class="form-control form-control-sm mb-2" name="columnKey" placeholder="Stable key (optional)"><select class="form-select form-select-sm mb-2" name="columnType"><option value="text">Text</option><option value="number">Number</option><option value="currency">Currency</option><option value="percentage">Percentage</option><option value="date">Date</option><option value="dropdown">Dropdown</option><option value="yes_no">Yes/No</option></select><input class="form-control form-control-sm mb-2" name="displayOrder" type="number" value="100"><div class="form-check mb-2"><input class="form-check-input" type="checkbox" name="isRequired" value="1"><label class="form-check-label">Required column</label></div><button class="btn btn-outline-primary btn-sm w-100">Add Column</button></form></div>
      </div>
      <div class="card-body text-muted small" dmx-show="!selectedFieldId.value">Select a field on the canvas to configure it.</div>
    </div>
  </aside>
</div>
<meta name="ac:route" content="/forms/designer">
