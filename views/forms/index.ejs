<!-- Wappler include head-page="layouts/main_shell" fontawesome_5="cdn" bootstrap5="local" is="dmx-app" id="forms_index" appConnect="local" components="{dmxStateManagement:{},dmxBrowser:{}}" -->
<dmx-browser id="browserForms"></dmx-browser><dmx-serverconnect id="scForms" url="/api/forms/list"></dmx-serverconnect>
<div class="d-flex justify-content-between align-items-start gap-3 mb-4"><div><h1 class="mb-1">Record Forms</h1><p class="text-muted mb-0">Configure reusable forms for workflow records. Task questions are configured in the Task Template Designer.</p></div><button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createFormModal"><i class="fas fa-plus me-2"></i>Create Record Form</button></div>
<div class="card border-0 shadow-sm"><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Form Name</th><th>Type</th><th>Version</th><th>Status</th><th>Used By</th><th>Last Updated</th><th class="text-end">Actions</th></tr></thead><tbody is="dmx-repeat" id="formsList" dmx-bind:repeat="scForms.data.result.forms"><tr><td><strong dmx-text="formName"></strong><div class="small text-muted" dmx-text="formDescription"></div></td><td class="text-capitalize" dmx-text="formType"></td><td dmx-text="version"></td><td><span class="badge" dmx-class:bg-secondary="status == 'draft'" dmx-class:bg-success="status == 'published'" dmx-class:bg-dark="status == 'archived'" dmx-text="status"></span></td><td><span dmx-show="formType == 'record'" dmx-text="usedByWorkflowTemplates + ' workflow template(s)'"></span><span dmx-show="formType == 'task'" dmx-text="usedByTaskTemplates + ' task template(s)'"></span></td><td dmx-text="modifiedDate.formatDate('dd MMM yyyy HH:mm')"></td><td class="text-end"><div class="btn-group btn-group-sm"><a class="btn btn-outline-primary" dmx-bind:href="'/forms/designer?id=' + id">Edit / Preview</a><form is="dmx-serverconnect-form" method="post" action="/api/forms/newVersion" dmx-on:success="browserForms.goto('/forms/designer?id=' + data.result.id)"><%- _csrfInput() %><input type="hidden" name="id" dmx-bind:value="id"><button class="btn btn-outline-success" dmx-show="status == 'published'">New Version</button></form><form is="dmx-serverconnect-form" method="post" action="/api/forms/duplicate" dmx-on:success="browserForms.goto('/forms/designer?id=' + data.result.id)"><%- _csrfInput() %><input type="hidden" name="id" dmx-bind:value="id"><button class="btn btn-outline-secondary">Duplicate</button></form><form is="dmx-serverconnect-form" method="post" action="/api/forms/archive" dmx-on:success="scForms.load()"><%- _csrfInput() %><input type="hidden" name="id" dmx-bind:value="id"><button class="btn btn-outline-danger" dmx-show="status != 'archived'">Archive</button></form></div></td></tr></tbody></table></div><div class="card-body text-muted" dmx-show="!scForms.state.executing && scForms.data.result.forms.count() == 0">No forms have been configured.</div></div>
<div class="modal fade" id="createFormModal" is="dmx-bs5-modal" tabindex="-1"><div class="modal-dialog"><div class="modal-content"><form id="frmCreateConfigurableForm" is="dmx-serverconnect-form" method="post" action="/api/forms/saveTemplate" dmx-on:success="browserForms.goto('/forms/designer?id=' + frmCreateConfigurableForm.data.result.id)"><%- _csrfInput() %><input type="hidden" name="formType" value="record"><div class="modal-header"><h2 class="modal-title h5">Create Record Form</h2><button class="btn-close" type="button" data-bs-dismiss="modal"></button></div><div class="modal-body"><div class="mb-3"><label class="form-label">Form name</label><input class="form-control" name="formName" maxlength="160" required></div><div class="mb-3"><label class="form-label">Description</label><textarea class="form-control" name="formDescription" rows="3"></textarea></div><div class="alert alert-danger mb-0" dmx-show="frmCreateConfigurableForm.data.message" dmx-text="frmCreateConfigurableForm.data.message"></div></div><div class="modal-footer"><button class="btn btn-light" type="button" data-bs-dismiss="modal">Cancel</button><button type="submit" class="btn btn-primary" dmx-bind:disabled="frmCreateConfigurableForm.state.executing"><span dmx-show="!frmCreateConfigurableForm.state.executing">Create</span><span dmx-show="frmCreateConfigurableForm.state.executing">Creating…</span></button></div></form></div></div></div><meta name="ac:route" content="/forms">
