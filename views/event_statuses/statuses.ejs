<!-- Wappler include head-page="layouts/main_shell" fontawesome_5="cdn" bootstrap5="local" is="dmx-app" id="event_statuses" appConnect="local" -->
<dmx-serverconnect id="scEventStatuses" url="/api/event_statuses/list"></dmx-serverconnect>
<div class="row g-4">
    <div class="col-12"><div class="d-flex justify-content-between align-items-center"><div><h1 class="mb-1">Event statuses</h1><p class="text-muted mb-0">Change the names and colours shown to your organisation. System categories remain fixed for reporting.</p></div><a class="btn btn-outline-secondary" href="/settings">Back to settings</a></div></div>
    <div class="col-12" dmx-show="query.saved == 1"><div class="alert alert-success">Status saved.</div></div>
    <div class="col-12 col-xl-8"><div class="card border-0 shadow-sm"><div class="card-header bg-white"><h2 class="h5 mb-0">Current statuses</h2></div><div class="card-body p-0"><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Status</th><th>System category</th><th>Order</th><th>Use</th><th></th></tr></thead><tbody is="dmx-repeat" dmx-bind:repeat="scEventStatuses.data.query"><tr><td><span class="badge me-2" dmx-bind:style.background-color="colour">&nbsp;</span><span class="fw-semibold" dmx-text="statusName"></span><span class="badge bg-primary ms-2" dmx-show="isDefault == 1">Default</span><span class="badge bg-secondary ms-2" dmx-show="isActive == 0">Inactive</span></td><td class="text-capitalize" dmx-text="systemCategory.replace('_',' ')"></td><td dmx-text="displayOrder"></td><td dmx-text="usageCount + (usageCount == 1 ? ' event' : ' events')"></td><td><button class="btn btn-sm btn-outline-primary" type="button" data-bs-toggle="collapse" dmx-bind:data-bs-target="'#editStatus' + id">Edit</button></td></tr><tr><td colspan="5" class="p-0 border-0"><div class="collapse p-3 bg-light" dmx-bind:id="'editStatus' + id"><form method="post" action="/api/event_statuses/save" class="row g-3 align-items-end"><%- _csrfInput() %><input type="hidden" name="id" dmx-bind:value="id"><div class="col-md-4"><label class="form-label">Name</label><input class="form-control" name="statusName" required maxlength="100" dmx-bind:value="statusName"></div><div class="col-md-3"><label class="form-label">System category</label><select class="form-select" name="systemCategory" dmx-bind:value="systemCategory"><option value="planned">Planned</option><option value="active">Active</option><option value="on_hold">On hold</option><option value="completed">Completed</option><option value="cancelled">Cancelled</option><option value="archived">Archived</option></select></div><div class="col-md-2"><label class="form-label">Order</label><input class="form-control" name="displayOrder" type="number" min="0" dmx-bind:value="displayOrder"></div><div class="col-md-1"><label class="form-label">Colour</label><input class="form-control form-control-color" name="colour" type="color" dmx-bind:value="colour"></div><div class="col-md-2"><div class="form-check"><input class="form-check-input" type="checkbox" name="isActive" value="1" dmx-bind:checked="isActive == 1"><label class="form-check-label">Active</label></div><div class="form-check"><input class="form-check-input" type="checkbox" name="isDefault" value="1" dmx-bind:checked="isDefault == 1"><label class="form-check-label">Default</label></div></div><div class="col-12"><button class="btn btn-primary btn-sm" type="submit">Save status</button></div></form></div></td></tr></tbody></table></div></div></div></div>
    <div class="col-12 col-xl-4"><div class="card border-0 shadow-sm"><div class="card-header bg-white"><h2 class="h5 mb-0">Add status</h2></div><div class="card-body"><form method="post" action="/api/event_statuses/save"><%- _csrfInput() %><div class="mb-3"><label class="form-label">Name</label><input class="form-control" name="statusName" maxlength="100" required></div><div class="mb-3"><label class="form-label">System category</label><select class="form-select" name="systemCategory" required><option value="planned">Planned</option><option value="active">Active</option><option value="on_hold">On hold</option><option value="completed">Completed</option><option value="cancelled">Cancelled</option><option value="archived">Archived</option></select><div class="form-text">Meldren uses this fixed category for reports and workflow logic.</div></div><div class="row g-3"><div class="col-6"><label class="form-label">Order</label><input class="form-control" name="displayOrder" type="number" min="0" value="100"></div><div class="col-6"><label class="form-label">Colour</label><input class="form-control form-control-color" name="colour" type="color" value="#6c757d"></div></div><div class="form-check mt-3"><input class="form-check-input" type="checkbox" name="isActive" value="1" checked><label class="form-check-label">Active</label></div><div class="form-check mb-3"><input class="form-check-input" type="checkbox" name="isDefault" value="1"><label class="form-check-label">Default for new events</label></div><button class="btn btn-primary" type="submit">Add status</button></form></div></div></div>
</div>
<meta name="ac:route" content="/event-statuses">
