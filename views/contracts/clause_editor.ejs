<!-- Wappler include head-page="layouts/main_shell" fontawesome_5="cdn" bootstrap5="local" is="dmx-app" id="contract_clause_editor" appConnect="local" -->
<dmx-serverconnect id="scContractClause" url="/api/contracts/getClause" dmx-param:id="query.id"></dmx-serverconnect>
<div class="row g-4">
    <div class="col-12"><div class="d-flex justify-content-between align-items-center gap-3"><div><h1 class="mb-1" dmx-text="query.id ? 'Edit Contract Clause' : 'Add Contract Clause'">Contract Clause</h1><p class="text-muted mb-0">Do not type a clause number; templates calculate numbering automatically.</p></div><a class="btn btn-outline-secondary" href="/contract-clauses">Back to clauses</a></div></div>
    <div class="col-12"><div class="card border-0 shadow-sm"><div class="card-body p-4"><form id="contractClauseForm" method="post" dmx-bind:action="query.id ? '/api/contracts/updateClause' : '/api/contracts/createClause'"><%- _csrfInput() %><input type="hidden" name="id" dmx-bind:value="query.id"><div class="row g-3 mb-3"><div class="col-md-6"><label class="form-label">Clause name</label><input class="form-control" name="clauseName" required maxlength="180" dmx-bind:value="scContractClause.data.clause[0].clauseName"></div><div class="col-md-3"><label class="form-label">Category</label><input class="form-control" name="clauseCategory" list="clauseCategories" placeholder="e.g. Payment" dmx-bind:value="scContractClause.data.clause[0].clauseCategory"><datalist id="clauseCategories"><option value="Definitions"></option><option value="Commercial"></option><option value="Payment"></option><option value="Cancellation"></option><option value="Force majeure"></option><option value="Technical"></option><option value="Legal"></option></datalist></div><div class="col-md-1"><label class="form-label">Order</label><input class="form-control" name="sortOrder" type="number" dmx-bind:value="scContractClause.data.clause[0].sortOrder.default(100)"></div><div class="col-md-2"><label class="form-label">Status</label><select class="form-select" name="isActive" dmx-bind:value="scContractClause.data.clause[0].isActive.default(1)"><option value="1">Active</option><option value="0">Inactive</option></select></div></div><label class="form-label" for="clauseBody">Clause wording</label><textarea class="form-control" id="clauseBody" name="clauseHtml" rows="14" required dmx-bind:value="scContractClause.data.clause[0].clauseHtml"></textarea><div class="form-text">Use an ordered list inside the clause for automatically numbered subclauses.</div><div class="d-flex justify-content-end gap-2 mt-4"><a class="btn btn-light" href="/contract-clauses">Cancel</a><button class="btn btn-primary" type="submit">Save clause</button></div></form></div></div></div>
</div>
<meta name="ac:route" content="/contract-clauses/editor">
