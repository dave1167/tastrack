<!-- Wappler include head-page="layouts/main_shell" fontawesome_5="cdn" bootstrap5="local" is="dmx-app" id="contract_clause_editor" appConnect="local" -->
<dmx-serverconnect id="scContractClause" url="/api/contracts/getClauseAdvanced" dmx-param:id="query.id"></dmx-serverconnect>
<div class="row g-4">
    <div class="col-12"><div class="d-flex justify-content-between align-items-center gap-3"><div><h1 class="mb-1" dmx-text="query.id ? 'Edit Contract Clause' : 'Add Contract Clause'">Contract Clause</h1><p class="text-muted mb-0">Do not type a clause number; templates calculate numbering automatically.</p></div><a class="btn btn-outline-secondary" href="/contract-clauses">Back to clauses</a></div></div>
    <div class="col-12"><div class="card border-0 shadow-sm"><div class="card-body p-4"><form id="contractClauseForm" method="post" dmx-bind:action="query.id ? '/api/contracts/updateClause' : '/api/contracts/createClause'"><%- _csrfInput() %><input type="hidden" name="id" dmx-bind:value="query.id"><div class="row g-3 mb-3"><div class="col-md-5"><label class="form-label">Clause name</label><input class="form-control" name="clauseName" required maxlength="180" dmx-bind:value="scContractClause.data.clause[0].clauseName"></div><div class="col-md-2"><label class="form-label">Code</label><input class="form-control" name="clauseCode" maxlength="80" dmx-bind:value="scContractClause.data.clause[0].clauseCode"></div><div class="col-md-3"><label class="form-label">Category</label><input class="form-control" name="clauseCategory" list="clauseCategories" dmx-bind:value="scContractClause.data.clause[0].clauseCategory"><datalist id="clauseCategories"><option value="Payment"></option><option value="Cancellation"></option><option value="Force majeure"></option><option value="Technical"></option><option value="Legal"></option></datalist></div><div class="col-md-2"><label class="form-label">Behaviour</label><select class="form-select" name="clauseBehaviour" dmx-bind:value="scContractClause.data.clause[0].clauseBehaviour.default('optional')"><option value="mandatory">Mandatory</option><option value="optional">Optional</option><option value="conditional">Conditional</option></select></div><div class="col-md-6"><label class="form-label">Condition key</label><input class="form-control" name="conditionKey" maxlength="120" placeholder="Required for conditional clauses" dmx-bind:value="scContractClause.data.clause[0].conditionKey"></div><div class="col-md-3"><label class="form-label">Order</label><input class="form-control" name="sortOrder" type="number" dmx-bind:value="scContractClause.data.clause[0].sortOrder.default(100)"></div><div class="col-md-3"><label class="form-label">Status</label><select class="form-select" name="isActive" dmx-bind:value="scContractClause.data.clause[0].isActive.default(1)"><option value="1">Active</option><option value="0">Inactive</option></select></div></div><div class="mb-3"><div class="d-flex justify-content-between align-items-center gap-2 mb-2"><span class="form-label mb-0">Merge fields</span><button class="btn btn-sm btn-outline-secondary" type="button" data-bs-toggle="collapse" data-bs-target="#clauseMergeFields" aria-expanded="false"><i class="fas fa-code me-2"></i>Show merge fields</button></div><div class="collapse" id="clauseMergeFields"><div class="border rounded bg-light p-3"><div class="small fw-semibold text-uppercase text-muted mb-2">Event</div><div class="d-flex flex-wrap gap-1 mb-3"><button class="btn btn-sm btn-outline-secondary contract-clause-field" type="button" data-field="event.name">Event name</button><button class="btn btn-sm btn-outline-secondary contract-clause-field" type="button" data-field="event.reference">Reference</button><button class="btn btn-sm btn-outline-secondary contract-clause-field" type="button" data-field="event.showDate">Show date</button><button class="btn btn-sm btn-outline-secondary contract-clause-field" type="button" data-field="event.showTime">Show time</button><button class="btn btn-sm btn-outline-secondary contract-clause-field" type="button" data-field="location.name">Venue</button><button class="btn btn-sm btn-outline-secondary contract-clause-field" type="button" data-field="space.name">Space</button><button class="btn btn-sm btn-outline-secondary contract-clause-field" type="button" data-field="configuration.name">Configuration</button><button class="btn btn-sm btn-outline-secondary contract-clause-field" type="button" data-field="contractFee">Contract fee</button><button class="btn btn-sm btn-outline-secondary contract-clause-field" type="button" data-field="depositAmount">Deposit</button><button class="btn btn-sm btn-outline-secondary contract-clause-field" type="button" data-field="balanceDueDate">Balance due</button></div><div class="small fw-semibold text-uppercase text-muted mb-2">Contract parties</div><div class="d-flex flex-wrap gap-1 mb-3"><button class="btn btn-sm btn-outline-secondary contract-clause-field" type="button" data-field="contractParty.legalName">Contract party</button><button class="btn btn-sm btn-outline-secondary contract-clause-field" type="button" data-field="contractParty.tradingName">Trading name</button><button class="btn btn-sm btn-outline-secondary contract-clause-field" type="button" data-field="contractParty.address">Party address</button><button class="btn btn-sm btn-outline-secondary contract-clause-field" type="button" data-field="contractParty.registrationNumber">Company number</button><button class="btn btn-sm btn-outline-secondary contract-clause-field" type="button" data-field="contractParty.vatNumber">VAT number</button><button class="btn btn-sm btn-outline-secondary contract-clause-field" type="button" data-field="contractParty.email">Party email</button><button class="btn btn-sm btn-outline-secondary contract-clause-field" type="button" data-field="artist.name">Artist</button><button class="btn btn-sm btn-outline-secondary contract-clause-field" type="button" data-field="manager.name">Manager</button><button class="btn btn-sm btn-outline-secondary contract-clause-field" type="button" data-field="manager.email">Manager email</button><button class="btn btn-sm btn-outline-secondary contract-clause-field" type="button" data-field="promoter.name">Promoter</button><button class="btn btn-sm btn-outline-secondary contract-clause-field" type="button" data-field="agent.name">Agent</button><button class="btn btn-sm btn-outline-secondary contract-clause-field" type="button" data-field="signatory.name">Signatory</button><button class="btn btn-sm btn-outline-secondary contract-clause-field" type="button" data-field="signatory.title">Signatory title</button><button class="btn btn-sm btn-outline-secondary contract-clause-field" type="button" data-field="financeContact.email">Finance email</button></div><div class="small fw-semibold text-uppercase text-muted mb-2">Your organisation</div><div class="d-flex flex-wrap gap-1"><button class="btn btn-sm btn-outline-secondary contract-clause-field" type="button" data-field="tenant.name">Account name</button><button class="btn btn-sm btn-outline-secondary contract-clause-field" type="button" data-field="contractingEntity.legalName">Legal entity</button><button class="btn btn-sm btn-outline-secondary contract-clause-field" type="button" data-field="contractingEntity.tradingName">Trading name</button><button class="btn btn-sm btn-outline-secondary contract-clause-field" type="button" data-field="contractingEntity.registeredAddress">Registered address</button><button class="btn btn-sm btn-outline-secondary contract-clause-field" type="button" data-field="contractingEntity.registrationNumber">Registration number</button><button class="btn btn-sm btn-outline-secondary contract-clause-field" type="button" data-field="contractingEntity.vatNumber">VAT number</button><button class="btn btn-sm btn-outline-secondary contract-clause-field" type="button" data-field="contractingEntity.signatoryName">Signatory</button><button class="btn btn-sm btn-outline-secondary contract-clause-field" type="button" data-field="contractingEntity.signatoryTitle">Signatory title</button><button class="btn btn-sm btn-outline-secondary contract-clause-field" type="button" data-field="contractingEntity.paymentTerms">Payment terms</button></div></div></div></div><label class="form-label" for="clauseBody">Clause wording</label><textarea class="form-control" id="clauseBody" name="clauseHtml" rows="14" is="dmx-summernote" height="420" placeholder="Write the reusable clause wording here..." dmx-bind:value="scContractClause.data.clause[0].clauseHtml" dmx-bind:toolbar="[['style',['style']],['font',['fontsize','bold','italic','underline','clear','fontname']],['para',['ul','ol','paragraph']],['insert',['link','table','hr']],['view',['codeview','help']]]"></textarea><div class="form-text">Place the cursor in the wording, then choose a merge field above. Its value is filled when a contract is generated or issued.</div><div class="d-flex justify-content-end gap-2 mt-4"><a class="btn btn-light" href="/contract-clauses">Cancel</a><button class="btn btn-primary" type="submit">Save clause</button></div></form></div></div></div>
</div>
<meta name="ac:route" content="/contract-clauses/editor">
