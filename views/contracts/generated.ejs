<!-- Wappler include head-page="layouts/main_shell" fontawesome_5="cdn" bootstrap5="local" is="dmx-app" id="generated_contract" appConnect="local" -->
<dmx-serverconnect id="scGeneratedContract" url="/api/contracts/generated" dmx-param:id="query.id"></dmx-serverconnect>
<div class="row g-4">
    <div class="col-12"><div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3"><div><h1 class="mb-1" dmx-text="scGeneratedContract.data.contract[0].contractName">Generated Contract</h1><p class="text-muted mb-0"><span dmx-text="scGeneratedContract.data.contract[0].workflowName"></span> · Version <span dmx-text="scGeneratedContract.data.contract[0].templateVersionNumber"></span> · Generated by <span dmx-text="scGeneratedContract.data.contract[0].generatedBy"></span></p></div><a class="btn btn-outline-secondary" dmx-bind:href="'/workflows/view?id=' + scGeneratedContract.data.contract[0].workflowId + '&section=documents'">Back to event documents</a></div></div>
    <div class="col-12"><div class="card border-0 shadow-sm"><div class="card-body p-0"><iframe class="w-100 border-0 contract-preview-frame" title="Generated contract" sandbox="" dmx-bind:srcdoc="scGeneratedContract.data.contract[0].renderedHtml"></iframe></div></div></div>
</div>
<style>.contract-preview-frame{min-height:75vh;background:#fff}</style>
<meta name="ac:route" content="/contracts/generated">
