<!-- Wappler include head-page="layouts/main_shell" fontawesome_5="cdn" bootstrap5="local" is="dmx-app" id="generated_contract" appConnect="local" -->
<dmx-serverconnect id="scGeneratedContract" url="/api/contracts/generatedDetail" dmx-param:id="query.id"></dmx-serverconnect>
<dmx-serverconnect id="scContractDeliveries" url="/api/contracts/deliveries" dmx-param:contractId="query.id"></dmx-serverconnect>
<dmx-serverconnect id="scContractVersions" url="/api/contracts/versions" dmx-param:contractId="query.id"></dmx-serverconnect>
<dmx-serverconnect id="scGeneratedContractClauses" url="/api/contracts/contractClauses" dmx-param:contractId="query.id"></dmx-serverconnect>
<div class="row g-4">
    <div class="col-12"><div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3"><div><h1 class="mb-1" dmx-text="scGeneratedContract.data.contract[0].contractName">Generated Contract</h1><p class="text-muted mb-0"><span dmx-text="scGeneratedContract.data.contract[0].workflowName"></span> · <span dmx-text="scGeneratedContract.data.contract[0].status == 'draft' ? 'Next issued version ' + (scGeneratedContract.data.contract[0].contractVersionNumber.default(0) + 1) : 'Version ' + scGeneratedContract.data.contract[0].contractVersionNumber"></span> · <span class="text-uppercase" dmx-text="scGeneratedContract.data.contract[0].status"></span></p></div><div class="d-flex gap-2"><a class="btn btn-primary" dmx-show="scGeneratedContract.data.contract[0].pdfFileName" dmx-bind:href="'/api/contracts/downloadPdf?id=' + query.id"><i class="fas fa-download me-2"></i>Download PDF</a><a class="btn btn-outline-secondary" dmx-bind:href="'/workflows/view?id=' + scGeneratedContract.data.contract[0].workflowId + '&section=documents'">Back to event</a></div></div></div>
    <div class="col-12" dmx-show="scGeneratedContract.data.contract[0].status == 'draft'"><div class="alert alert-warning d-flex justify-content-between align-items-center"><div><strong>Draft contract</strong><div class="small">This wording is editable and is not yet under version control.</div></div><a class="btn btn-warning" dmx-bind:href="'/contracts/editor?id=' + query.id">Edit draft</a></div></div>
    <div class="col-12" dmx-show="scGeneratedContract.data.contract[0].status == 'issued' || scGeneratedContract.data.contract[0].status == 'sent'"><div class="d-flex justify-content-end"><form method="post" action="/api/contracts/createRevision"><%- _csrfInput() %><input type="hidden" name="contractId" dmx-bind:value="scGeneratedContract.data.contract[0].id"><button class="btn btn-outline-primary" type="submit"><i class="fas fa-code-branch me-2"></i>Create new draft revision</button></form></div></div>
    <div class="col-12"><div class="card border-0 shadow-sm"><div class="card-body p-0"><iframe class="w-100 border-0 contract-preview-frame" title="Generated contract" sandbox="" dmx-bind:srcdoc="scGeneratedContract.data.contract[0].renderedHtml"></iframe></div></div></div>
    <div class="col-12"><div class="d-flex justify-content-between align-items-center mb-3"><h2 class="h4 mb-0">Contract clauses</h2><a class="btn btn-outline-primary" dmx-bind:href="'/contracts/editor?id=' + query.id">Manage clauses</a></div><div class="vstack gap-3" is="dmx-repeat" dmx-bind:repeat="scGeneratedContractClauses.data.clauses.where('isIncluded', 1, '==')"><section class="card border-0 shadow-sm"><div class="card-body"><h3 class="h5" dmx-text="$value.clauseHeading"></h3><iframe class="w-100 border-0" style="min-height:8rem" title="Contract clause" sandbox="" dmx-bind:srcdoc="$value.clauseTextSnapshot"></iframe></div></section></div></div>
    <div class="col-12 col-xl-5" dmx-show="scGeneratedContract.data.contract[0].pdfFileName"><div class="card border-0 shadow-sm"><div class="card-header bg-white"><h2 class="h5 mb-0">Record external sending</h2></div><div class="card-body"><p class="small text-muted">Use this after sending the downloaded PDF through Outlook, Gmail or another external system.</p><form method="post" action="/api/contracts/recordExternalDelivery"><%- _csrfInput() %><input type="hidden" name="contractId" dmx-bind:value="query.id"><div class="mb-3"><label class="form-label">Recipient name</label><input class="form-control" name="recipientName" maxlength="180"></div><div class="mb-3"><label class="form-label">Recipient email</label><input class="form-control" type="email" name="recipientEmail" maxlength="254" required></div><div class="mb-3"><label class="form-label">Sent date and time</label><input class="form-control" type="datetime-local" name="sentDate"></div><div class="mb-3"><label class="form-label">Email subject</label><input class="form-control" name="subject" maxlength="255" dmx-bind:value="scGeneratedContract.data.contract[0].contractName"></div><div class="mb-3"><label class="form-label">Notes</label><textarea class="form-control" name="notes" rows="3"></textarea></div><button class="btn btn-primary" type="submit"><i class="fas fa-check me-2"></i>Record as sent</button></form></div></div></div>
    <div class="col-12 col-xl-7" dmx-show="scGeneratedContract.data.contract[0].pdfFileName"><div class="card border-0 shadow-sm"><div class="card-header bg-white"><h2 class="h5 mb-0">Delivery history</h2></div><div class="card-body"><div class="vstack gap-3" is="dmx-repeat" dmx-bind:repeat="scContractDeliveries.data.deliveries"><div class="border-bottom pb-3"><div class="d-flex justify-content-between"><strong dmx-text="$value.recipientEmail"></strong><span class="badge bg-light text-dark border" dmx-text="$value.deliveryMethod"></span></div><div class="small text-muted"><span dmx-text="$value.sentDate.formatDate('dd MMM yyyy HH:mm')"></span> · recorded by <span dmx-text="$value.recordedBy"></span></div><div class="small font-monospace text-muted text-break mt-1" dmx-text="'PDF SHA-256: ' + $value.pdfSha256Snapshot"></div></div></div><p class="text-muted mb-0" dmx-show="scContractDeliveries.data.deliveries.count() == 0">No delivery has been recorded.</p></div></div></div>
    <div class="col-12" dmx-show="scContractVersions.data.versions.count() > 0"><div class="card border-0 shadow-sm"><div class="card-header bg-white"><h2 class="h5 mb-0">Issued versions</h2></div><div class="table-responsive"><table class="table align-middle mb-0"><thead class="table-light"><tr><th>Version</th><th>Issued</th><th>PDF fingerprint</th><th></th></tr></thead><tbody is="dmx-repeat" dmx-bind:repeat="scContractVersions.data.versions"><tr><td class="fw-semibold" dmx-text="'Version ' + $value.contractVersionNumber"></td><td><div dmx-text="$value.issuedDate.formatDate('dd MMM yyyy HH:mm')"></div><div class="small text-muted" dmx-text="$value.issuedBy"></div></td><td class="small font-monospace text-break" dmx-text="$value.pdfSha256"></td><td class="text-end"><a class="btn btn-sm btn-outline-primary" dmx-bind:href="'/api/contracts/downloadVersion?id=' + $value.id"><i class="fas fa-download me-1"></i>PDF</a></td></tr></tbody></table></div></div></div>
</div>
<style>.contract-preview-frame{min-height:75vh;background:#fff}</style>
<meta name="ac:route" content="/contracts/generated">
