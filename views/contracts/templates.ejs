<!-- Wappler include head-page="layouts/main_shell" fontawesome_5="cdn" bootstrap5="local" is="dmx-app" id="contract_templates" appConnect="local" -->
<dmx-serverconnect id="scContractTemplates" url="/api/contracts/templates"></dmx-serverconnect>
<div class="row g-4">
    <div class="col-12"><div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3"><div><h1 class="mb-1">Document Templates</h1><p class="text-muted mb-0">One editor for contracts, emails, letters and reports.</p></div><div class="d-flex gap-2"><a class="btn btn-outline-primary" href="/contract-clauses"><i class="fas fa-paragraph me-2"></i>Contract clauses</a><a class="btn btn-primary" href="/document-templates/editor"><i class="fas fa-plus me-2"></i>Add template</a></div></div></div>
    <div class="col-12"><div class="card border-0 shadow-sm"><div class="card-body p-0"><div class="table-responsive" dmx-show="scContractTemplates.data.query.count() > 0"><table class="table table-hover align-middle mb-0"><thead class="table-light"><tr><th>Template</th><th>Version</th><th>Status</th><th>Last changed</th><th></th></tr></thead><tbody is="dmx-repeat" dmx-bind:repeat="scContractTemplates.data.query"><tr><td><div class="fw-semibold" dmx-text="$value.templateName"></div><div class="small text-muted" dmx-text="$value.description"></div></td><td dmx-text="'Version ' + $value.versionNumber"></td><td><span class="badge bg-success" dmx-show="$value.isActive == 1">Active</span><span class="badge bg-secondary" dmx-show="$value.isActive != 1">Inactive</span></td><td><div dmx-text="$value.modifiedDate.formatDate('dd MMM yyyy')"></div><div class="small text-muted" dmx-text="$value.modifiedBy"></div></td><td class="text-end"><a class="btn btn-sm btn-outline-primary" dmx-bind:href="'/contract-templates/editor?id=' + $value.id"><i class="fas fa-pen me-1"></i>Edit</a></td></tr></tbody></table></div><div class="text-center text-muted py-5" dmx-show="!scContractTemplates.state.executing && scContractTemplates.data.query.count() == 0"><i class="fas fa-file-contract fa-2x mb-3"></i><h2 class="h6">No contract templates yet</h2><p class="small">Add the first template to begin generating contracts.</p></div></div></div></div>
</div>
<meta name="ac:route" content="/document-templates">
