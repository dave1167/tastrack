<!-- Wappler include head-page="layouts/main_shell" fontawesome_5="cdn" bootstrap5="local" is="dmx-app" id="contract_clause_manager" appConnect="local" -->
<dmx-serverconnect id="scContractClauses" url="/api/contracts/contractClauses" dmx-param:contractId="query.id"></dmx-serverconnect>
<dmx-serverconnect id="scContractDraft" url="/api/contracts/generatedDetail" dmx-param:id="query.id"></dmx-serverconnect>
<dmx-serverconnect id="scContractVersions" url="/api/contracts/versions" dmx-param:contractId="query.id"></dmx-serverconnect>
<dmx-serverconnect id="scContractWorkflow" url="/api/workflows/get" dmx-param:id="scContractDraft.data.contract[0].workflowId"></dmx-serverconnect>
<dmx-serverconnect id="scContractPartyDetails" url="/api/contracts/eventContractDetails" dmx-param:workflowid="scContractDraft.data.contract[0].workflowId"></dmx-serverconnect>
<dmx-serverconnect id="scContractContactOptions" url="/api/workflows/contact_options"></dmx-serverconnect>
<dmx-serverconnect id="scContractFieldValues" url="/api/workflows/contract_field_values" dmx-param:workflowid="scContractDraft.data.contract[0].workflowId"></dmx-serverconnect>
<div class="row g-4">
    <div class="col-12"><div class="d-flex flex-column flex-lg-row justify-content-between gap-3"><div><div class="text-uppercase text-muted small fw-semibold">Individual contract</div><h1 dmx-text="scContractDraft.data.contract[0].contractName">Contract draft</h1><div class="mb-2"><span class="badge bg-warning text-dark" dmx-show="scContractDraft.data.contract[0].status == 'draft'" dmx-text="'Draft · Next issued version ' + (scContractDraft.data.contract[0].contractVersionNumber.default(0) + 1)"></span><span class="badge bg-success" dmx-show="scContractDraft.data.contract[0].status != 'draft'" dmx-text="'Version ' + scContractDraft.data.contract[0].contractVersionNumber"></span></div><p class="text-muted">Edit the complete draft freely. Version control starts only when you issue it.</p></div><div class="d-flex flex-wrap align-items-start gap-2"><a class="btn btn-light" dmx-bind:href="'/workflows/view?id=' + scContractDraft.data.contract[0].workflowId + '&section=documents'"><i class="fas fa-arrow-left me-2"></i>Back to documents</a><a class="btn btn-outline-secondary" dmx-bind:href="'/contracts/generated?id=' + query.id">Preview</a><button class="btn btn-outline-primary" id="refreshAllContractData" type="button" dmx-show="scContractDraft.data.contract[0].status == 'draft'"><i class="fas fa-sync-alt me-2"></i>Refresh all contract data</button><form method="post" action="/api/contracts/removeDraft" dmx-show="scContractDraft.data.contract.count() > 0 && scContractDraft.data.contract[0].status == 'draft' && scContractVersions.data.versions.count() == 0" onsubmit="return confirm('Permanently delete this unissued draft? This cannot be undone.');"><%- _csrfInput() %><input type="hidden" name="contractId" dmx-bind:value="query.id"><button class="btn btn-outline-danger" type="submit"><i class="fas fa-trash me-2"></i>Delete draft</button></form><form method="post" action="/api/contracts/removeDraft" dmx-show="scContractDraft.data.contract.count() > 0 && scContractDraft.data.contract[0].status == 'draft' && scContractVersions.data.versions.count() > 0" onsubmit="return confirm('Discard this draft revision and restore the latest issued version?');"><%- _csrfInput() %><input type="hidden" name="contractId" dmx-bind:value="query.id"><button class="btn btn-outline-danger" type="submit"><i class="fas fa-undo me-2"></i>Discard revision</button></form><form method="post" action="/api/contracts/issueVersioned" dmx-show="scContractDraft.data.contract.count() > 0 && scContractDraft.data.contract[0].status == 'draft'"><%- _csrfInput() %><input type="hidden" name="contractId" dmx-bind:value="query.id"><button class="btn btn-success" type="submit">Issue version</button></form></div></div></div>
    <div class="col-12" dmx-show="scContractClauses.state.executing || scContractDraft.state.executing"><div class="alert alert-light border"><span class="spinner-border spinner-border-sm me-2" role="status"></span>Loading this contract…</div></div>
    <div class="col-12" dmx-show="!scContractDraft.state.executing && scContractDraft.data.contract.count() > 0 && scContractDraft.data.contract[0].status != 'draft'"><div class="alert alert-info"><i class="fas fa-lock me-2"></i>This issued contract is locked. Create a draft revision to make further changes.</div></div>
    <div class="col-12" dmx-show="!scContractDraft.state.executing && scContractDraft.lastError.status"><div class="alert alert-danger">The contract could not be loaded. Please return to the event and open it again.</div></div>
    <div class="col-12 col-xl-7 contract-editor-scroll-column" dmx-show="scContractDraft.data.contract.count() > 0 && scContractDraft.data.contract[0].status == 'draft'">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white"><h2 class="h5 mb-1">Draft wording</h2><p class="small text-muted mb-0">Saving the draft does not create a numbered version.</p></div>
            <div class="card-body"><form id="contractDraftForm" method="post" action="/api/contracts/updateDraft" onsubmit="var contractId=new URLSearchParams(window.location.search).get('id'); this.contractId.value=contractId || ''; this.action='/api/contracts/updateDraft?id='+encodeURIComponent(contractId || '');"><%- _csrfInput() %><input type="hidden" name="contractId" dmx-bind:value="query.id"><div class="mb-3"><label class="form-label">Contract name</label><input class="form-control" name="contractName" maxlength="180" required dmx-bind:value="scContractDraft.data.contract[0].contractName"></div><div class="mb-3"><div class="d-flex justify-content-between align-items-center gap-2 mb-2"><label class="form-label mb-0" for="contractDraftBody">Contract wording</label><button class="btn btn-sm btn-outline-secondary" type="button" data-bs-toggle="collapse" data-bs-target="#draftMergeFields" aria-expanded="false"><i class="fas fa-code me-2"></i>Insert merge field</button></div><div class="collapse mb-3" id="draftMergeFields"><div class="border rounded bg-light p-3"><div class="small fw-semibold text-uppercase text-muted mb-2">Event</div><div class="d-flex flex-wrap gap-1 mb-3"><button class="btn btn-sm btn-outline-secondary contract-draft-field" type="button" data-field="event.name">Event name</button><button class="btn btn-sm btn-outline-secondary contract-draft-field" type="button" data-field="event.reference">Reference</button><button class="btn btn-sm btn-outline-secondary contract-draft-field" type="button" data-field="event.showDate">Show date</button><button class="btn btn-sm btn-outline-secondary contract-draft-field" type="button" data-field="event.showTime">Show time</button><button class="btn btn-sm btn-outline-secondary contract-draft-field" type="button" data-field="location.name">Venue</button><button class="btn btn-sm btn-outline-secondary contract-draft-field" type="button" data-field="space.name">Space</button><button class="btn btn-sm btn-outline-secondary contract-draft-field" type="button" data-field="configuration.name">Configuration</button><button class="btn btn-sm btn-outline-secondary contract-draft-field" type="button" data-field="contractFee">Fee</button><button class="btn btn-sm btn-outline-secondary contract-draft-field" type="button" data-field="depositAmount">Deposit</button><button class="btn btn-sm btn-outline-secondary contract-draft-field" type="button" data-field="balanceDueDate">Balance due</button></div><div class="small fw-semibold text-uppercase text-muted mb-2">Contract parties</div><div class="d-flex flex-wrap gap-1 mb-3"><button class="btn btn-sm btn-outline-secondary contract-draft-field" type="button" data-field="contractParty.legalName">Contract party</button><button class="btn btn-sm btn-outline-secondary contract-draft-field" type="button" data-field="contractParty.tradingName">Trading name</button><button class="btn btn-sm btn-outline-secondary contract-draft-field" type="button" data-field="contractParty.address">Party address</button><button class="btn btn-sm btn-outline-secondary contract-draft-field" type="button" data-field="contractParty.registrationNumber">Company number</button><button class="btn btn-sm btn-outline-secondary contract-draft-field" type="button" data-field="contractParty.vatNumber">VAT number</button><button class="btn btn-sm btn-outline-secondary contract-draft-field" type="button" data-field="contractParty.email">Party email</button><button class="btn btn-sm btn-outline-secondary contract-draft-field" type="button" data-field="artist.name">Artist</button><button class="btn btn-sm btn-outline-secondary contract-draft-field" type="button" data-field="manager.name">Manager</button><button class="btn btn-sm btn-outline-secondary contract-draft-field" type="button" data-field="manager.email">Manager email</button><button class="btn btn-sm btn-outline-secondary contract-draft-field" type="button" data-field="promoter.name">Promoter</button><button class="btn btn-sm btn-outline-secondary contract-draft-field" type="button" data-field="agent.name">Agent</button><button class="btn btn-sm btn-outline-secondary contract-draft-field" type="button" data-field="signatory.name">Signatory</button><button class="btn btn-sm btn-outline-secondary contract-draft-field" type="button" data-field="signatory.title">Signatory title</button><button class="btn btn-sm btn-outline-secondary contract-draft-field" type="button" data-field="financeContact.email">Finance email</button></div><div class="small fw-semibold text-uppercase text-muted mb-2">Your organisation</div><div class="d-flex flex-wrap gap-1"><button class="btn btn-sm btn-outline-secondary contract-draft-field" type="button" data-field="tenant.name">Account name</button><button class="btn btn-sm btn-outline-secondary contract-draft-field" type="button" data-field="contractingEntity.legalName">Legal entity</button><button class="btn btn-sm btn-outline-secondary contract-draft-field" type="button" data-field="contractingEntity.tradingName">Trading name</button><button class="btn btn-sm btn-outline-secondary contract-draft-field" type="button" data-field="contractingEntity.registeredAddress">Registered address</button><button class="btn btn-sm btn-outline-secondary contract-draft-field" type="button" data-field="contractingEntity.registrationNumber">Registration number</button><button class="btn btn-sm btn-outline-secondary contract-draft-field" type="button" data-field="contractingEntity.vatNumber">VAT number</button><button class="btn btn-sm btn-outline-secondary contract-draft-field" type="button" data-field="contractingEntity.signatoryName">Signatory</button><button class="btn btn-sm btn-outline-secondary contract-draft-field" type="button" data-field="contractingEntity.paymentTerms">Payment terms</button></div></div></div><textarea class="form-control" id="contractDraftBody" name="renderedHtml" rows="20" is="dmx-summernote" height="560" placeholder="Write the contract wording here..." dmx-bind:value="scContractDraft.data.contract[0].renderedHtml" dmx-bind:toolbar="[['style',['style']],['font',['fontsize','bold','italic','underline','clear','fontname']],['para',['ul','ol','paragraph']],['insert',['link','table','hr']],['view',['codeview','help']]]"></textarea><div class="form-text">Use the editor to format the contract. Merge fields are resolved when the contract is issued.</div></div><div class="text-end"><button class="btn btn-primary" type="submit"><i class="fas fa-save me-2"></i>Save draft</button></div></form></div>
        </div>
    </div>
    <div class="col-12 col-xl-5 contract-editor-scroll-column" dmx-show="scContractDraft.data.contract.count() > 0">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white"><h2 class="h5 mb-1">Add contract wording</h2><p class="small text-muted mb-0">Choose a standard clause and it will be inserted into the contract editor.</p></div>
            <div class="card-body" dmx-show="scContractDraft.data.contract[0].status == 'draft'">
                <div id="frmAddLibraryContractClause" class="mb-3"><label class="form-label">Clause library</label><div class="input-group"><select class="form-select" name="clauseId" required dmx-bind:options="scContractClauses.data.library" optiontext="clauseName" optionvalue="id"><option value="">Choose a clause</option></select><button class="btn btn-outline-primary" id="btnAddLibraryContractClause" type="button">Add</button></div></div>
                <div id="contractClauseInsertNotice" class="alert alert-success small d-none" role="status"></div><button class="btn btn-sm btn-outline-primary w-100" type="button" data-bs-toggle="collapse" data-bs-target="#addCustomContractClause" aria-expanded="false"><i class="fas fa-plus me-2"></i>Write a one-off clause</button><button class="btn btn-sm btn-outline-secondary w-100 mt-2" id="renumberContractClauses" type="button"><i class="fas fa-list-ol me-2"></i>Renumber clauses</button>
                <div class="collapse mt-3" id="addCustomContractClause"><form id="frmAddCustomContractClause" is="dmx-serverconnect-form" method="post" action="/api/contracts/addContractClause" dmx-on:success="scContractClauses.load({contractId: query.id})"><%- _csrfInput() %><input type="hidden" name="contractId" dmx-bind:value="query.id"><input type="hidden" name="sourceClauseId" value="0"><input type="hidden" name="clauseBehaviour" value="optional"><input class="form-control mb-2" name="clauseHeading" required maxlength="180" placeholder="Clause heading"><textarea class="form-control mb-2" name="clauseText" rows="4" required placeholder="Clause wording"></textarea><button class="btn btn-primary w-100" id="btnAddCustomContractClause" type="submit">Add custom clause</button></form></div>
            </div>
        </div>
    </div>
</div>
<meta name="ac:route" content="/contracts/editor">
