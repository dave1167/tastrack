<!-- Wappler include head-page="layouts/main_shell" fontawesome_5="cdn" bootstrap5="local" is="dmx-app" id="contract_clauses" appConnect="local" -->
<dmx-serverconnect id="scContractClauses" url="/api/contracts/clauses"></dmx-serverconnect>
<div class="row g-4">
    <div class="col-12"><div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3"><div><h1 class="mb-1">Contract Clause Library</h1><p class="text-muted mb-0">Reusable wording that can be inserted into contract templates.</p></div><div class="d-flex gap-2"><a class="btn btn-outline-secondary" href="/contract-templates">Contract templates</a><a class="btn btn-primary" href="/contract-clauses/editor"><i class="fas fa-plus me-2"></i>Add clause</a></div></div></div>
    <div class="col-12"><div class="card border-0 shadow-sm"><div class="card-body p-0"><div class="table-responsive" dmx-show="scContractClauses.data.clauses.count() > 0"><table class="table table-hover align-middle mb-0"><thead class="table-light"><tr><th>Clause</th><th>Category</th><th>Order</th><th>Status</th><th>Last changed</th><th></th></tr></thead><tbody is="dmx-repeat" dmx-bind:repeat="scContractClauses.data.clauses"><tr><td class="fw-semibold" dmx-text="$value.clauseName"></td><td dmx-text="$value.clauseCategory || 'Uncategorised'"></td><td dmx-text="$value.sortOrder"></td><td><span class="badge bg-success" dmx-show="$value.isActive == 1">Active</span><span class="badge bg-secondary" dmx-show="$value.isActive != 1">Inactive</span></td><td><div dmx-text="$value.modifiedDate.formatDate('dd MMM yyyy')"></div><div class="small text-muted" dmx-text="$value.modifiedBy"></div></td><td class="text-end"><a class="btn btn-sm btn-outline-primary" dmx-bind:href="'/contract-clauses/editor?id=' + $value.id"><i class="fas fa-pen me-1"></i>Edit</a></td></tr></tbody></table></div><div class="text-center text-muted py-5" dmx-show="!scContractClauses.state.executing && scContractClauses.data.clauses.count() == 0"><i class="fas fa-paragraph fa-2x mb-3"></i><h2 class="h6">No reusable clauses yet</h2><p class="small">Add clauses such as payment, cancellation and force majeure.</p></div></div></div></div>
</div>
<meta name="ac:route" content="/contract-clauses">
