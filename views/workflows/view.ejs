<!-- Wappler include head-page="layouts/main_shell" fontawesome_5="cdn" bootstrap5="local" is="dmx-app" id="view_workflow" appConnect="local" components="{dmxStateManagement:{}}" -->
<dmx-serverconnect id="scWorkflow" url="/api/workflows/get" dmx-param:id="query.id"></dmx-serverconnect>
<dmx-serverconnect id="scWorkflowConcurrency" url="/api/workflows/concurrency_info" dmx-param:id="query.id"></dmx-serverconnect>
<dmx-serverconnect id="scStages" url="/api/workflows/stages" dmx-param:workflowid="query.id"></dmx-serverconnect>
<dmx-serverconnect id="scTasks" url="/api/workflows/tasks" dmx-param:workflowid="query.id"></dmx-serverconnect>
<dmx-serverconnect id="scWorkflowContacts" url="/api/workflows/contacts" dmx-param:workflowid="query.id"></dmx-serverconnect>
<dmx-serverconnect id="scContactOptions" url="/api/workflows/contact_options"></dmx-serverconnect>
<dmx-serverconnect id="scDocuments" url="/api/workflows/activeDocuments" dmx-param:workflowid="query.id"></dmx-serverconnect>
<dmx-serverconnect id="scContractOptions" url="/api/contracts/options" dmx-param:workflowid="query.id"></dmx-serverconnect>
<dmx-serverconnect id="scEventContractDetails" url="/api/contracts/eventContractDetails" dmx-param:workflowid="query.id"></dmx-serverconnect>
<dmx-serverconnect id="scTaskAssignees" url="/api/tasks/assignee_options"></dmx-serverconnect>
<dmx-serverconnect id="scOneOffTeamMembers" url="/api/tasks/team_member_options" dmx-param:teamid="oneOffAssignment.value.split(':')[1]"></dmx-serverconnect>
<dmx-serverconnect id="scLocations" url="/api/locations/options" dmx-param:selectedid="scWorkflow.data.query[0].locationId"></dmx-serverconnect>
<dmx-serverconnect id="scSpaces" url="/api/locations/spaceOptions" dmx-param:locationid="eventLocationId.value" dmx-param:selectedid="scWorkflow.data.query[0].spaceId" dmx-param:workflowid="query.id"></dmx-serverconnect>
<dmx-serverconnect id="scConfigurations" url="/api/locations/configurationOptions" dmx-param:spaceid="eventSpaceId.value" dmx-param:selectedid="scWorkflow.data.query[0].configurationId" dmx-param:workflowid="query.id"></dmx-serverconnect>
<dmx-serverconnect id="scNotificationRecipients" url="/api/notifications/recipients"></dmx-serverconnect>
<dmx-serverconnect id="scEventStatuses" url="/api/event_statuses/options" dmx-param:selectedid="scWorkflow.data.query[0].eventStatusId"></dmx-serverconnect>
<dmx-serverconnect id="scCurrentMilestone" url="/api/event_milestones/current" dmx-param:workflowid="query.id"></dmx-serverconnect>
<dmx-serverconnect id="scMilestoneOptions" url="/api/event_milestones/milestone_options" dmx-param:selectedid="scCurrentMilestone.data.query[0].currentMilestoneId"></dmx-serverconnect>
<dmx-serverconnect id="scCommercial" url="/api/commercial/get" dmx-param:workflowid="query.id"></dmx-serverconnect>

<div class="row g-4">
    <div class="col-12" dmx-show="query.saved == 1"><div class="alert alert-success mb-0"><i class="fas fa-check-circle me-2"></i><strong>Changes saved.</strong> The event has been updated successfully.</div></div>
    <div class="col-12">
        <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3">
            <div><h1 class="mb-1" dmx-text="scWorkflow.data.query[0].workflowName"></h1><div class="d-flex flex-wrap align-items-center gap-x-3 gap-2 mb-1"><span class="fw-semibold"><i class="fas fa-calendar-day text-primary me-2"></i><span dmx-text="scWorkflow.data.query[0].showDate ? scWorkflow.data.query[0].showDate.formatDate('ddd dd MMM yyyy') : 'Date not set'">Date not set</span></span><span class="fw-semibold"><i class="fas fa-clock text-primary me-2"></i><span dmx-text="scWorkflow.data.query[0].showTime || 'Time not set'">Time not set</span><a class="small ms-2 fw-normal" dmx-bind:href="'/workflows/edit?id=' + query.id" dmx-text="scWorkflow.data.query[0].showTime ? 'Change' : 'Set time'">Set time</a></span></div><p class="text-muted mb-0"><span dmx-text="scWorkflow.data.query[0].referenceCode"></span><span dmx-show="scWorkflow.data.query[0].referenceCode && scWorkflow.data.query[0].effectiveLocation"> &middot; </span><span dmx-text="scWorkflow.data.query[0].effectiveLocation"></span></p></div>
            <div class="d-flex flex-wrap gap-2"><button class="btn btn-outline-primary" type="button" data-bs-toggle="modal" data-bs-target="#sendEventNotificationModal"><i class="fas fa-bell me-2"></i>Notify people</button><a class="btn btn-outline-secondary" href="/workflows" dmx-text="scTerminology.data.query[0].workflowPlural">Workflows</a><a class="btn btn-outline-primary" href="/workflows/calendar"><i class="fas fa-calendar-alt me-2"></i>Calendar</a><a class="btn btn-outline-primary" dmx-bind:href="'/workflows/edit?id=' + query.id" dmx-text="'Edit ' + scTerminology.data.query[0].workflowSingular.lowercase()">Edit workflow</a></div>
        </div>
    </div>

    <div class="col-12">
        <nav aria-label="Event sections">
            <div class="nav nav-tabs flex-nowrap overflow-auto" id="eventSectionTabs" role="tablist">
                <a class="nav-link text-nowrap" id="eventInfoTab" role="tab" dmx-bind:href="'/workflows/view?id=' + query.id + '&section=info'" dmx-class:active="!query.section || query.section == 'info'" dmx-bind:aria-selected="(!query.section || query.section == 'info').toString()" aria-controls="eventInfoSummary"><i class="fas fa-calendar-alt me-2"></i><span dmx-text="scTerminology.data.query[0].workflowSingular + ' Info'">Event Info</span></a>
                <a class="nav-link text-nowrap" id="eventTasksTab" role="tab" dmx-bind:href="'/workflows/view?id=' + query.id + '&section=tasks'" dmx-class:active="query.section == 'tasks'" dmx-bind:aria-selected="(query.section == 'tasks').toString()" aria-controls="eventInfoWorkflow"><i class="fas fa-tasks me-2"></i><span dmx-text="scTerminology.data.query[0].taskPlural">Tasks</span> <span class="badge rounded-pill bg-secondary ms-1" dmx-text="scTasks.data.query.count()">0</span></a>
                <a class="nav-link text-nowrap" id="eventContactsTab" role="tab" dmx-bind:href="'/workflows/view?id=' + query.id + '&section=contacts'" dmx-class:active="query.section == 'contacts'" dmx-bind:aria-selected="(query.section == 'contacts').toString()" aria-controls="eventContactsSection"><i class="fas fa-address-book me-2"></i>Contacts <span class="badge rounded-pill bg-secondary ms-1" dmx-text="scWorkflowContacts.data.query.count()">0</span></a>
                <a class="nav-link text-nowrap" id="eventDocumentsTab" role="tab" dmx-bind:href="'/workflows/view?id=' + query.id + '&section=documents'" dmx-class:active="query.section == 'documents'" dmx-bind:aria-selected="(query.section == 'documents').toString()" aria-controls="eventDocumentsSection"><i class="fas fa-file-alt me-2"></i>Documents <span class="badge rounded-pill bg-secondary ms-1" dmx-text="scDocuments.data.query.count()">0</span></a>
                <a class="nav-link text-nowrap" id="eventCommercialTab" role="tab" dmx-bind:href="'/workflows/view?id=' + query.id + '&section=commercial'" dmx-class:active="query.section == 'commercial'" dmx-bind:aria-selected="(query.section == 'commercial').toString()" aria-controls="eventCommercialSection" dmx-show="scTenantModules.data.commercialAccess[0].hasAccess == 1"><i class="fas fa-tags me-2"></i><span dmx-text="scTerminology.data.query[0].commercialSingular">Commercial Details</span></a>
            </div>
        </nav>
    </div>

    <div class="col-12" id="eventInfoSummary" role="tabpanel" aria-labelledby="eventInfoTab" dmx-show="!query.section || query.section == 'info'"><div class="row g-3">
        <div class="col-sm-6 col-xl-3"><div class="p-3 bg-white border rounded shadow-sm"><div class="small text-muted mb-2">Status</div><form id="frmEventStatus" is="dmx-serverconnect-form" method="post" action="/api/workflows/update_event_status" dmx-on:success="scWorkflow.load(); scWorkflowConcurrency.load()"><%- _csrfInput() %><input type="hidden" name="workflowId" dmx-bind:value="query.id"><input type="hidden" name="rowVersion" dmx-bind:value="scWorkflowConcurrency.data.record[0].rowVersion"><select class="form-select form-select-sm" name="eventStatusId" required dmx-bind:options="scEventStatuses.data.query" optiontext="statusName" optionvalue="id" dmx-bind:value="scWorkflow.data.query[0].eventStatusId" dmx-on:changed="frmEventStatus.submit()"><option value="">Select status</option></select><div class="small text-danger mt-1" dmx-show="frmEventStatus.lastError" dmx-text="frmEventStatus.lastError.response.message.default('Status could not be changed.')"></div></form></div></div>
        <div class="col-sm-6 col-xl-3"><div class="p-3 bg-white border rounded shadow-sm"><div class="small text-muted mb-2">Current milestone</div><form id="frmCurrentMilestone" is="dmx-serverconnect-form" method="post" action="/api/workflows/update_current_milestone" dmx-on:success="scCurrentMilestone.load(); scWorkflowConcurrency.load()"><%- _csrfInput() %><input type="hidden" name="workflowId" dmx-bind:value="query.id"><input type="hidden" name="rowVersion" dmx-bind:value="scWorkflowConcurrency.data.record[0].rowVersion"><select class="form-select form-select-sm" name="currentMilestoneId" required dmx-bind:options="scMilestoneOptions.data.query" optiontext="milestoneName" optionvalue="id" dmx-bind:value="scCurrentMilestone.data.query[0].currentMilestoneId" dmx-on:changed="frmCurrentMilestone.submit()"><option value="">Select milestone</option></select><div class="small text-danger mt-1" dmx-show="frmCurrentMilestone.lastError" dmx-text="frmCurrentMilestone.lastError.response.message.default('Milestone could not be changed.')"></div></form></div></div>
        <div class="col-sm-6 col-xl-3"><div class="p-3 bg-white border rounded shadow-sm"><div class="small text-muted">Owner team</div><div class="fw-semibold" dmx-text="scWorkflow.data.query[0].teamName"></div></div></div>
        <div class="col-sm-6 col-xl-3"><div class="p-3 bg-white border rounded shadow-sm"><div class="small text-muted">Start date</div><div class="fw-semibold" dmx-text="scWorkflow.data.query[0].startDate.formatDate('dd MMM yyyy')"></div></div></div>
        <div class="col-12"><div class="p-3 bg-white border rounded shadow-sm"><div class="d-flex justify-content-between align-items-start gap-3"><div><div class="small text-muted" dmx-text="scTerminology.data.query[0].locationSingular">Location</div><div class="fw-semibold"><i class="fas fa-map-marker-alt text-primary me-2"></i><span dmx-text="scWorkflow.data.query[0].effectiveLocation"></span></div><div class="small text-muted ms-4" dmx-show="scWorkflow.data.query[0].townCity || scWorkflow.data.query[0].postcode"><span dmx-text="scWorkflow.data.query[0].townCity"></span><span dmx-show="scWorkflow.data.query[0].townCity && scWorkflow.data.query[0].postcode">, </span><span dmx-text="scWorkflow.data.query[0].postcode"></span></div><div class="small text-warning ms-4" dmx-show="scWorkflow.data.query[0].locationIsActive == 0 || scWorkflow.data.query[0].spaceIsActive == 0 || scWorkflow.data.query[0].configurationIsActive == 0" dmx-text="'This ' + scTerminology.data.query[0].workflowSingular.lowercase() + ' uses an inactive ' + scTerminology.data.query[0].locationSingular.lowercase() + ' record.'">This event uses an inactive location record.</div></div><button class="btn btn-sm btn-outline-primary" type="button" data-bs-toggle="collapse" data-bs-target="#editEventLocation">Change</button></div><div class="collapse mt-3" id="editEventLocation"><div class="alert alert-warning" dmx-show="frmEventLocation.lastError && frmEventLocation.lastError.status == 409"><strong>Location not saved.</strong> This event changed after the page loaded. Refresh the page and review the latest details.</div><form id="frmEventLocation" is="dmx-serverconnect-form" method="post" action="/api/workflows/update_location" class="row g-3" dmx-on:success="scWorkflow.load(); scWorkflowConcurrency.load()"><%- _csrfInput() %><input type="hidden" name="workflowId" dmx-bind:value="query.id"><input type="hidden" name="rowVersion" dmx-bind:value="scWorkflowConcurrency.data.record[0].rowVersion"><div class="col-md-4"><label class="form-label" for="eventLocationId" dmx-text="scTerminology.data.query[0].locationSingular">Location</label><select class="form-select" id="eventLocationId" name="locationId" dmx-bind:options="scLocations.data.query" optiontext="locationLabel" optionvalue="id" dmx-bind:value="scWorkflow.data.query[0].locationId" dmx-on:changed="eventSpaceId.setValue(''); eventConfigurationId.setValue(''); scSpaces.load(); scConfigurations.load()"><option value="">No location selected</option></select></div><div class="col-md-4"><label class="form-label" for="eventSpaceId" dmx-text="scTerminology.data.query[0].spaceSingular">Space</label><select class="form-select" id="eventSpaceId" name="spaceId" dmx-bind:options="scSpaces.data.query" optiontext="spaceLabel" optionvalue="id" dmx-bind:value="scWorkflow.data.query[0].spaceId" dmx-bind:disabled="!eventLocationId.value" dmx-on:changed="eventConfigurationId.setValue(''); scConfigurations.load()"><option value="">No space selected</option></select></div><div class="col-md-4"><label class="form-label" for="eventConfigurationId" dmx-text="scTerminology.data.query[0].configurationSingular">Configuration</label><select class="form-select" id="eventConfigurationId" name="configurationId" dmx-bind:options="scConfigurations.data.query" optiontext="configurationLabel" optionvalue="id" dmx-bind:value="scWorkflow.data.query[0].configurationId" dmx-bind:disabled="!eventSpaceId.value"><option value="">No configuration selected</option></select></div><div class="col-12"><button class="btn btn-primary btn-sm" type="submit">Save location</button></div></form></div></div></div>
        <div class="col-12"><div class="p-3 bg-white border rounded shadow-sm"><div class="small text-muted mb-1">Notes</div><div style="white-space: pre-wrap;" dmx-text="scWorkflow.data.query[0].notes || 'No notes have been added.'"></div></div></div>
    </div></div>

    <div class="col-12" dmx-show="!query.section || query.section == 'info'"><div class="row g-3"><div class="col-md-6"><div class="p-3 bg-white border rounded shadow-sm h-100"><div class="small text-muted" dmx-text="scTerminology.data.query[0].spaceSingular">Space</div><div class="fw-semibold" dmx-text="scWorkflow.data.query[0].spaceName || 'Not selected'"></div><div class="small text-muted" dmx-show="!scWorkflow.data.query[0].spaceId">Use Change in the Location panel to select a space.</div></div></div><div class="col-md-6"><div class="p-3 bg-white border rounded shadow-sm h-100"><div class="small text-muted" dmx-text="scTerminology.data.query[0].configurationSingular">Configuration</div><div class="fw-semibold" dmx-text="scWorkflow.data.query[0].configurationName || 'Not selected'"></div><div class="small text-muted" dmx-show="!scWorkflow.data.query[0].configurationId">Select a space first, then choose its configuration.</div></div></div></div></div>

    <div class="col-12" id="eventContactsSection" role="tabpanel" aria-labelledby="eventContactsTab" dmx-show="query.section == 'contacts'">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2 py-3">
                <div><h2 class="h4 mb-1">Contacts</h2><p class="text-muted small mb-0" dmx-text="'People and organisations connected to this ' + scTerminology.data.query[0].workflowSingular.lowercase() + '.'">People and organisations connected to this workflow.</p></div>
                <span class="badge rounded-pill bg-primary" dmx-text="scWorkflowContacts.data.query.count() + (scWorkflowContacts.data.query.count() == 1 ? ' contact' : ' contacts')"></span>
            </div>
            <div class="card-body">
                <form method="post" action="/api/workflows/add_contact" class="row g-3 align-items-end"><%- _csrfInput() %>
                    <input type="hidden" name="workflowId" dmx-bind:value="query.id">
                    <div class="col-12 col-lg-4"><label class="form-label" for="workflowContactId">Contact</label><select class="form-select" id="workflowContactId" name="contactId" required dmx-bind:options="scContactOptions.data.query" optiontext="contactLabel" optionvalue="id"><option value="">Select contact</option></select></div>
                    <div class="col-12 col-md-6 col-lg-3"><label class="form-label" for="relationshipType">Relationship</label><input class="form-control" id="relationshipType" name="relationshipType" list="contactRelationships" placeholder="e.g. Venue contact" required><datalist id="contactRelationships"><option value="Primary contact"></option><option value="Venue contact"></option><option value="Producer"></option><option value="Supplier"></option><option value="Finance contact"></option><option value="Technical contact"></option></datalist></div>
                    <div class="col-12 col-md-6 col-lg-3"><label class="form-label" for="contactNotes">Notes</label><input class="form-control" id="contactNotes" name="notes" placeholder="Optional context"></div>
                    <div class="col-6 col-lg-1"><div class="form-check mb-2"><input class="form-check-input" id="isPrimaryContact" name="isPrimary" type="checkbox" value="1"><label class="form-check-label" for="isPrimaryContact">Primary</label></div></div>
                    <div class="col-6 col-lg-1 d-grid"><button class="btn btn-primary" type="submit" title="Add contact"><i class="fas fa-plus"></i><span class="visually-hidden">Add contact</span></button></div>
                </form>
                <div class="d-flex justify-content-end mt-2"><a class="small" href="/contacts/create">Create a new contact</a></div>

                <div class="table-responsive mt-4" dmx-show="scWorkflowContacts.data.query.count() > 0"><table class="table table-hover align-middle mb-0"><thead class="table-light"><tr><th>Contact</th><th>Relationship</th><th>Category</th><th>Contact details</th><th>Notes</th><th></th></tr></thead><tbody is="dmx-repeat" dmx-bind:repeat="scWorkflowContacts.data.query"><tr><td><div class="fw-semibold" dmx-text="$value.contactName"></div><div class="small text-muted" dmx-text="$value.organisationName"></div><span class="badge bg-primary mt-1" dmx-show="$value.isPrimary == 1">Primary</span></td><td dmx-text="$value.relationshipType"></td><td dmx-text="$value.categoryName || 'Uncategorised'"></td><td><div dmx-show="$value.email"><i class="fas fa-envelope text-muted me-1"></i><a dmx-bind:href="'mailto:' + $value.email" dmx-text="$value.email"></a></div><div dmx-show="$value.phone"><i class="fas fa-phone text-muted me-1"></i><a dmx-bind:href="'tel:' + $value.phone" dmx-text="$value.phone"></a></div></td><td dmx-text="$value.notes"></td><td class="text-end"><form method="post" action="/api/workflows/remove_contact"><%- _csrfInput() %><input type="hidden" name="id" dmx-bind:value="$value.id"><input type="hidden" name="workflowId" dmx-bind:value="$value.workflowId"><button class="btn btn-sm btn-outline-danger" type="submit" title="Remove from this workflow"><i class="fas fa-unlink"></i><span class="visually-hidden">Remove contact</span></button></form></td></tr></tbody></table></div>
                <div class="text-center text-muted py-4" dmx-show="!scWorkflowContacts.state.executing && scWorkflowContacts.data.query.count() == 0">No contacts have been linked yet.</div>
            </div>
        </div>
    </div>

    <div class="col-12" id="eventDocumentsSection" role="tabpanel" aria-labelledby="eventDocumentsTab" dmx-show="query.section == 'documents'">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2 py-3">
                <div><h2 class="h4 mb-1">Documents</h2><p class="text-muted small mb-0" dmx-text="'Contracts, technical riders, sales reports, invoices and settlement files for this ' + scTerminology.data.query[0].workflowSingular.lowercase() + '.'">Contracts, technical riders, sales reports, invoices and settlement files for this event.</p></div>
                <div class="d-flex flex-wrap align-items-center gap-2"><span class="badge rounded-pill bg-primary" dmx-text="scDocuments.data.query.count() + (scDocuments.data.query.count() == 1 ? ' document' : ' documents')"></span><button class="btn btn-sm btn-outline-secondary" type="button" data-bs-toggle="modal" data-bs-target="#eventContractDetailsModal" dmx-show="scTenantModules.data.contractAccess[0].hasAccess == 1"><i class="fas fa-address-card me-2"></i>Contract parties</button><button class="btn btn-sm btn-outline-primary" type="button" data-bs-toggle="modal" data-bs-target="#uploadEventDocumentModal"><i class="fas fa-upload me-2"></i>Upload document</button><button class="btn btn-sm btn-primary" type="button" data-bs-toggle="modal" data-bs-target="#generateEventContractModal" dmx-show="scTenantModules.data.contractAccess[0].hasAccess == 1"><i class="fas fa-file-signature me-2"></i>Generate contract</button></div>
            </div>
            <div class="card-body">
                <div class="table-responsive" dmx-show="scDocuments.data.query.count() > 0">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light"><tr><th>Document</th><th>Type</th><th>Status</th><th>File</th><th>Uploaded</th><th class="text-end">Actions</th></tr></thead>
                        <tbody is="dmx-repeat" dmx-bind:repeat="scDocuments.data.query">
                            <tr>
                                <td><div class="fw-semibold" dmx-text="$value.documentName"></div><div class="small text-muted" dmx-text="$value.notes"></div><div class="small text-muted" dmx-text="$value.sourceType == 'generated_contract' && $value.status == 'draft' ? 'Next issued version ' + ($value.versionNumber + 1) : 'Version ' + $value.versionNumber"></div></td>
                                <td><span class="badge bg-light text-dark border" dmx-text="$value.documentType || 'Other'"></span></td>
                                <td><span class="badge text-capitalize" dmx-class:bg-warning="$value.status == 'draft'" dmx-class:text-dark="$value.status == 'draft' || $value.status == 'active'" dmx-class:bg-success="$value.status == 'issued'" dmx-class:bg-primary="$value.status == 'sent'" dmx-class:bg-light="$value.status == 'active'" dmx-class:border="$value.status == 'active'" dmx-class:bg-secondary="$value.status != 'draft' && $value.status != 'issued' && $value.status != 'sent' && $value.status != 'active'" dmx-text="$value.status == 'active' ? 'Available' : $value.status.replace('_', ' ')"></span></td>
                                <td><div dmx-text="$value.originalFileName"></div><div class="small text-muted" dmx-text="$value.fileSizeBytes + ' bytes'"></div></td>
                                <td><div dmx-text="$value.createdDate.formatDate('dd MMM yyyy')"></div><div class="small text-muted" dmx-text="$value.uploadedBy || 'Unknown user'"></div></td>
                                <td class="text-end"><div class="d-inline-flex gap-2"><a class="btn btn-sm btn-outline-primary" dmx-show="$value.sourceType == 'upload'" dmx-bind:href="'/api/workflows/download_document?id=' + $value.id" title="Download"><i class="fas fa-download"></i><span class="visually-hidden">Download</span></a><a class="btn btn-sm btn-outline-primary" dmx-show="$value.sourceType == 'generated_contract'" dmx-bind:href="'/contracts/generated?id=' + $value.id" title="Open generated contract"><i class="fas fa-eye"></i><span class="visually-hidden">Open generated contract</span></a><form method="post" action="/api/workflows/archive_document" dmx-show="$value.sourceType == 'upload'"><%- _csrfInput() %><input type="hidden" name="id" dmx-bind:value="$value.id"><input type="hidden" name="workflowId" dmx-bind:value="$value.workflowId"><button class="btn btn-sm btn-outline-danger" type="submit" title="Archive document"><i class="fas fa-archive"></i><span class="visually-hidden">Archive document</span></button></form><form method="post" action="/api/contracts/archive" dmx-show="$value.sourceType == 'generated_contract'"><%- _csrfInput() %><input type="hidden" name="id" dmx-bind:value="$value.id"><input type="hidden" name="workflowId" dmx-bind:value="$value.workflowId"><button class="btn btn-sm btn-outline-danger" type="submit" title="Archive contract"><i class="fas fa-archive"></i><span class="visually-hidden">Archive contract</span></button></form></div></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <div class="text-center text-muted py-5" dmx-show="!scDocuments.state.executing && scDocuments.data.query.count() == 0"><i class="fas fa-folder-open fa-2x mb-3"></i><h3 class="h6">No documents have been added yet</h3><p class="small mb-0">Use <strong>Upload document</strong> or <strong>Generate contract</strong> to add the first item.</p></div>
            </div>
        </div>

        <div class="modal fade" id="eventContractDetailsModal" tabindex="-1" aria-labelledby="eventContractDetailsModalLabel" aria-hidden="true" dmx-show="scTenantModules.data.contractAccess[0].hasAccess == 1">
            <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
                <div class="modal-content">
                    <form method="post" action="/api/contracts/saveEventContractDetails"><%- _csrfInput() %>
                        <input type="hidden" name="workflowId" dmx-bind:value="query.id">
                        <div class="modal-header"><div><h2 class="modal-title h5 mb-1" id="eventContractDetailsModalLabel">Contract parties</h2><p class="small text-muted mb-0">Choose existing contacts for the roles used in this event’s contracts.</p></div><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div>
                        <div class="modal-body">
                            <div class="alert alert-light border d-flex justify-content-between align-items-center gap-3"><span class="small">Missing somebody? Add them to the reusable contact directory first.</span><a class="btn btn-sm btn-outline-primary" href="/contacts/create">Add contact</a></div>
                            <div class="row g-3">
                                <div class="col-12 col-md-6"><label class="form-label" for="contractPartyContactId">Legal contract party</label><select class="form-select" id="contractPartyContactId" name="contractPartyContactId" dmx-bind:options="scContactOptions.data.query" optiontext="contactLabel" optionvalue="id" dmx-bind:value="scEventContractDetails.data.details[0].contractPartyContactId"><option value="">Not selected</option></select><div class="form-text">The person or organisation entering the agreement with your contracting entity.</div></div>
                                <div class="col-12 col-md-6"><label class="form-label" for="artistContactId">Artist or performing company</label><select class="form-select" id="artistContactId" name="artistContactId" dmx-bind:options="scContactOptions.data.query" optiontext="contactLabel" optionvalue="id" dmx-bind:value="scEventContractDetails.data.details[0].artistContactId"><option value="">Not selected</option></select></div>
                                <div class="col-12 col-md-6"><label class="form-label" for="managerContactId">Artist manager</label><select class="form-select" id="managerContactId" name="managerContactId" dmx-bind:options="scContactOptions.data.query" optiontext="contactLabel" optionvalue="id" dmx-bind:value="scEventContractDetails.data.details[0].managerContactId"><option value="">Not selected</option></select></div>
                                <div class="col-12 col-md-6"><label class="form-label" for="promoterContactId">Promoter</label><select class="form-select" id="promoterContactId" name="promoterContactId" dmx-bind:options="scContactOptions.data.query" optiontext="contactLabel" optionvalue="id" dmx-bind:value="scEventContractDetails.data.details[0].promoterContactId"><option value="">Not selected</option></select></div>
                                <div class="col-12 col-md-6"><label class="form-label" for="agentContactId">Agent</label><select class="form-select" id="agentContactId" name="agentContactId" dmx-bind:options="scContactOptions.data.query" optiontext="contactLabel" optionvalue="id" dmx-bind:value="scEventContractDetails.data.details[0].agentContactId"><option value="">Not selected</option></select></div>
                                <div class="col-12 col-md-6"><label class="form-label" for="signatoryContactId">Authorised signatory</label><select class="form-select" id="signatoryContactId" name="signatoryContactId" dmx-bind:options="scContactOptions.data.query" optiontext="contactLabel" optionvalue="id" dmx-bind:value="scEventContractDetails.data.details[0].signatoryContactId"><option value="">Not selected</option></select></div>
                                <div class="col-12 col-md-6"><label class="form-label" for="financeContactId">Finance or accounts contact</label><select class="form-select" id="financeContactId" name="financeContactId" dmx-bind:options="scContactOptions.data.query" optiontext="contactLabel" optionvalue="id" dmx-bind:value="scEventContractDetails.data.details[0].financeContactId"><option value="">Not selected</option></select></div>
                            </div>
                        </div>
                        <div class="modal-footer"><button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button><button class="btn btn-primary" type="submit">Save contract parties</button></div>
                    </form>
                </div>
            </div>
        </div>

        <div class="modal fade" id="uploadEventDocumentModal" tabindex="-1" aria-labelledby="uploadEventDocumentModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-lg modal-dialog-centered">
                <div class="modal-content">
                    <form method="post" action="/api/workflows/upload_document" enctype="multipart/form-data"><%- _csrfInput() %>
                        <input type="hidden" name="workflowId" dmx-bind:value="query.id">
                        <div class="modal-header"><div><h2 class="modal-title h5 mb-1" id="uploadEventDocumentModalLabel">Upload supporting document</h2><p class="small text-muted mb-0">PDF, Word, Excel, JPG or PNG, up to 10 MB.</p></div><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div>
                        <div class="modal-body"><div class="row g-3">
                            <div class="col-12 col-md-7"><label class="form-label" for="documentName">Document name</label><input class="form-control" id="documentName" name="documentName" maxlength="180" placeholder="e.g. Technical rider" required></div>
                            <div class="col-12 col-md-5"><label class="form-label" for="documentType">Document type</label><select class="form-select" id="documentType" name="documentType"><option value="">Other supporting document</option><option value="Contract">Externally supplied contract</option><option value="Technical rider">Technical rider</option><option value="Ticket sales">Ticket sales</option><option value="Invoice">Invoice</option><option value="Settlement">Settlement</option><option value="Marketing">Marketing</option></select></div>
                            <div class="col-12"><label class="form-label" for="documentFile">Choose file</label><input class="form-control" id="documentFile" name="documentFile" type="file" accept=".pdf,.doc,.docx,.xls,.xlsx,.jpg,.jpeg,.png" required></div>
                            <div class="col-12"><label class="form-label" for="documentNotes">Notes</label><textarea class="form-control" id="documentNotes" name="notes" rows="3" maxlength="65535" placeholder="Optional"></textarea></div>
                        </div></div>
                        <div class="modal-footer"><button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button><button class="btn btn-primary" type="submit"><i class="fas fa-upload me-2"></i>Upload document</button></div>
                    </form>
                </div>
            </div>
        </div>

        <div class="modal fade" id="generateEventContractModal" tabindex="-1" aria-labelledby="generateEventContractModalLabel" aria-hidden="true" dmx-show="scTenantModules.data.contractAccess[0].hasAccess == 1">
            <div class="modal-dialog modal-lg modal-dialog-centered">
                <div class="modal-content">
                    <form method="post" action="/api/contracts/generate"><%- _csrfInput() %>
                        <input type="hidden" name="workflowId" dmx-bind:value="query.id">
                        <div class="modal-header"><div><h2 class="modal-title h5 mb-1" id="generateEventContractModalLabel">Generate contract</h2><p class="small text-muted mb-0">Create a new editable draft using an approved contract template.</p></div><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div>
                        <div class="modal-body"><div class="row g-3">
                            <div class="col-12"><label class="form-label" for="eventContractTemplate">Template</label><select class="form-select" id="eventContractTemplate" name="templateId" required dmx-bind:options="scContractOptions.data.templates" optiontext="templateName" optionvalue="id"><option value="">Select template</option></select></div>
                            <div class="col-12"><label class="form-label" for="eventContractName">Contract name</label><input class="form-control" id="eventContractName" name="contractName" required dmx-bind:value="scWorkflow.data.query[0].workflowName + ' Contract'"></div>
                            <div class="col-12"><div class="alert alert-warning mb-0" dmx-show="scContractOptions.data.templates.count() == 0">No active templates exist. An owner or admin must create one under Setup → Contract Templates.</div></div>
                        </div></div>
                        <div class="modal-footer"><button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button><button class="btn btn-primary" type="submit" dmx-bind:disabled="scContractOptions.data.templates.count() == 0"><i class="fas fa-magic me-2"></i>Generate draft</button></div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <div class="col-12" id="eventCommercialSection" role="tabpanel" aria-labelledby="eventCommercialTab" dmx-show="query.section == 'commercial' && scTenantModules.data.commercialAccess[0].hasAccess == 1">
        <div class="d-flex justify-content-between align-items-start gap-3 mb-3"><div><h2 class="h4 mb-1" dmx-text="scTerminology.data.query[0].commercialSingular">Commercial Details</h2><p class="small text-muted mb-0" dmx-text="'Record ' + scTerminology.data.query[0].commercialPlural.lowercase() + ' for this ' + scTerminology.data.query[0].workflowSingular.lowercase() + '. This does not create invoices or take payments.'">Record commercial details for this event. This does not create invoices or take payments.</p></div></div>
        <div class="row g-4">
            <div class="col-12 col-xl-7">
                <div class="card border-0 shadow-sm h-100"><div class="card-header bg-white"><h3 class="h5 mb-0">General details</h3></div><div class="card-body">
                    <form id="frmCommercialDetails" is="dmx-serverconnect-form" method="post" action="/api/commercial/saveDetails" class="row g-3" dmx-on:success="reset();scCommercial.load()"><%- _csrfInput() %>
                        <input type="hidden" name="workflowId" dmx-bind:value="query.id">
                        <div class="col-12"><div class="alert alert-success py-2 mb-0" dmx-show="frmCommercialDetails.data.success == true"><i class="fas fa-check-circle me-2"></i><span dmx-text="frmCommercialDetails.data.message">Commercial details saved.</span></div><div class="alert alert-danger py-2 mb-0" dmx-show="frmCommercialDetails.lastError && frmCommercialDetails.lastError.status"><i class="fas fa-exclamation-circle me-2"></i><span dmx-text="frmCommercialDetails.lastError.response.message.default('Commercial details could not be saved. Please check the entries and try again.')">Commercial details could not be saved.</span></div></div>
                        <div class="col-md-6"><label class="form-label" for="commercialOnSale" dmx-text="scTerminology.data.query[0].commercialDateLabel">Available From</label><input class="form-control" id="commercialOnSale" name="onSaleDateTime" type="datetime-local" dmx-bind:value="scCommercial.data.details[0].onSaleDateTime ? scCommercial.data.details[0].onSaleDateTime.formatDate('yyyy-MM-dd HH:mm').replace(' ','T') : ''" dmx-bind:disabled="scCommercial.data.access[0].canManage != 1"></div>
                        <div class="col-md-3"><label class="form-label" for="commercialCurrency">Currency</label><input class="form-control text-uppercase" id="commercialCurrency" name="currencyCode" maxlength="3" required dmx-bind:value="scCommercial.data.details[0].currencyCode.default('GBP')" dmx-bind:disabled="scCommercial.data.access[0].canManage != 1"></div>
                        <div class="col-md-3"><label class="form-label" for="commercialCapacity" dmx-text="scTerminology.data.query[0].commercialCapacityLabel">Capacity / Quantity</label><input class="form-control" id="commercialCapacity" name="capacity" type="number" min="0" dmx-bind:value="scCommercial.data.details[0].capacity" dmx-bind:disabled="scCommercial.data.access[0].canManage != 1"></div>
                        <div class="col-md-6"><label class="form-label" for="commercialTarget" dmx-text="scTerminology.data.query[0].commercialTargetLabel">Sales / Income Target</label><input class="form-control" id="commercialTarget" name="salesTarget" type="number" min="0" step="0.01" dmx-bind:value="scCommercial.data.details[0].salesTarget" dmx-bind:disabled="scCommercial.data.access[0].canManage != 1"></div>
                        <div class="col-12"><label class="form-label" for="commercialTaxNotes" dmx-text="scTerminology.data.query[0].commercialTaxLabel">Tax / Charging Notes</label><input class="form-control" id="commercialTaxNotes" name="taxNotes" maxlength="500" dmx-bind:value="scCommercial.data.details[0].taxNotes" dmx-bind:disabled="scCommercial.data.access[0].canManage != 1"></div>
                        <div class="col-12"><label class="form-label" for="commercialNotes" dmx-text="scTerminology.data.query[0].commercialSingular + ' Notes'">Commercial Notes</label><textarea class="form-control" id="commercialNotes" name="notes" rows="4" dmx-bind:value="scCommercial.data.details[0].notes" dmx-bind:disabled="scCommercial.data.access[0].canManage != 1"></textarea></div>
                    </form>
                </div></div>
            </div>
            <div class="col-12 col-xl-5">
                <div class="card border-0 shadow-sm"><div class="card-header bg-white"><h3 class="h5 mb-0" dmx-text="scTerminology.data.query[0].commercialPricePlural">Prices / Values</h3></div><div class="card-body">
                    <div class="table-responsive mb-3" dmx-show="scCommercial.data.prices.count() > 0"><table class="table table-sm align-middle mb-0"><thead><tr><th>Description</th><th class="text-end">Value</th><th></th></tr></thead><tbody is="dmx-repeat" dmx-bind:repeat="scCommercial.data.prices"><tr><td><div class="fw-semibold" dmx-text="$value.priceLabel"></div><div class="small text-muted" dmx-text="$value.eligibility"></div></td><td class="text-end text-nowrap"><span dmx-show="$value.amount != null && $value.calculationType == 'percentage_discount'"><span dmx-text="$value.amount"></span>%</span><span dmx-show="$value.amount != null && $value.calculationType != 'percentage_discount'"><span dmx-text="scCommercial.data.details[0].currencyCode.default('GBP')"></span> <span dmx-text="$value.amount"></span></span><span class="text-capitalize" dmx-show="$value.amount == null" dmx-text="$value.calculationType.replace('_',' ')"></span></td><td class="text-end"><form is="dmx-serverconnect-form" method="post" action="/api/commercial/removePrice" dmx-show="scCommercial.data.access[0].canManage == 1" dmx-on:success="scCommercial.load()"><%- _csrfInput() %><input type="hidden" name="id" dmx-bind:value="$value.id"><input type="hidden" name="workflowId" dmx-bind:value="query.id"><button class="btn btn-sm btn-outline-danger" type="submit" title="Remove price"><i class="fas fa-times"></i></button></form></td></tr></tbody></table></div>
                    <p class="text-muted small" dmx-show="!scCommercial.state.executing && scCommercial.data.prices.count() == 0" dmx-text="'No ' + scTerminology.data.query[0].commercialPricePlural.lowercase() + ' have been added.'">No prices or values have been added.</p>
                    <div class="row g-2 border-top pt-3" dmx-show="scCommercial.data.access[0].canManage == 1">
                        <div class="col-12"><label class="form-label" for="commercialPriceLabel"><span dmx-text="scTerminology.data.query[0].commercialPriceSingular + ' Description'">Price / Value Description</span> <span class="text-muted fw-normal">(optional)</span></label><input class="form-control" id="commercialPriceLabel" name="priceLabel" form="frmCommercialDetails" maxlength="160" dmx-bind:placeholder="'Standard ' + scTerminology.data.query[0].commercialPriceSingular.lowercase()"></div>
                        <div class="col-md-6"><label class="form-label" for="commercialPriceType">Type</label><select class="form-select" id="commercialPriceType" name="calculationType" form="frmCommercialDetails"><option value="fixed_amount">Fixed amount</option><option value="percentage_discount">Percentage discount</option><option value="fixed_discount">Fixed discount</option><option value="free">Free</option><option value="informational">Information only</option></select></div>
                        <div class="col-md-6"><label class="form-label" for="commercialPriceAmount">Amount / percentage</label><input class="form-control" id="commercialPriceAmount" name="amount" form="frmCommercialDetails" type="number" min="0" step="0.01" dmx-bind:disabled="commercialPriceType.value == 'free' || commercialPriceType.value == 'informational'"></div>
                        <div class="col-12"><label class="form-label" for="commercialEligibility"><span dmx-text="scTerminology.data.query[0].commercialEligibilityLabel">Eligibility</span> <span class="text-muted fw-normal">(optional)</span></label><input class="form-control" id="commercialEligibility" name="eligibility" form="frmCommercialDetails" maxlength="255"></div>
                    </div>
                </div></div>
            </div>
            <div class="col-12 text-end" dmx-show="scCommercial.data.access[0].canManage == 1"><button class="btn btn-primary" type="submit" form="frmCommercialDetails"><i class="fas fa-save me-2"></i>Save commercial details</button></div>
        </div>
    </div>

    <div class="col-12" id="eventInfoWorkflow" role="tabpanel" aria-labelledby="eventTasksTab" dmx-show="query.section == 'tasks'">
        <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2 mb-3"><div><h2 class="h4 mb-1">Phases and tasks</h2><p class="text-muted small mb-0" dmx-text="'This ' + scTerminology.data.query[0].workflowSingular.lowercase() + ' is divided into phases. Each phase contains its own ' + scTerminology.data.query[0].taskPlural.lowercase() + '.'">This event is divided into phases. Each phase contains its own tasks.</p></div><div class="d-flex gap-2 align-items-center"><span class="badge rounded-pill bg-primary" dmx-text="scStages.data.query.count() + (scStages.data.query.count() == 1 ? ' phase' : ' phases')"></span><button class="btn btn-sm btn-primary" type="button" data-bs-toggle="collapse" data-bs-target="#addOneOffTask" aria-expanded="false" aria-controls="addOneOffTask"><i class="fas fa-plus me-1"></i><span dmx-text="'Add ' + scTerminology.data.query[0].taskSingular.lowercase()">Add task</span></button></div></div>

        <div class="collapse mb-4" id="addOneOffTask">
            <div class="card border-primary shadow-sm">
                <div class="card-header bg-white"><h3 class="h5 mb-1" dmx-text="'Add a one-off ' + scTerminology.data.query[0].taskSingular.lowercase()">Add a one-off task</h3><p class="small text-muted mb-0" dmx-text="'This only affects this ' + scTerminology.data.query[0].workflowSingular.lowercase() + '; the template will not be changed.'">This only affects this event; the template will not be changed.</p></div>
                <div class="card-body">
                    <form method="post" action="/api/workflows/create_task" class="row g-3"><%- _csrfInput() %>
                        <input type="hidden" name="workflowId" dmx-bind:value="query.id">
                        <div class="col-12 col-lg-6"><label class="form-label" for="oneOffTaskName" dmx-text="scTerminology.data.query[0].taskSingular + ' name'">Task name</label><input class="form-control" id="oneOffTaskName" name="taskName" required maxlength="255"></div>
                        <div class="col-12 col-lg-6"><label class="form-label" for="oneOffStage" dmx-text="scTerminology.data.query[0].stageSingular">Stage</label><select class="form-select" id="oneOffStage" name="workflowStageId" required dmx-bind:options="scStages.data.query" optiontext="stageName" optionvalue="id"><option value="">Select stage</option></select></div>
                        <div class="col-12"><label class="form-label" for="oneOffDescription">Description</label><textarea class="form-control" id="oneOffDescription" name="description" rows="2"></textarea></div>
                        <div class="col-12 col-md-4"><label class="form-label" for="oneOffAssignment">Team</label><select class="form-select" id="oneOffAssignment" name="assignment" dmx-bind:options="scTaskAssignees.data.query" optiontext="assignmentLabel" optionvalue="assignmentKey" dmx-on:changed="oneOffAssignedUser.setValue(''); scOneOffTeamMembers.load({teamid: value.split(':')[1]})"><option value="unassigned:">Unallocated</option></select></div>
                        <div class="col-12 col-md-4"><label class="form-label" for="oneOffAssignedUser">Named person <span class="text-muted fw-normal">(optional)</span></label><select class="form-select" id="oneOffAssignedUser" name="assignedUserId" dmx-bind:options="scOneOffTeamMembers.data.query" optiontext="memberName" optionvalue="userId" dmx-bind:disabled="oneOffAssignment.value.split(':')[0] != 'team'"><option value="">Team only</option></select><div class="form-text" dmx-show="oneOffAssignment.value.split(':')[0] == 'team' && !scOneOffTeamMembers.state.executing && scOneOffTeamMembers.data.query.count() == 0">This team has no active members. You can still allocate the task to the team.</div></div>
                        <div class="col-6 col-md-3"><label class="form-label" for="oneOffDueDate">Due date</label><input class="form-control" id="oneOffDueDate" name="dueDate" type="date"></div>
                        <div class="col-6 col-md-3"><label class="form-label" for="oneOffPriority">Priority</label><select class="form-select" id="oneOffPriority" name="priority"><option value="low">Low</option><option value="normal" selected>Normal</option><option value="high">High</option><option value="urgent">Urgent</option></select></div>
                        <div class="col-12 col-md-2 d-flex align-items-end"><div class="form-check mb-2"><input class="form-check-input" id="oneOffRequired" name="isRequired" type="checkbox" value="1"><label class="form-check-label" for="oneOffRequired">Required</label></div></div>
                        <div class="col-12 d-flex gap-2"><button class="btn btn-primary" type="submit"><i class="fas fa-plus me-2"></i><span dmx-text="'Add ' + scTerminology.data.query[0].taskSingular.lowercase()">Add task</span></button><button class="btn btn-light" type="button" data-bs-toggle="collapse" data-bs-target="#addOneOffTask">Cancel</button></div>
                    </form>
                </div>
            </div>
        </div>

        <div is="dmx-repeat" id="repWorkflowStages" dmx-bind:repeat="scStages.data.query">
            <div class="card shadow-sm mb-3 workflow-phase-card" dmx-bind:id="'workflowStageCard' + $value.id" dmx-bind:style.border-left="'6px solid ' + $value.colour">
                <div class="card-body">
                    <div class="row g-3 align-items-center">
                        <div class="col-auto"><span class="phase-number d-inline-flex align-items-center justify-content-center rounded-circle" dmx-bind:style.background-color="$value.colour" dmx-text="$index + 1">1</span></div>
                        <div class="col-12 col-md-3"><div class="small fw-bold text-uppercase text-muted" dmx-text="'Phase ' + ($index + 1)">Phase 1</div><div class="h5 mb-0" dmx-text="$value.stageName"></div><div class="small text-muted mt-1" dmx-text="$value.completedTaskCount + '/' + $value.taskCount + ' ' + scTerminology.data.query[0].taskPlural.lowercase() + ' complete'"></div></div>
                        <div class="col"><div class="small text-muted text-uppercase" dmx-text="'Next ' + scTerminology.data.query[0].taskSingular.lowercase()">Next task</div><div class="fw-semibold" dmx-show="$value.nextTaskId" dmx-text="$value.nextTaskName"></div><div class="text-muted" dmx-show="!$value.nextTaskId" dmx-text="'No open ' + scTerminology.data.query[0].taskPlural.lowercase()">No open tasks</div><div class="small text-muted" dmx-show="$value.nextTaskId"><span dmx-text="$value.nextAssignee"></span><span dmx-show="$value.nextDueDate"> &middot; Due </span><span dmx-text="$value.nextDueDate.formatDate('dd MMM yyyy')"></span></div></div>
                        <div class="col-auto"><span class="badge text-capitalize" dmx-class:bg-secondary="$value.status == 'not_started'" dmx-class:bg-primary="$value.status == 'in_progress'" dmx-class:bg-warning="$value.status == 'waiting'" dmx-class:text-dark="$value.status == 'waiting'" dmx-class:bg-success="$value.status == 'complete'" dmx-class:bg-danger="$value.status == 'overdue'" dmx-text="$value.status.replace('_',' ')"></span></div>
                        <div class="col-auto"><button class="btn btn-sm btn-outline-secondary" type="button" data-bs-toggle="collapse" dmx-bind:data-bs-target="'#workflowStageTasks' + $value.id" dmx-bind:aria-controls="'workflowStageTasks' + $value.id" aria-expanded="false" aria-label="Show all tasks"><span class="d-none d-md-inline me-2" dmx-text="'View ' + scTerminology.data.query[0].taskPlural.lowercase()">View tasks</span><i class="fas fa-chevron-down"></i></button></div>
                    </div>
                </div>

                <div class="collapse" dmx-bind:id="'workflowStageTasks' + $value.id">
                    <div class="border-top">
                        <div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead class="table-light"><tr><th dmx-text="scTerminology.data.query[0].taskSingular">Task</th><th>Assigned to</th><th>Due</th><th>Priority</th><th>Status</th><th></th></tr></thead>
                            <tbody is="dmx-repeat" dmx-bind:repeat="scTasks.data.query.where('workflowStageId',$value.id)">
                                <tr>
                                    <td><div class="fw-semibold" dmx-text="$value.taskName"></div><div class="small text-muted" dmx-text="$value.description"></div><div class="small text-danger mt-1" dmx-show="$value.startBlockerCount > 0"><i class="fas fa-lock me-1"></i><span dmx-text="'Blocked by: ' + $value.blockerNames"></span></div><div class="small text-warning mt-1" dmx-show="$value.startBlockerCount == 0 && $value.finishBlockerCount > 0"><i class="fas fa-link me-1"></i><span dmx-text="'Completion depends on: ' + $value.blockerNames"></span></div></td>
                                    <td dmx-text="$value.assignedUserName || $value.assignedTeamName || $value.assignedRoleName || 'Unassigned'"></td>
                                    <td dmx-text="$value.dueDate.formatDate('dd MMM yyyy')"></td>
                                    <td><span class="badge bg-light text-dark border text-capitalize" dmx-text="$value.priority"></span></td>
                                    <td><form class="d-flex gap-2" method="post" action="/api/workflows/update_task_status"><%- _csrfInput() %><input type="hidden" name="id" dmx-bind:value="$value.id"><input type="hidden" name="workflowId" dmx-bind:value="$value.workflowId"><select class="form-select form-select-sm" name="status" dmx-bind:value="$value.status"><option value="not_started">Not started</option><option value="in_progress" dmx-bind:disabled="$value.startBlockerCount > 0">In progress</option><option value="waiting" dmx-bind:disabled="$value.startBlockerCount > 0">Waiting</option><option value="complete" dmx-bind:disabled="$value.startBlockerCount > 0 || $value.finishBlockerCount > 0">Complete</option><option value="skipped">Skipped</option><option value="cancelled">Cancelled</option></select><button class="btn btn-sm btn-outline-primary" type="submit">Save</button></form></td>
                                    <td><a class="btn btn-sm btn-outline-secondary" dmx-bind:href="'/tasks/edit?id=' + $value.id"><i class="fas fa-pen"></i></a></td>
                                </tr>
                            </tbody>
                        </table></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="text-center text-muted py-5" dmx-show="!scStages.state.executing && scStages.data.query.count() == 0" dmx-text="'No ' + scTerminology.data.query[0].stagePlural.lowercase() + ' exist for this ' + scTerminology.data.query[0].workflowSingular.lowercase() + '.'">No stages exist for this workflow.</div>
    </div>
    <div class="modal fade" id="sendEventNotificationModal" is="dmx-bs5-modal" tabindex="-1" aria-labelledby="sendEventNotificationModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content">
                <form is="dmx-serverconnect-form" method="post" action="/api/notifications/send" dmx-on:success="sendEventNotificationModal.hide();scHeaderNotifications.load()"><%- _csrfInput() %>
                    <input type="hidden" name="workflowId" dmx-bind:value="query.id">
                    <div class="modal-header"><div><h2 class="modal-title h5 mb-1" id="sendEventNotificationModalLabel">Notify people</h2><p class="small text-muted mb-0">Send a short in-app alert connected to this event or one of its tasks.</p></div><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div>
                    <div class="modal-body"><div class="row g-3">
                        <div class="col-12 col-md-6"><label class="form-label">Recipient</label><select class="form-select" name="recipientUserId" required dmx-bind:options="scNotificationRecipients.data.recipients" optiontext="recipientLabel" optionvalue="id"><option value="">Select a user</option></select></div>
                        <div class="col-12 col-md-6"><label class="form-label">Related task</label><select class="form-select" name="taskId" dmx-bind:options="scTasks.data.query" optiontext="taskName" optionvalue="id"><option value="">Whole event</option></select></div>
                        <div class="col-12"><label class="form-label">Subject</label><input class="form-control" name="title" maxlength="180" required dmx-bind:value="scWorkflow.data.query[0].workflowName"></div>
                        <div class="col-12"><label class="form-label">Message</label><textarea class="form-control" name="message" rows="4" required maxlength="2000" placeholder="What does this person need to know or do?"></textarea></div>
                    </div></div>
                    <div class="modal-footer"><button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button><button class="btn btn-primary" type="submit"><i class="fas fa-paper-plane me-2"></i>Send notification</button></div>
                </form>
            </div>
        </div>
    </div>
</div>
