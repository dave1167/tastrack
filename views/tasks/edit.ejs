<!-- Wappler include head-page="layouts/main_shell" fontawesome_5="cdn" bootstrap5="local" is="dmx-app" id="edit_task" appConnect="local" components="{dmxStateManagement:{},dmxBrowser:{}}" -->
<dmx-browser id="browserTaskEdit"></dmx-browser>
<dmx-serverconnect id="scTask" url="/api/tasks/get" dmx-param:id="query.id" dmx-on:success="scTeamMembers.load({teamid: scTask.data.query[0].assignedToTeamId})"></dmx-serverconnect>
<dmx-serverconnect id="scAssignees" url="/api/tasks/assignee_options"></dmx-serverconnect>
<dmx-serverconnect id="scTeamMembers" url="/api/tasks/team_member_options" dmx-param:teamid="taskAssignment.value.split(':')[1]"></dmx-serverconnect>
<dmx-serverconnect id="scLocations" url="/api/locations/options" dmx-param:selectedid="scTask.data.query[0].locationId"></dmx-serverconnect>
<dmx-serverconnect id="scSpaces" url="/api/locations/spaceOptions" dmx-param:locationid="taskLocationId.value" dmx-param:selectedid="scTask.data.query[0].spaceId"></dmx-serverconnect>
<dmx-serverconnect id="scConfigurations" url="/api/locations/configurationOptions" dmx-param:spaceid="taskSpaceId.value" dmx-param:selectedid="scTask.data.query[0].configurationId"></dmx-serverconnect>
<dmx-serverconnect id="scTaskNotificationRecipients" url="/api/notifications/recipients"></dmx-serverconnect>
<dmx-serverconnect id="scTaskAnswer" url="/api/task_answers/get" dmx-param:taskid="query.id"></dmx-serverconnect>

<div class="row g-4" id="taskEditLayout">
    <div class="col-12">
        <div class="d-flex justify-content-between align-items-center gap-3">
            <div><h1 class="mb-1">Edit Task</h1><p class="text-muted mb-0"><span dmx-text="scTask.data.query[0].workflowName"></span><span> &middot; </span><span dmx-text="scTask.data.query[0].stageName"></span></p></div>
            <div class="d-flex gap-2"><button class="btn btn-outline-primary" type="button" data-bs-toggle="modal" data-bs-target="#sendTaskNotificationModal"><i class="fas fa-bell me-2"></i>Notify people</button><a class="btn btn-outline-secondary" dmx-bind:href="query.source == 'workflow' ? '/workflows/view?id=' + scTask.data.query[0].workflowId + '&section=tasks' : '/tasks'">Back to tasks</a></div>
        </div>
    </div>
    <div class="col-12 col-xl-8">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white"><h2 class="h5 mb-0">Task details</h2></div>
            <div class="card-body">
                <div class="alert alert-warning" dmx-show="frmTaskEdit.lastError.status">
                    <div class="d-flex gap-2 align-items-start"><i class="fas fa-lock mt-1"></i><div><strong>Changes were not saved.</strong><div dmx-text="frmTaskEdit.lastError.response.message.default('You do not have permission to change this task.')"></div></div></div>
                    <button class="btn btn-sm btn-warning mt-3" type="button" dmx-show="frmTaskEdit.lastError.status == 409" onclick="window.location.reload()">Reload latest task</button>
                </div>
                <form id="frmTaskEdit" is="dmx-serverconnect-form" method="post" action="/api/tasks/update" dmx-on:success="browserTaskEdit.goto(query.source == 'workflow' ? '/workflows/view?id=' + scTask.data.query[0].workflowId + '&section=tasks&saved=1' : '/tasks?saved=1')">
                    <%- _csrfInput() %>
                    <input type="hidden" name="id" dmx-bind:value="scTask.data.query[0].id">
                    <input type="hidden" name="rowVersion" dmx-bind:value="scTask.data.query[0].rowVersion">
                    <input type="hidden" name="taskName" dmx-bind:value="scTask.data.query[0].taskName">
                    <div class="mb-3"><label class="form-label">Description</label><textarea class="form-control" name="description" rows="4" dmx-bind:value="scTask.data.query[0].description"></textarea></div>
                    <div class="row g-3">
                        <div class="col-md-6" dmx-show="scTaskAnswer.data.result.task.answerTypeSnapshot != 'task_status'"><label class="form-label">Status</label><select class="form-select" name="status" dmx-bind:value="scTask.data.query[0].status"><option value="not_started">Not started</option><option value="in_progress">In progress</option><option value="waiting">Waiting</option><option value="complete">Complete</option><option value="skipped">Skipped</option><option value="cancelled">Cancelled</option><option value="overdue">Overdue</option></select></div>
                        <div class="col-md-3"><label class="form-label">Priority</label><select class="form-select" name="priority" dmx-bind:value="scTask.data.query[0].priority"><option value="low">Low</option><option value="normal">Normal</option><option value="high">High</option><option value="urgent">Urgent</option></select></div>
                        <div class="col-md-3"><label class="form-label">Required</label><select class="form-select" name="isRequired" dmx-bind:value="scTask.data.query[0].isRequired"><option value="1">Yes</option><option value="0">No</option></select></div>
                        <div class="col-md-4"><label class="form-label" for="taskAssignment">Team</label><select class="form-select" id="taskAssignment" name="assignment" dmx-bind:options="scAssignees.data.query" optiontext="assignmentLabel" optionvalue="assignmentKey" dmx-bind:value="scTask.data.query[0].assignedToTeamId ? 'team:' + scTask.data.query[0].assignedToTeamId : 'unassigned:'" dmx-on:changed="taskAssignedUser.setValue(''); scTeamMembers.load({teamid: value.split(':')[1]})"></select></div>
                        <div class="col-md-4"><label class="form-label" for="taskAssignedUser">Named person <span class="text-muted fw-normal">(optional)</span></label><select class="form-select" id="taskAssignedUser" name="assignedUserId" dmx-bind:options="scTeamMembers.data.query" optiontext="memberName" optionvalue="userId" dmx-bind:value="scTask.data.query[0].assignedToUserId" dmx-bind:disabled="taskAssignment.value.split(':')[0] != 'team'"><option value="">Team only</option></select><div class="form-text" dmx-show="taskAssignment.value.split(':')[0] == 'team' && !scTeamMembers.state.executing && scTeamMembers.data.query.count() == 0">This team has no active members. You can still allocate the task to the team.</div></div>
                        <div class="col-md-4"><label class="form-label">Due date and time</label><input class="form-control" name="dueDate" type="datetime-local" dmx-bind:value="scTask.data.query[0].dueDate.formatDate('yyyy-MM-ddTHH:mm')"></div>
                    </div>
                    <div class="border-top mt-4 pt-3">
                        <h3 class="h6 mb-1">Task location</h3>
                        <p class="small text-muted mb-3">By default this task follows the event location. Choose an override only when this task happens somewhere else.</p>
                        <div class="row g-3">
                            <div class="col-md-4"><label class="form-label" for="taskLocationMode">Location setting</label><select class="form-select" id="taskLocationMode" name="locationMode" dmx-bind:value="scTask.data.query[0].locationMode"><option value="inherit">Use event location</option><option value="override">Use a different location</option></select></div>
                            <div class="col-md-8" dmx-show="taskLocationMode.value == 'inherit'"><label class="form-label">Effective location</label><div class="form-control bg-light"><i class="fas fa-map-marker-alt text-primary me-2"></i><span dmx-text="scTask.data.query[0].effectiveLocation"></span></div></div>
                        </div>
                        <div class="row g-3 mt-0" dmx-show="taskLocationMode.value == 'override'">
                            <div class="col-md-4"><label class="form-label" for="taskLocationId">Location</label><select class="form-select" id="taskLocationId" name="locationId" dmx-bind:options="scLocations.data.query" optiontext="locationLabel" optionvalue="id" dmx-bind:value="scTask.data.query[0].locationId" dmx-on:changed="taskSpaceId.setValue(''); taskConfigurationId.setValue(''); scSpaces.load(); scConfigurations.load()"><option value="">No location selected</option></select></div>
                            <div class="col-md-4"><label class="form-label" for="taskSpaceId">Space</label><select class="form-select" id="taskSpaceId" name="spaceId" dmx-bind:options="scSpaces.data.query" optiontext="spaceLabel" optionvalue="id" dmx-bind:value="scTask.data.query[0].spaceId" dmx-bind:disabled="!taskLocationId.value" dmx-on:changed="taskConfigurationId.setValue(''); scConfigurations.load()"><option value="">No space selected</option></select></div>
                            <div class="col-md-4"><label class="form-label" for="taskConfigurationId">Configuration</label><select class="form-select" id="taskConfigurationId" name="configurationId" dmx-bind:options="scConfigurations.data.query" optiontext="configurationLabel" optionvalue="id" dmx-bind:value="scTask.data.query[0].configurationId" dmx-bind:disabled="!taskSpaceId.value"><option value="">No configuration selected</option></select></div>
                        </div>
                    </div>
                    <div class="d-flex gap-2 mt-4">
                        <button class="btn btn-primary" type="submit" dmx-bind:disabled="frmTaskEdit.state.executing"><span dmx-show="!frmTaskEdit.state.executing">Update Task</span><span dmx-show="frmTaskEdit.state.executing">Saving...</span></button>
                        <a class="btn btn-light" dmx-bind:href="query.source == 'workflow' ? '/workflows/view?id=' + scTask.data.query[0].workflowId + '&section=tasks' : '/tasks'">Cancel</a>
                        <a class="btn btn-outline-secondary ms-auto" dmx-bind:href="'/workflows/view?id=' + scTask.data.query[0].workflowId" dmx-text="'Open ' + scTerminology.data.query[0].workflowSingular.lowercase()">Open event</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
<div class="row mt-4" id="taskAnswerPanel" dmx-show="scTaskAnswer.data.result.task.sourceTemplateTaskId"><div class="col-12 col-xl-8"><div class="card border-0 shadow-sm"><div class="card-header bg-white"><div class="small text-muted" dmx-text="scTaskAnswer.data.result.task.phaseNameSnapshot.default(scTaskAnswer.data.result.task.stageName)"></div><h2 class="h5 mb-0" dmx-text="scTaskAnswer.data.result.task.questionTextSnapshot.default(scTaskAnswer.data.result.task.taskName)">Task question</h2></div><div class="card-body"><p class="text-muted" dmx-show="scTaskAnswer.data.result.task.helpTextSnapshot" dmx-text="scTaskAnswer.data.result.task.helpTextSnapshot"></p>
<form id="frmTaskAttachment" is="dmx-serverconnect-form" method="post" action="/api/task_answers/upload_attachment" enctype="multipart/form-data" dmx-on:success="frmTaskAttachment.reset();scTaskAnswer.load()"><%- _csrfInput() %><input type="hidden" name="taskId" dmx-bind:value="query.id"><input type="hidden" name="documentName" dmx-bind:value="scTaskAnswer.data.result.task.taskName"></form>
<form id="frmTaskAnswer" is="dmx-serverconnect-form" method="post" action="/api/task_answers/save" dmx-on:success="scTaskAnswer.load();scTask.load()"><%- _csrfInput() %><input type="hidden" name="taskId" dmx-bind:value="query.id"><input type="hidden" id="taskAnswerComplete" name="complete" value="0"><div class="alert alert-success" dmx-show="frmTaskAnswer.data.result.success" dmx-text="frmTaskAnswer.data.result.message.default('Answer saved.')">Answer saved.</div><div class="alert alert-danger" dmx-show="frmTaskAnswer.lastError.status" dmx-text="frmTaskAnswer.lastError.response.message.default('The answer could not be saved.')"></div>
<div class="mb-3" dmx-show="scTaskAnswer.data.result.task.answerTypeSnapshot == 'yes_no'"><label class="form-label">Answer</label><select class="form-select" name="answerBoolean" dmx-bind:value="scTaskAnswer.data.result.answer.answerBoolean"><option value="">Select an answer</option><option value="1">Yes</option><option value="0">No</option></select></div>
<div class="mb-3" dmx-show="scTaskAnswer.data.result.task.answerTypeSnapshot == 'task_status'"><label class="form-label">Task progress</label><select class="form-select" name="answerStatus" dmx-bind:value="scTaskAnswer.data.result.answer.answerStatus.default('not_started')"><option value="not_started" dmx-text="scTaskAnswer.data.result.terminology.task_status_not_started.default('Not Started')"></option><option value="on_hold" dmx-text="scTaskAnswer.data.result.terminology.task_status_on_hold.default('On Hold')"></option><option value="complete" dmx-text="scTaskAnswer.data.result.terminology.task_status_complete.default('Complete')"></option></select><div class="form-text">Saving this updates the task status automatically.</div></div>
<div class="mb-3" dmx-show="scTaskAnswer.data.result.task.answerTypeSnapshot == 'text_short'"><label class="form-label">Answer</label><input class="form-control" name="answerText" maxlength="1000" dmx-bind:value="scTaskAnswer.data.result.answer.answerText"></div><div class="mb-3" dmx-show="scTaskAnswer.data.result.task.answerTypeSnapshot == 'text_long'"><label class="form-label">Answer</label><textarea class="form-control" name="answerText" rows="5" dmx-bind:value="scTaskAnswer.data.result.answer.answerText"></textarea></div>
<fieldset class="mb-3" dmx-show="scTaskAnswer.data.result.task.answerTypeSnapshot == 'radio'"><legend class="form-label">Answer</legend><div is="dmx-repeat" dmx-bind:repeat="scTaskAnswer.data.result.options"><div class="form-check mb-2"><input class="form-check-input" type="radio" name="answerOptionValue" dmx-bind:id="'taskAnswerOption_' + $value.id" dmx-bind:value="$value.optionValue" dmx-bind:checked="scTaskAnswer.data.result.answer.answerOptionValue == $value.optionValue"><label class="form-check-label" dmx-bind:for="'taskAnswerOption_' + $value.id" dmx-text="$value.optionLabel"></label></div></div></fieldset>
<div class="mb-3" dmx-show="scTaskAnswer.data.result.task.answerTypeSnapshot == 'dropdown_single'"><label class="form-label">Answer</label><select class="form-select" name="answerOptionValue" dmx-bind:options="scTaskAnswer.data.result.options" optiontext="optionLabel" optionvalue="optionValue" dmx-bind:value="scTaskAnswer.data.result.answer.answerOptionValue"><option value="">Select an answer</option></select></div>
<div class="mb-3" dmx-show="scTaskAnswer.data.result.task.answerTypeSnapshot == 'checkbox_multi'"><label class="form-label">Answers</label><div is="dmx-repeat" dmx-bind:repeat="scTaskAnswer.data.result.options"><div class="form-check mb-2"><input class="form-check-input" type="checkbox" name="answerValues" dmx-bind:id="'taskAnswerMulti_' + $value.id" dmx-bind:value="$value.optionValue" dmx-bind:checked="scTaskAnswer.data.result.answer.answerJson.default('[]').contains($value.optionValue)"><label class="form-check-label" dmx-bind:for="'taskAnswerMulti_' + $value.id" dmx-text="$value.optionLabel"></label></div></div></div><div class="mb-3" dmx-show="scTaskAnswer.data.result.task.answerTypeSnapshot == 'dropdown_multi'"><label class="form-label">Answers</label><select class="form-select" name="answerValues" multiple dmx-bind:options="scTaskAnswer.data.result.options" optiontext="optionLabel" optionvalue="optionValue" dmx-bind:value="scTaskAnswer.data.result.answer.answerJson"></select></div>
<div class="border rounded p-3 mb-3" dmx-show="scTaskAnswer.data.result.task.attachmentRequirement != 'none'">
<div class="d-flex justify-content-between align-items-start gap-3 mb-2"><div><h3 class="h6 mb-1"><span dmx-text="scTaskAnswer.data.result.terminology.task_attachment.default('Attachment')">Attachment</span> <span class="badge bg-danger" dmx-show="scTaskAnswer.data.result.task.attachmentRequirement == 'required'">Required</span><span class="badge bg-secondary" dmx-show="scTaskAnswer.data.result.task.attachmentRequirement == 'optional'">Optional</span></h3><p class="small text-muted mb-0">Add the supporting document for this task here.</p></div><span class="badge bg-success" dmx-show="scTaskAnswer.data.result.attachmentCount > 0" dmx-text="scTaskAnswer.data.result.attachmentCount + (scTaskAnswer.data.result.attachmentCount == 1 ? ' file attached' : ' files attached')"></span></div>
<div class="list-group list-group-flush mb-3" dmx-show="scTaskAnswer.data.result.attachmentCount > 0"><div is="dmx-repeat" dmx-bind:repeat="scTaskAnswer.data.result.documents"><div class="list-group-item px-0 d-flex justify-content-between align-items-center gap-3"><div><i class="fas fa-file-alt text-primary me-2"></i><span dmx-text="$value.documentName.default($value.originalFileName)"></span><div class="small text-muted ms-4" dmx-text="$value.originalFileName"></div></div><a class="btn btn-sm btn-outline-primary" dmx-bind:href="'/api/workflows/download_document?id=' + $value.id"><i class="fas fa-download me-1"></i>Download</a></div></div></div>
<div class="alert alert-success py-2" dmx-show="frmTaskAttachment.data.insertDocument.affected">Document attached to this task.</div><div class="alert alert-danger py-2" dmx-show="frmTaskAttachment.lastError.status" dmx-text="frmTaskAttachment.lastError.response.message.default('The document could not be uploaded.')"></div><div class="input-group"><input class="form-control" type="file" name="documentFile" form="frmTaskAttachment" accept=".pdf,.doc,.docx,.xls,.xlsx,.jpg,.jpeg,.png" required><button class="btn btn-outline-primary" type="submit" form="frmTaskAttachment" dmx-bind:disabled="frmTaskAttachment.state.executing"><span dmx-show="!frmTaskAttachment.state.executing"><i class="fas fa-upload me-1"></i>Attach document</span><span dmx-show="frmTaskAttachment.state.executing">Uploading...</span></button></div><div class="form-text">PDF, Word, Excel, JPG or PNG, up to 10 MB.</div>
</div>
<div class="row g-3 mb-3"><div class="col-md-4" dmx-show="scTaskAnswer.data.result.task.showStartDate"><label class="form-label" dmx-text="scTaskAnswer.data.result.terminology.task_start_date.default('Start Date')"></label><input class="form-control" type="datetime-local" disabled dmx-bind:value="scTaskAnswer.data.result.task.startedDate.formatDate('yyyy-MM-ddTHH:mm')"></div><div class="col-md-4" dmx-show="scTaskAnswer.data.result.task.showDeadline"><label class="form-label" dmx-text="scTaskAnswer.data.result.terminology.task_due_date.default('Due Date')"></label><input class="form-control" type="datetime-local" disabled dmx-bind:value="scTaskAnswer.data.result.task.dueDate.formatDate('yyyy-MM-ddTHH:mm')"></div><div class="col-md-4" dmx-show="scTaskAnswer.data.result.task.showFinishDate"><label class="form-label" dmx-text="scTaskAnswer.data.result.terminology.task_finish_date.default('Finish Date')"></label><input class="form-control" type="datetime-local" disabled dmx-bind:value="scTaskAnswer.data.result.task.completedDate.formatDate('yyyy-MM-ddTHH:mm')"></div></div>
<div class="mb-3" dmx-show="scTaskAnswer.data.result.task.allowNotes"><label class="form-label" dmx-text="scTaskAnswer.data.result.terminology.task_notes.default('Notes')"></label><textarea class="form-control" name="notes" rows="3" dmx-bind:value="scTaskAnswer.data.result.answer.notes"></textarea></div>
<div class="d-flex gap-2 align-items-center"><button class="btn btn-outline-primary" type="button" dmx-on:click="taskAnswerComplete.setValue(0);frmTaskAnswer.submit()">Save Answer</button><button class="btn btn-primary" type="button" dmx-on:click="taskAnswerComplete.setValue(1);frmTaskAnswer.submit()" dmx-show="scTaskAnswer.data.result.task.status != 'complete'" dmx-bind:disabled="scTaskAnswer.data.result.task.attachmentRequirement == 'required' && scTaskAnswer.data.result.attachmentCount == 0">Save &amp; Complete</button><span class="small text-danger" dmx-show="scTaskAnswer.data.result.task.attachmentRequirement == 'required' && scTaskAnswer.data.result.attachmentCount == 0">Attach a document before completing this task.</span></div></form></div></div></div></div>
<div class="modal fade" id="sendTaskNotificationModal" is="dmx-bs5-modal" tabindex="-1" aria-labelledby="sendTaskNotificationModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <form is="dmx-serverconnect-form" method="post" action="/api/notifications/send" dmx-on:success="sendTaskNotificationModal.hide();scHeaderNotifications.load()"><%- _csrfInput() %>
                <input type="hidden" name="workflowId" dmx-bind:value="scTask.data.query[0].workflowId"><input type="hidden" name="taskId" dmx-bind:value="query.id">
                <div class="modal-header"><div><h2 class="modal-title h5 mb-1" id="sendTaskNotificationModalLabel">Notify someone about this task</h2><p class="small text-muted mb-0" dmx-text="scTask.data.query[0].taskName"></p></div><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div>
                <div class="modal-body"><div class="row g-3">
                    <div class="col-12"><label class="form-label">Recipient</label><select class="form-select" name="recipientUserId" required dmx-bind:options="scTaskNotificationRecipients.data.recipients" optiontext="recipientLabel" optionvalue="id"><option value="">Select a user</option></select></div>
                    <div class="col-12"><label class="form-label">Subject</label><input class="form-control" name="title" maxlength="180" required dmx-bind:value="scTask.data.query[0].taskName"></div>
                    <div class="col-12"><label class="form-label">Message</label><textarea class="form-control" name="message" rows="4" maxlength="2000" required placeholder="What does this person need to know or do?"></textarea></div>
                </div></div>
                <div class="modal-footer"><button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button><button class="btn btn-primary" type="submit"><i class="fas fa-paper-plane me-2"></i>Send notification</button></div>
            </form>
        </div>
    </div>
</div>
<script>document.addEventListener('DOMContentLoaded',function(){const layout=document.getElementById('taskEditLayout'),wrapper=document.getElementById('taskAnswerPanel'),panel=wrapper&&wrapper.firstElementChild,details=layout&&layout.children[1];if(layout&&panel&&details){panel.classList.add('mb-0');layout.insertBefore(panel,details);wrapper.remove();}});</script>
<meta name="ac:route" content="/tasks/edit">
