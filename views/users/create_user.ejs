<!-- Wappler include head-page="layouts/main_shell" fontawesome_5="cdn" bootstrap5="local" is="dmx-app" id="create_user" appConnect="local" components="{dmxBootstrap5TableGenerator:{},dmxStateManagement:{},dmxBrowser:{}}" -->
<dmx-query-manager id="query1"></dmx-query-manager>
<dmx-browser id="browser1"></dmx-browser>
<dmx-value id="varInviteError" value=""></dmx-value>

<dmx-serverconnect id="scRoles" url="/api/tenant/users/role_options_v2"></dmx-serverconnect>

<div class="row g-4">
    <div class="col-12">
        <div class="d-flex align-items-center justify-content-between gap-3">
            <div>
                <h1 class="mb-1">Invite user</h1>
                <p class="text-muted mb-0">Invite a person to the current organisation and assign one or more permitted tenant roles.</p>
            </div>
            <a class="btn btn-outline-secondary" href="/users/all_users">Back to users</a>
        </div>
    </div>

    <div class="col-12 col-xl-7">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white">
                <h2 class="h5 mb-0">User details</h2>
            </div>

            <div class="card-body">
                <form id="frmCreateUser" is="dmx-serverconnect-form" method="post" action="/api/tenant/users/create_or_invite_v2"
                    dmx-on:submit="varInviteError.setValue('')"
                    dmx-on:success="frmCreateUser.data.success ? browser1.goto('/users/all_users') : varInviteError.setValue(frmCreateUser.data.message.default('The user could not be invited.'))"
                    dmx-on:error="varInviteError.setValue(frmCreateUser.lastError.response.message.default(frmCreateUser.lastError.message.default('The user could not be invited.')))">
                    <%- _csrfInput() %>

                    <div class="alert alert-danger" role="alert" style="display: none;" dmx-show="varInviteError.value">
                        <i class="fas fa-exclamation-circle me-2"></i>
                        <strong>User could not be invited.</strong>
                        <span dmx-text="varInviteError.value"></span>
                    </div>

                    <div class="row g-3">

                        <div class="col-12">
                            <div class="form-floating">
                                <input id="inp_email" name="email" type="email" class="form-control" placeholder="Email" required dmx-class:is-invalid="frmCreateUser.lastError.response.form.email">
                                <label for="inp_email">Email</label>
                            </div>

                            <%-await include('../partials/form_field_error', {
        formId: 'frmCreateUser',
        fieldName: 'email'
    }) %>
                        </div>

                        <div class="col-12 col-md-6">
                            <div class="form-floating">
                                <input id="inp_fName" name="firstName" type="text" class="form-control" placeholder="First name" required>
                                <label for="inp_fName">First name</label>
                            </div>
                        </div>

                        <div class="col-12 col-md-6">
                            <div class="form-floating">
                                <input id="inp_lName" name="lastName" type="text" class="form-control" placeholder="Last name" required>
                                <label for="inp_lName">Last name</label>
                            </div>
                        </div>

                        <div class="col-12">
                            <fieldset>
                                <legend class="h6 mb-2">Tenant roles</legend>
                                <p class="text-muted small">Select all roles this person needs. Only roles you are authorised to assign are shown.</p>
                                <div class="border rounded p-3">
                                    <div class="form-check mb-2" is="dmx-repeat" id="repeatAssignableRoles" dmx-bind:repeat="scRoles.data.roles">
                                        <input class="form-check-input" type="checkbox" name="roleIds[]" dmx-bind:id="'role_' + id" dmx-bind:value="id">
                                        <label class="form-check-label" dmx-bind:for="'role_' + id">
                                            <span class="fw-semibold" dmx-text="roleName"></span>
                                            <span class="d-block text-muted small" dmx-text="roleDescription"></span>
                                        </label>
                                    </div>
                                    <div class="text-muted small" dmx-show="!scRoles.state.executing && scRoles.data.roles.count()==0">No roles are available for you to assign.</div>
                                </div>
                            </fieldset>
                        </div>
                    </div>

                    <div class="d-flex gap-2 mt-4">
                        <button type="submit" class="btn btn-primary" dmx-bind:disabled="frmCreateUser.state.executing">
                            <span dmx-show="!frmCreateUser.state.executing">Send invitation</span>
                            <span style="display: none;" dmx-show="frmCreateUser.state.executing">Creating invitation...</span>
                        </button>
                        <a class="btn btn-light" href="/users/all_users">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<meta name="ac:route" content="/users/create_user">
