<!-- Wappler include head-page="layouts/main_shell" fontawesome_5="cdn" bootstrap5="local" is="dmx-app" id="contracting_entity_editor" appConnect="local" -->
<dmx-serverconnect id="scContractingEntity" url="/api/contracting_entities/get" dmx-param:id="query.id" dmx-show="query.id"></dmx-serverconnect>
<div class="row g-4">
    <div class="col-12"><div class="d-flex justify-content-between align-items-center"><div><h1 class="mb-1" dmx-text="query.id ? 'Edit Contracting Entity' : 'Add Contracting Entity'">Contracting Entity</h1><p class="text-muted mb-0">These details can be merged into contracts.</p></div><a class="btn btn-outline-secondary" href="/contracting-entities">Back</a></div></div>
    <div class="col-12 col-xl-9"><div class="card border-0 shadow-sm"><div class="card-body">
        <form method="post" action="/api/contracting_entities/save">
            <%- _csrfInput() %><input type="hidden" name="id" dmx-bind:value="scContractingEntity.data.query[0].id">
            <h2 class="h5 mb-3">Organisation</h2>
            <div class="row g-3">
                <div class="col-md-6"><label class="form-label">Legal name</label><input class="form-control" name="legalName" required dmx-bind:value="scContractingEntity.data.query[0].legalName"></div>
                <div class="col-md-6"><label class="form-label">Trading name</label><input class="form-control" name="tradingName" dmx-bind:value="scContractingEntity.data.query[0].tradingName"></div>
                <div class="col-md-6"><label class="form-label">Company or charity number</label><input class="form-control" name="registrationNumber" dmx-bind:value="scContractingEntity.data.query[0].registrationNumber"></div>
                <div class="col-md-6"><label class="form-label">VAT number</label><input class="form-control" name="vatNumber" dmx-bind:value="scContractingEntity.data.query[0].vatNumber"></div>
                <div class="col-md-6"><label class="form-label">Address line 1</label><input class="form-control" name="addressLine1" dmx-bind:value="scContractingEntity.data.query[0].addressLine1"></div>
                <div class="col-md-6"><label class="form-label">Address line 2</label><input class="form-control" name="addressLine2" dmx-bind:value="scContractingEntity.data.query[0].addressLine2"></div>
                <div class="col-md-4"><label class="form-label">Town or city</label><input class="form-control" name="townCity" dmx-bind:value="scContractingEntity.data.query[0].townCity"></div>
                <div class="col-md-4"><label class="form-label">County or region</label><input class="form-control" name="countyRegion" dmx-bind:value="scContractingEntity.data.query[0].countyRegion"></div>
                <div class="col-md-4"><label class="form-label">Postcode</label><input class="form-control" name="postcode" dmx-bind:value="scContractingEntity.data.query[0].postcode"></div>
                <div class="col-md-4"><label class="form-label">Country</label><input class="form-control" name="country" dmx-bind:value="scContractingEntity.data.query[0].country"></div>
                <div class="col-md-4"><label class="form-label">Telephone</label><input class="form-control" name="telephone" dmx-bind:value="scContractingEntity.data.query[0].telephone"></div>
                <div class="col-md-4"><label class="form-label">Email</label><input class="form-control" type="email" name="email" dmx-bind:value="scContractingEntity.data.query[0].email"></div>
                <div class="col-md-6"><label class="form-label">Website</label><input class="form-control" name="website" dmx-bind:value="scContractingEntity.data.query[0].website"></div>
                <div class="col-md-3"><label class="form-label">Default entity</label><select class="form-select" name="isDefault" dmx-bind:value="query.id ? scContractingEntity.data.query[0].isDefault : 1"><option value="1">Yes</option><option value="0">No</option></select></div>
                <div class="col-md-3"><label class="form-label">Status</label><select class="form-select" name="isActive" dmx-bind:value="query.id ? scContractingEntity.data.query[0].isActive : 1"><option value="1">Active</option><option value="0">Inactive</option></select></div>
            </div>
            <hr class="my-4"><h2 class="h5 mb-3">Contracts</h2>
            <div class="row g-3">
                <div class="col-md-6"><label class="form-label">Default signatory</label><input class="form-control" name="signatoryName" dmx-bind:value="scContractingEntity.data.query[0].signatoryName"></div>
                <div class="col-md-6"><label class="form-label">Signatory title</label><input class="form-control" name="signatoryTitle" dmx-bind:value="scContractingEntity.data.query[0].signatoryTitle"></div>
                <div class="col-12"><label class="form-label">Default payment terms</label><textarea class="form-control" name="defaultPaymentTerms" rows="3" dmx-bind:value="scContractingEntity.data.query[0].defaultPaymentTerms"></textarea></div>
                <div class="col-12"><label class="form-label">Contract footer</label><textarea class="form-control" name="contractFooter" rows="3" dmx-bind:value="scContractingEntity.data.query[0].contractFooter"></textarea></div>
            </div>
            <div class="mt-4"><button class="btn btn-primary" type="submit">Save contracting entity</button> <a class="btn btn-light" href="/contracting-entities">Cancel</a></div>
        </form>
    </div></div></div>
</div>
<meta name="ac:route" content="/contracting-entities/editor">
