<!-- Wappler include head-page="layouts/main_shell" fontawesome_5="cdn" bootstrap5="local" is="dmx-app" id="contracting_entities" appConnect="local" -->
<dmx-serverconnect id="scContractingEntities" url="/api/contracting_entities/list"></dmx-serverconnect>
<div class="row g-4">
    <div class="col-12">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
            <div><h1 class="mb-1">Contracting Entities</h1><p class="text-muted mb-0">Manage the legal organisations that can issue contracts.</p></div>
            <a class="btn btn-primary" href="/contracting-entities/editor"><i class="fas fa-plus me-2"></i>Add contracting entity</a>
        </div>
    </div>
    <div class="col-12">
        <div class="alert alert-success" dmx-show="query.saved == 1">Contracting entity saved.</div>
        <div class="card border-0 shadow-sm">
            <div class="card-body p-0">
                <div class="table-responsive" dmx-show="scContractingEntities.data.query.count() > 0">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light"><tr><th>Legal organisation</th><th>Registration</th><th>Address</th><th>Status</th><th></th></tr></thead>
                        <tbody is="dmx-repeat" dmx-bind:repeat="scContractingEntities.data.query">
                            <tr>
                                <td><div class="fw-semibold" dmx-text="$value.legalName"></div><div class="small text-muted" dmx-text="$value.tradingName"></div></td>
                                <td><div dmx-text="$value.registrationNumber || '—'"></div><div class="small text-muted" dmx-show="$value.vatNumber" dmx-text="'VAT ' + $value.vatNumber"></div></td>
                                <td dmx-text="$value.addressLabel || '—'"></td>
                                <td><span class="badge bg-primary" dmx-show="$value.isDefault == 1">Default</span> <span class="badge bg-success" dmx-show="$value.isActive == 1">Active</span><span class="badge bg-secondary" dmx-show="$value.isActive != 1">Inactive</span></td>
                                <td class="text-end"><a class="btn btn-sm btn-outline-primary" dmx-bind:href="'/contracting-entities/editor?id=' + $value.id"><i class="fas fa-pen me-1"></i>Edit</a></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <div class="text-center text-muted py-5" dmx-show="!scContractingEntities.state.executing && scContractingEntities.data.query.count() == 0">
                    <i class="fas fa-building fa-2x mb-3"></i><h2 class="h6">No contracting entities yet</h2><p class="small">Add the legal organisation that will appear on contracts.</p>
                </div>
            </div>
        </div>
    </div>
</div>
<meta name="ac:route" content="/contracting-entities">
