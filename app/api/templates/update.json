{
  "settings": {
    "options": {
      "restrict": {
        "provider": "security"
      },
      "method": "post"
    }
  },
  "meta": {
    "$_POST": [
      {
        "type": "number",
        "name": "id"
      },
      {
        "type": "text",
        "name": "templateName"
      },
      {
        "type": "text",
        "name": "templateKey"
      },
      {
        "type": "text",
        "name": "description"
      },
      {
        "type": "number",
        "name": "versionNumber"
      },
      {
        "type": "text",
        "name": "status"
      },
      {
        "type": "number",
        "name": "isDefault"
      },
      {
        "type": "number",
        "name": "recordFormTemplateId"
      }
    ]
  },
  "exec": {
    "steps": [{"name":"requireTenantLifecycleWrite","module":"tenantLifecycle","action":"requireWrite","options":{"tenantId":"{{$_SESSION.TENANT_ID.default(0)}}","userId":"{{$_SESSION.USER_ID.default(0)}}","requireMembership":true},"output":false},
      {
        "name": "permissionGrant",
        "module": "dbconnector",
        "action": "select",
        "options": {
          "connection": "db",
          "sql": {
            "type": "SELECT",
            "columns": [
              {
                "table": "tbl_role_permissions",
                "column": "id",
                "field": "grantId"
              }
            ],
            "table": {
              "name": "tbl_role_permissions"
            },
            "primary": "id",
            "joins": [],
            "params": [
              {
                "name": ":P1",
                "type": "expression",
                "value": "{{$_SESSION.USER_ID.default(0)}}"
              },
              {
                "name": ":P2",
                "type": "expression",
                "value": "{{$_SESSION.TENANT_ID.default(0)}}"
              },
              {
                "name": ":P3",
                "type": "expression",
                "value": "tenant.processes.edit"
              }
            ],
            "query": "select `rp`.`id` as `grantId` from `tbl_user_tenants` as `ut` inner join `tbl_user_tenant_roles` as `utr` on `utr`.`tenantId`=`ut`.`tenantId` and `utr`.`userId`=`ut`.`userId` and `utr`.`isActive`=1 inner join `tbl_roles` as `r` on `r`.`id`=`utr`.`roleId` and `r`.`isActive`=1 and (`r`.`tenantId` is null or `r`.`tenantId`=`ut`.`tenantId`) inner join `tbl_role_permissions` as `rp` on `rp`.`roleId`=`r`.`id` inner join `tbl_permissions` as `p` on `p`.`id`=`rp`.`permissionId` and `p`.`isActive`=1 where `ut`.`userId`=? and `ut`.`tenantId`=? and `ut`.`isActive`=1 and `ut`.`membershipStatus`='active' and `p`.`permissionCode`=? limit 1"
          }
        },
        "output": true,
        "outputType": "array"
      },
      {
        "name": "requirePermission",
        "module": "core",
        "action": "condition",
        "options": {
          "if": "{{permissionGrant.count() == 0}}",
          "then": {
            "steps": {
              "name": "permissionDenied",
              "module": "core",
              "action": "response",
              "options": {
                "status": 403,
                "data": {
                  "success": false,
                  "errorCode": "PERMISSION_DENIED",
                  "message": "You do not have permission to perform this action.",
                  "permissionCode": "tenant.processes.edit"
                }
              }
            }
          }
        },
        "outputType": "boolean"
      },
      {
        "name": "updateTemplate",
        "module": "dbupdater",
        "action": "custom",
        "options": {
          "connection": "db",
          "sql": {
            "query": "UPDATE tbl_workflow_templates wt SET wt.templateName=:templateName,wt.templateKey=NULLIF(:templateKey,''),wt.description=:description,wt.versionNumber=:versionNumber,wt.status=:status,wt.isDefault=:isDefault,wt.recordFormTemplateId=(SELECT f.id FROM tbl_form_templates f WHERE f.id=NULLIF(:recordFormTemplateId,'') AND f.tenantId=wt.tenantId AND f.formType='record' AND f.status='published' AND f.isActive=1 LIMIT 1),wt.modifiedDate=CURRENT_TIMESTAMP WHERE wt.id=:id AND wt.tenantId=:tenantId",
            "params": [
              {
                "name": ":templateName",
                "value": "{{$_POST.templateName}}"
              },
              {
                "name": ":templateKey",
                "value": "{{$_POST.templateKey}}"
              },
              {
                "name": ":description",
                "value": "{{$_POST.description}}"
              },
              {
                "name": ":versionNumber",
                "value": "{{$_POST.versionNumber.default(1)}}"
              },
              {
                "name": ":status",
                "value": "{{$_POST.status.default('draft')}}"
              },
              {
                "name": ":isDefault",
                "value": "{{$_POST.isDefault.default(0)}}"
              },
              {
                "name": ":recordFormTemplateId",
                "value": "{{$_POST.recordFormTemplateId.default('')}}"
              },
              {
                "name": ":id",
                "value": "{{$_POST.id}}"
              },
              {
                "name": ":tenantId",
                "value": "{{$_SESSION.TENANT_ID}}"
              }
            ]
          }
        },
        "output": true
      },
      {
        "module": "core",
        "action": "redirect",
        "options": {
          "url": "/templates",
          "status": 302
        }
      }
    ]
  }
}
