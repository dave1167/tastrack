{
  "settings": {"options": {"restrict":{"provider":"security"},"method": "post"}},
  "meta": {"$_POST": [
    {"type": "number", "name": "taskId"},
    {"type": "text", "name": "documentName"}
  ]},
  "exec": {"steps": [
    {
      "name": "verifiedTask",
      "module": "dbupdater",
      "action": "custom",
      "options": {"connection": "db", "sql": {
        "query": "SELECT t.id,t.workflowId FROM tbl_tasks t INNER JOIN tbl_workflows w ON w.id=t.workflowId AND w.tenantId=t.tenantId WHERE t.id=:taskId AND t.tenantId=:tenantId LIMIT 1",
        "params": [
          {"name": ":taskId", "value": "{{$_POST.taskId}}"},
          {"name": ":tenantId", "value": "{{$_SESSION.TENANT_ID}}"}
        ]
      }},
      "output": true,
      "outputType": "array"
    },
    {
      "module": "core",
      "action": "condition",
      "options": {
        "if": "{{verifiedTask.count() > 0}}",
        "then": {"steps": [
          {
            "name": "uploadDocument",
            "module": "upload",
            "action": "upload",
            "options": {
              "fields": "documentFile",
              "path": "/uploads/documents/{{$_SESSION.TENANT_ID}}/{{verifiedTask[0].workflowId}}/tasks/{{verifiedTask[0].id}}",
              "template": "{name}_{guid}{ext}",
              "overwrite": false,
              "createPath": true,
              "throwErrors": true,
              "replaceSpace": true,
              "asciiOnly": true,
              "replaceDiacritics": true
            },
            "output": true
          },
          {
            "module": "core",
            "action": "condition",
            "options": {
              "if": "{{uploadDocument && uploadDocument.size <= 10485760 && (uploadDocument.type == 'application/pdf' || uploadDocument.type == 'application/msword' || uploadDocument.type == 'application/vnd.openxmlformats-officedocument.wordprocessingml.document' || uploadDocument.type == 'application/vnd.ms-excel' || uploadDocument.type == 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet' || uploadDocument.type == 'image/jpeg' || uploadDocument.type == 'image/png')}}",
              "then": {"steps": [
                {
                  "name": "insertDocument",
                  "module": "dbupdater",
                  "action": "custom",
                  "options": {"connection": "db", "sql": {
                    "query": "INSERT INTO tbl_documents (tenantId,workflowId,taskId,uploadedByUserId,documentName,documentType,status,storageProvider,storagePath,originalFileName,mimeType,fileSizeBytes,versionNumber) VALUES (:tenantId,:workflowId,:taskId,:userId,:documentName,'Task attachment','received','local',:storagePath,:originalFileName,:mimeType,:fileSize,1)",
                    "params": [
                      {"name": ":tenantId", "value": "{{$_SESSION.TENANT_ID}}"},
                      {"name": ":workflowId", "value": "{{verifiedTask[0].workflowId}}"},
                      {"name": ":taskId", "value": "{{verifiedTask[0].id}}"},
                      {"name": ":userId", "value": "{{$_SESSION.USER_ID}}"},
                      {"name": ":documentName", "value": "{{$_POST.documentName.default(uploadDocument.name)}}"},
                      {"name": ":storagePath", "value": "{{uploadDocument.path}}"},
                      {"name": ":originalFileName", "value": "{{uploadDocument.name}}"},
                      {"name": ":mimeType", "value": "{{uploadDocument.type}}"},
                      {"name": ":fileSize", "value": "{{uploadDocument.size}}"}
                    ]
                  }},
                  "output": true
                }
              ]},
              "else": {"steps": [
                {"module": "fs", "action": "remove", "options": {"path": "{{uploadDocument.path}}"}},
                {"module": "core", "action": "error", "options": {"message": "Choose a PDF, Word, Excel, JPG or PNG file no larger than 10 MB."}}
              ]}
            }
          }
        ]},
        "else": {"steps": [
          {"module": "core", "action": "error", "options": {"message": "The selected task is not available."}}
        ]}
      }
    }
  ]}}
