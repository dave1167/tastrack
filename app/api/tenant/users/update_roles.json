{
  "settings": {
    "options": {
      "method": "post",
      "restrict": {
        "provider": "security"
      }
    }
  },
  "meta": {
    "$_POST": [
      {
        "type": "number",
        "name": "userId",
        "options": {
          "rules": {
            "core:required": {
              "param": ""
            }
          }
        }
      },
      {
        "type": "number",
        "name": "roleIds",
        "multiple": true,
        "options": {
          "rules": {
            "core:required": {
              "param": ""
            }
          }
        }
      }
    ]
  },
  "exec": {
    "steps": [
      {
        "name": "permissionGrant",
        "module": "dbconnector",
        "action": "select",
        "options": {
          "connection": "db",
          "sql": {
            "type": "SELECT",
            "columns": [
              {
                "table": "tbl_role_permissions",
                "column": "id",
                "field": "grantId"
              }
            ],
            "table": {
              "name": "tbl_role_permissions"
            },
            "primary": "id",
            "joins": [],
            "params": [
              {
                "name": ":P1",
                "type": "expression",
                "value": "{{$_SESSION.USER_ID.default(0)}}"
              },
              {
                "name": ":P2",
                "type": "expression",
                "value": "{{$_SESSION.TENANT_ID.default(0)}}"
              }
            ],
            "query": "select `rp`.`id` as `grantId` from `tbl_user_tenants` `ut` inner join `tbl_user_tenant_roles` `utr` on `utr`.`userId`=`ut`.`userId` and `utr`.`tenantId`=`ut`.`tenantId` and `utr`.`isActive`=1 inner join `tbl_role_permissions` `rp` on `rp`.`roleId`=`utr`.`roleId` inner join `tbl_permissions` `p` on `p`.`id`=`rp`.`permissionId` and `p`.`permissionCode`='tenant.users.roles.assign' and `p`.`isActive`=1 where `ut`.`userId`=? and `ut`.`tenantId`=? and `ut`.`isActive`=1 and `ut`.`membershipStatus`='active' limit 1"
          }
        },
        "output": true,
        "outputType": "array"
      },
      {
        "name": "requirePermission",
        "module": "core",
        "action": "condition",
        "options": {
          "if": "{{permissionGrant.count()==0}}",
          "then": {
            "steps": {
              "name": "denied",
              "module": "core",
              "action": "error",
              "options": {
                "status": 403,
                "message": "You do not have permission to assign tenant roles."
              }
            }
          }
        },
        "outputType": "boolean"
      },
      {
        "name": "requireOtherUser",
        "module": "core",
        "action": "condition",
        "options": {
          "if": "{{$_POST.userId==$_SESSION.USER_ID}}",
          "then": {
            "steps": {
              "name": "selfDenied",
              "module": "core",
              "action": "error",
              "options": {
                "status": 403,
                "message": "You cannot change your own tenant roles."
              }
            }
          }
        },
        "outputType": "boolean"
      },
      {
        "name": "targetMembership",
        "module": "dbconnector",
        "action": "select",
        "options": {
          "connection": "db",
          "sql": {
            "type": "SELECT",
            "columns": [
              {
                "table": "tbl_user_tenants",
                "column": "id"
              }
            ],
            "table": {
              "name": "tbl_user_tenants"
            },
            "primary": "id",
            "joins": [],
            "params": [
              {
                "name": ":P1",
                "type": "expression",
                "value": "{{$_POST.userId}}"
              },
              {
                "name": ":P2",
                "type": "expression",
                "value": "{{$_SESSION.TENANT_ID.default(0)}}"
              }
            ],
            "query": "select `id` from `tbl_user_tenants` where `userId`=? and `tenantId`=? limit 1"
          }
        },
        "output": true,
        "outputType": "array"
      },
      {
        "name": "requireMembership",
        "module": "core",
        "action": "condition",
        "options": {
          "if": "{{targetMembership.count()==0}}",
          "then": {
            "steps": {
              "name": "notFound",
              "module": "core",
              "action": "error",
              "options": {
                "status": 404,
                "message": "The tenant membership could not be found."
              }
            }
          }
        },
        "outputType": "boolean"
      },
      {
        "name": "requireRoles",
        "module": "core",
        "action": "condition",
        "options": {
          "if": "{{$_POST.roleIds.count()==0}}",
          "then": {
            "steps": {
              "name": "rolesRequired",
              "module": "core",
              "action": "error",
              "options": {
                "status": 400,
                "message": "Select at least one role."
              }
            }
          }
        },
        "outputType": "boolean"
      },
      {
        "name": "validateRoles",
        "module": "core",
        "action": "repeat",
        "options": {
          "repeat": "{{$_POST.roleIds}}",
          "exec": {
            "steps": [
              {
                "name": "validRole",
                "module": "dbconnector",
                "action": "select",
                "options": {
                  "connection": "db",
                  "sql": {
                    "type": "SELECT",
                    "columns": [
                      {
                        "table": "tbl_roles",
                        "column": "id"
                      }
                    ],
                    "table": {
                      "name": "tbl_roles"
                    },
                    "primary": "id",
                    "joins": [],
                    "params": [
                      {
                        "name": ":P1",
                        "type": "expression",
                        "value": "{{$value}}"
                      },
                      {
                        "name": ":P2",
                        "type": "expression",
                        "value": "{{$_SESSION.TENANT_ID.default(0)}}"
                      },
                      {
                        "name": ":P3",
                        "type": "expression",
                        "value": "{{$_SESSION.USER_ID.default(0)}}"
                      },
                      {
                        "name": ":P4",
                        "type": "expression",
                        "value": "{{$_SESSION.TENANT_ID.default(0)}}"
                      },
                      {
                        "name": ":P5",
                        "type": "expression",
                        "value": "{{$_SESSION.USER_ID.default(0)}}"
                      },
                      {
                        "name": ":P6",
                        "type": "expression",
                        "value": "{{$_SESSION.TENANT_ID.default(0)}}"
                      }
                    ],
                    "query": "select `r`.`id` from `tbl_roles` `r` where `r`.`id`=? and `r`.`isActive`=1 and (`r`.`tenantId`=? or (`r`.`tenantId` is null and `r`.`isProtected`=1)) and (`r`.`isAssignable`=1 or (`r`.`isOwnerRole`=1 and exists(select 1 from `tbl_user_tenant_roles` `om` inner join `tbl_roles` `orr` on `orr`.`id`=`om`.`roleId` and `orr`.`isOwnerRole`=1 where `om`.`userId`=? and `om`.`tenantId`=? and `om`.`isActive`=1))) and not exists(select 1 from `tbl_role_permissions` `targetRp` where `targetRp`.`roleId`=`r`.`id` and not exists(select 1 from `tbl_user_tenant_roles` `actorMap` inner join `tbl_role_permissions` `actorRp` on `actorRp`.`roleId`=`actorMap`.`roleId` and `actorRp`.`permissionId`=`targetRp`.`permissionId` where `actorMap`.`userId`=? and `actorMap`.`tenantId`=? and `actorMap`.`isActive`=1)) limit 1"
                  }
                },
                "output": true,
                "outputType": "array"
              },
              {
                "name": "rejectRole",
                "module": "core",
                "action": "condition",
                "options": {
                  "if": "{{validRole.count()==0}}",
                  "then": {
                    "steps": {
                      "name": "invalidRole",
                      "module": "core",
                      "action": "error",
                      "options": {
                        "status": 403,
                        "message": "One of the selected roles is not available for you to assign."
                      }
                    }
                  }
                },
                "outputType": "boolean"
              }
            ]
          }
        },
        "output": true,
        "outputType": "array"
      },
      {
        "name": "targetOwnerRole",
        "module": "dbconnector",
        "action": "select",
        "options": {
          "connection": "db",
          "sql": {
            "type": "SELECT",
            "columns": [
              {
                "table": "tbl_user_tenant_roles",
                "column": "id"
              }
            ],
            "table": {
              "name": "tbl_user_tenant_roles"
            },
            "primary": "id",
            "joins": [],
            "params": [
              {
                "name": ":P1",
                "type": "expression",
                "value": "{{$_POST.userId}}"
              },
              {
                "name": ":P2",
                "type": "expression",
                "value": "{{$_SESSION.TENANT_ID.default(0)}}"
              }
            ],
            "query": "select `utr`.`id` from `tbl_user_tenant_roles` `utr` inner join `tbl_roles` `r` on `r`.`id`=`utr`.`roleId` and `r`.`isOwnerRole`=1 where `utr`.`userId`=? and `utr`.`tenantId`=? and `utr`.`isActive`=1 limit 1"
          }
        },
        "output": true,
        "outputType": "array"
      },
      {
        "name": "selectedOwnerRole",
        "module": "dbconnector",
        "action": "select",
        "options": {
          "connection": "db",
          "sql": {
            "type": "SELECT",
            "columns": [
              {
                "table": "tbl_roles",
                "column": "id"
              }
            ],
            "table": {
              "name": "tbl_roles"
            },
            "primary": "id",
            "joins": [],
            "params": [
              {
                "name": ":P1",
                "type": "expression",
                "value": "{{$_POST.roleIds.join(',')}}"
              }
            ],
            "query": "select `id` from `tbl_roles` where `isOwnerRole`=1 and FIND_IN_SET(CAST(`id` AS CHAR),?)>0 limit 1"
          }
        },
        "output": true,
        "outputType": "array"
      },
      {
        "name": "otherActiveOwners",
        "module": "dbconnector",
        "action": "select",
        "options": {
          "connection": "db",
          "sql": {
            "type": "SELECT",
            "columns": [
              {
                "table": "tbl_user_tenant_roles",
                "column": "id"
              }
            ],
            "table": {
              "name": "tbl_user_tenant_roles"
            },
            "primary": "id",
            "joins": [],
            "params": [
              {
                "name": ":P1",
                "type": "expression",
                "value": "{{$_SESSION.TENANT_ID.default(0)}}"
              },
              {
                "name": ":P2",
                "type": "expression",
                "value": "{{$_POST.userId}}"
              }
            ],
            "query": "select `utr`.`id` from `tbl_user_tenant_roles` `utr` inner join `tbl_roles` `r` on `r`.`id`=`utr`.`roleId` and `r`.`isOwnerRole`=1 inner join `tbl_user_tenants` `ut` on `ut`.`tenantId`=`utr`.`tenantId` and `ut`.`userId`=`utr`.`userId` and `ut`.`isActive`=1 and `ut`.`membershipStatus`='active' where `utr`.`tenantId`=? and `utr`.`userId`<>? and `utr`.`isActive`=1 limit 1"
          }
        },
        "output": true,
        "outputType": "array"
      },
      {
        "name": "protectFinalOwner",
        "module": "core",
        "action": "condition",
        "options": {
          "if": "{{targetOwnerRole.count()>0 && selectedOwnerRole.count()==0 && otherActiveOwners.count()==0}}",
          "then": {
            "steps": {
              "name": "lastOwnerDenied",
              "module": "core",
              "action": "error",
              "options": {
                "status": 409,
                "message": "The final active owner cannot have the owner role removed."
              }
            }
          }
        },
        "outputType": "boolean"
      },
      {
        "name": "existingRoles",
        "module": "dbconnector",
        "action": "select",
        "options": {
          "connection": "db",
          "sql": {
            "type": "SELECT",
            "columns": [
              {
                "table": "tbl_user_tenant_roles",
                "column": "id"
              },
              {
                "table": "tbl_user_tenant_roles",
                "column": "roleId"
              }
            ],
            "table": {
              "name": "tbl_user_tenant_roles"
            },
            "primary": "id",
            "joins": [],
            "params": [
              {
                "name": ":P1",
                "type": "expression",
                "value": "{{$_POST.userId}}"
              },
              {
                "name": ":P2",
                "type": "expression",
                "value": "{{$_SESSION.TENANT_ID.default(0)}}"
              }
            ],
            "query": "select `id`,`roleId` from `tbl_user_tenant_roles` where `userId`=? and `tenantId`=?"
          }
        },
        "output": true,
        "outputType": "array"
      },
      {
        "name": "updateRoleTransaction",
        "module": "dbupdater",
        "action": "transaction",
        "options": {
          "connection": "db",
          "exec": {
            "steps": [
              {
                "name": "deactivateExistingRoles",
                "module": "core",
                "action": "repeat",
                "options": {
                  "repeat": "{{existingRoles}}",
                  "exec": {
                    "steps": {
                      "name": "setExistingRoleState",
                      "module": "dbupdater",
                      "action": "update",
                      "options": {
                        "connection": "db",
                        "sql": {
                          "type": "update",
                          "table": "tbl_user_tenant_roles",
                          "values": [
                            {
                              "table": "tbl_user_tenant_roles",
                              "column": "isActive",
                              "type": "boolean",
                              "value": "{{$_POST.roleIds.contains(roleId)?1:0}}"
                            },
                            {
                              "table": "tbl_user_tenant_roles",
                              "column": "isPrimary",
                              "type": "boolean",
                              "value": "{{$_POST.roleIds[0]==roleId?1:0}}"
                            }
                          ],
                          "wheres": {
                            "condition": "AND",
                            "rules": [
                              {
                                "id": "id",
                                "field": "id",
                                "type": "double",
                                "operator": "equal",
                                "value": "{{id}}",
                                "data": {
                                  "table": "tbl_user_tenant_roles",
                                  "column": "id",
                                  "type": "number"
                                },
                                "operation": "="
                              }
                            ],
                            "conditional": null,
                            "valid": true
                          },
                          "query": "update `tbl_user_tenant_roles` set `isActive` = ?, `isPrimary` = ? where `id` = ?"
                        }
                      },
                      "output": true,
                      "outputType": "object"
                    }
                  }
                },
                "output": true,
                "outputType": "array"
              },
              {
                "name": "activateSelectedRoles",
                "module": "core",
                "action": "repeat",
                "options": {
                  "repeat": "{{$_POST.roleIds}}",
                  "exec": {
                    "steps": [
                      {
                        "name": "existingSelectedRole",
                        "module": "dbconnector",
                        "action": "select",
                        "options": {
                          "connection": "db",
                          "sql": {
                            "type": "SELECT",
                            "columns": [
                              {
                                "table": "tbl_user_tenant_roles",
                                "column": "id"
                              }
                            ],
                            "table": {
                              "name": "tbl_user_tenant_roles"
                            },
                            "primary": "id",
                            "joins": [],
                            "params": [
                              {
                                "name": ":P1",
                                "type": "expression",
                                "value": "{{$_POST.userId}}"
                              },
                              {
                                "name": ":P2",
                                "type": "expression",
                                "value": "{{$_SESSION.TENANT_ID}}"
                              },
                              {
                                "name": ":P3",
                                "type": "expression",
                                "value": "{{$value}}"
                              }
                            ],
                            "query": "select `id` from `tbl_user_tenant_roles` where `userId`=? and `tenantId`=? and `roleId`=? limit 1"
                          }
                        },
                        "output": true,
                        "outputType": "array"
                      },
                      {
                        "name": "createMissingRole",
                        "module": "core",
                        "action": "condition",
                        "options": {
                          "if": "{{existingSelectedRole.count()==0}}",
                          "then": {
                            "steps": {
                              "name": "insertRole",
                              "module": "dbupdater",
                              "action": "insert",
                              "options": {
                                "connection": "db",
                                "sql": {
                                  "type": "insert",
                                  "table": "tbl_user_tenant_roles",
                                  "returning": "id",
                                  "values": [
                                    {
                                      "table": "tbl_user_tenant_roles",
                                      "column": "userId",
                                      "type": "number",
                                      "value": "{{$_POST.userId}}"
                                    },
                                    {
                                      "table": "tbl_user_tenant_roles",
                                      "column": "tenantId",
                                      "type": "number",
                                      "value": "{{$_SESSION.TENANT_ID}}"
                                    },
                                    {
                                      "table": "tbl_user_tenant_roles",
                                      "column": "roleId",
                                      "type": "number",
                                      "value": "{{$value}}"
                                    },
                                    {
                                      "table": "tbl_user_tenant_roles",
                                      "column": "isPrimary",
                                      "type": "boolean",
                                      "value": "{{$index==0?1:0}}"
                                    },
                                    {
                                      "table": "tbl_user_tenant_roles",
                                      "column": "isActive",
                                      "type": "boolean",
                                      "value": "1"
                                    }
                                  ],
                                  "query": "insert into `tbl_user_tenant_roles` (`userId`,`tenantId`,`roleId`,`isPrimary`,`isActive`) values (?,?,?,?,?)"
                                }
                              },
                              "output": true,
                              "outputType": "object"
                            }
                          }
                        },
                        "outputType": "boolean"
                      }
                    ]
                  }
                },
                "output": true,
                "outputType": "array"
              },
              {
                "name": "auditRoles",
                "module": "dbupdater",
                "action": "insert",
                "options": {
                  "connection": "db",
                  "sql": {
                    "type": "insert",
                    "table": "tbl_activity_log",
                    "returning": "id",
                    "values": [
                      {
                        "table": "tbl_activity_log",
                        "column": "tenantId",
                        "type": "number",
                        "value": "{{$_SESSION.TENANT_ID}}"
                      },
                      {
                        "table": "tbl_activity_log",
                        "column": "userId",
                        "type": "number",
                        "value": "{{$_SESSION.USER_ID}}"
                      },
                      {
                        "table": "tbl_activity_log",
                        "column": "targetUserId",
                        "type": "number",
                        "value": "{{$_POST.userId}}"
                      },
                      {
                        "table": "tbl_activity_log",
                        "column": "entityType",
                        "type": "text",
                        "value": "user"
                      },
                      {
                        "table": "tbl_activity_log",
                        "column": "entityId",
                        "type": "number",
                        "value": "{{$_POST.userId}}"
                      },
                      {
                        "table": "tbl_activity_log",
                        "column": "actionType",
                        "type": "text",
                        "value": "user.roles.updated"
                      },
                      {
                        "table": "tbl_activity_log",
                        "column": "summary",
                        "type": "text",
                        "value": "{{$_SESSION.DISPLAY_NAME.default('A user')+' updated tenant roles for user '+$_POST.userId}}"
                      }
                    ],
                    "query": "insert into `tbl_activity_log` (`tenantId`,`userId`,`targetUserId`,`entityType`,`entityId`,`actionType`,`summary`) values (?,?,?,?,?,?,?)"
                  }
                },
                "output": true,
                "outputType": "object"
              }
            ]
          }
        },
        "output": true
      },
      {
        "name": "result",
        "module": "core",
        "action": "response",
        "options": {
          "status": 200,
          "data": {
            "success": true,
            "message": "Tenant roles updated."
          }
        }
      }
    ]
  }
}
