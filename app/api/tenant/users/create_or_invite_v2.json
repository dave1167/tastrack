{
  "settings":{"options":{"method":"post","restrict":{"provider":"security"}}},
  "meta":{"$_POST":[
    {"type":"text","name":"firstName","options":{"rules":{"core:required":{"param":""}}}},
    {"type":"text","name":"lastName","options":{"rules":{"core:required":{"param":""}}}},
    {"type":"text","name":"email","options":{"rules":{"core:required":{"param":""},"core:email":{}}}},
    {"type":"number","name":"roleIds","multiple":true,"options":{"rules":{"core:required":{"param":""}}}}
  ]},
  "exec":{"steps":[{"name":"requireTenantLifecycleWrite","module":"tenantLifecycle","action":"requireWrite","options":{"tenantId":"{{$_SESSION.TENANT_ID.default(0)}}","userId":"{{$_SESSION.USER_ID.default(0)}}","requireMembership":true},"output":false},
    {"name":"permissionGrant","module":"dbupdater","action":"custom","options":{"connection":"db","sql":{"query":"SELECT rp.id AS grantId FROM tbl_user_tenants ut INNER JOIN tbl_user_tenant_roles utr ON utr.userId=ut.userId AND utr.tenantId=ut.tenantId AND utr.isActive=1 INNER JOIN tbl_role_permissions rp ON rp.roleId=utr.roleId INNER JOIN tbl_permissions p ON p.id=rp.permissionId AND p.permissionCode IN ('tenant.users.create','tenant.users.invite') AND p.isActive=1 WHERE ut.userId=:userId AND ut.tenantId=:tenantId AND ut.isActive=1 AND ut.membershipStatus='active' LIMIT 1","params":[{"name":":userId","value":"{{$_SESSION.USER_ID.default(0)}}"},{"name":":tenantId","value":"{{$_SESSION.TENANT_ID.default(0)}}"}]}},"output":true,"outputType":"array"},
    {"name":"requirePermission","module":"core","action":"condition","options":{"if":"{{permissionGrant.count()==0}}","then":{"steps":{"name":"denied","module":"core","action":"response","options":{"status":403,"data":{"success":false,"message":"You do not have permission to invite users."}}}}},"outputType":"boolean"},
    {"name":"requireRoles","module":"core","action":"condition","options":{"if":"{{$_POST.roleIds.count()==0}}","then":{"steps":{"name":"rolesRequired","module":"core","action":"response","options":{"status":400,"data":{"success":false,"message":"Select at least one tenant role."}}}}},"outputType":"boolean"},
    {"name":"existingUser","module":"dbupdater","action":"custom","options":{"connection":"db","sql":{"query":"SELECT id,isActive FROM tbl_users WHERE LOWER(email)=:email LIMIT 1","params":[{"name":":email","value":"{{$_POST.email.lowercase().trim()}}"}]}},"output":true,"outputType":"array"},
    {"name":"existingMembership","module":"dbupdater","action":"custom","options":{"connection":"db","sql":{"query":"SELECT ut.id,ut.membershipStatus,ut.isActive FROM tbl_user_tenants ut WHERE ut.userId=:userId AND ut.tenantId=:tenantId LIMIT 1","params":[{"name":":userId","value":"{{existingUser[0].id.default(0)}}"},{"name":":tenantId","value":"{{$_SESSION.TENANT_ID}}"}]}},"output":true,"outputType":"array"},
    {"name":"rejectExistingMembership","module":"core","action":"condition","options":{"if":"{{existingMembership.count()>0}}","then":{"steps":{"name":"alreadyMember","module":"core","action":"response","options":{"status":409,"data":{"success":false,"message":"This user already belongs to this organisation. Open their existing user record instead."}}}}},"outputType":"boolean"},
    {"name":"validateRoles","module":"core","action":"repeat","options":{"repeat":"{{$_POST.roleIds}}","exec":{"steps":[
      {"name":"validRole","module":"dbupdater","action":"custom","options":{"connection":"db","sql":{"query":"SELECT r.id FROM tbl_roles r WHERE r.id=:roleId AND r.isActive=1 AND (r.tenantId=:tenantId OR (r.tenantId IS NULL AND r.isProtected=1)) AND (r.isAssignable=1 OR (r.isOwnerRole=1 AND EXISTS (SELECT 1 FROM tbl_user_tenant_roles om INNER JOIN tbl_roles ownerRole ON ownerRole.id=om.roleId AND ownerRole.isOwnerRole=1 WHERE om.userId=:actorUserId AND om.tenantId=:ownerTenantId AND om.isActive=1))) AND NOT EXISTS (SELECT 1 FROM tbl_role_permissions targetRp WHERE targetRp.roleId=r.id AND NOT EXISTS (SELECT 1 FROM tbl_user_tenant_roles actorMap INNER JOIN tbl_role_permissions actorRp ON actorRp.roleId=actorMap.roleId AND actorRp.permissionId=targetRp.permissionId WHERE actorMap.userId=:permissionUserId AND actorMap.tenantId=:permissionTenantId AND actorMap.isActive=1)) LIMIT 1","params":[{"name":":roleId","value":"{{$value}}"},{"name":":tenantId","value":"{{$_SESSION.TENANT_ID}}"},{"name":":actorUserId","value":"{{$_SESSION.USER_ID}}"},{"name":":ownerTenantId","value":"{{$_SESSION.TENANT_ID}}"},{"name":":permissionUserId","value":"{{$_SESSION.USER_ID}}"},{"name":":permissionTenantId","value":"{{$_SESSION.TENANT_ID}}"}]}},"output":true,"outputType":"array"},
      {"name":"rejectRole","module":"core","action":"condition","options":{"if":"{{validRole.count()==0}}","then":{"steps":{"name":"invalidRole","module":"core","action":"response","options":{"status":403,"data":{"success":false,"message":"One of the selected roles is not available for you to assign."}}}}},"outputType":"boolean"}
    ]}},"output":true,"outputType":"array"},
    {"name":"inviteCode","module":"crypto","action":"uuid","options":{},"output":true,"outputType":"text"},
    {"name":"saveInvite","module":"dbupdater","action":"transaction","options":{"connection":"db","exec":{"steps":[
      {"name":"createUserWhenNeeded","module":"core","action":"condition","options":{"if":"{{existingUser.count()==0}}","then":{"steps":{"name":"createUser","module":"dbupdater","action":"insert","options":{"connection":"db","sql":{"type":"insert","table":"tbl_users","returning":"id","values":[{"table":"tbl_users","column":"email","type":"text","value":"{{$_POST.email.trim().lowercase()}}"},{"table":"tbl_users","column":"fName","type":"text","value":"{{$_POST.firstName.trim().lowercase().capitalize()}}"},{"table":"tbl_users","column":"lName","type":"text","value":"{{$_POST.lastName.trim().lowercase().capitalize()}}"},{"table":"tbl_users","column":"displayName","type":"text","value":"{{$_POST.firstName.trim().lowercase().capitalize()+' '+$_POST.lastName.trim().lowercase().capitalize()}}"},{"table":"tbl_users","column":"isActive","type":"boolean","value":"1"},{"table":"tbl_users","column":"verifycode","type":"text","value":"{{inviteCode}}"}]}},"output":true,"outputType":"object"}}},"output":true,"outputType":"boolean"},
      {"name":"targetUser","module":"dbupdater","action":"custom","options":{"connection":"db","sql":{"query":"SELECT id FROM tbl_users WHERE LOWER(email)=:email LIMIT 1","params":[{"name":":email","value":"{{$_POST.email.lowercase().trim()}}"}]}},"output":true,"outputType":"array"},
      {"name":"targetUserId","module":"core","action":"setvalue","options":{"value":"{{targetUser[0].id}}","type":"number"},"output":true,"outputType":"number"},
      {"name":"createMembership","module":"dbupdater","action":"insert","options":{"connection":"db","sql":{"type":"insert","table":"tbl_user_tenants","returning":"id","values":[{"table":"tbl_user_tenants","column":"tenantId","type":"number","value":"{{$_SESSION.TENANT_ID}}"},{"table":"tbl_user_tenants","column":"userId","type":"number","value":"{{targetUserId}}"},{"table":"tbl_user_tenants","column":"membershipStatus","type":"text","value":"invited"},{"table":"tbl_user_tenants","column":"isActive","type":"boolean","value":"1"},{"table":"tbl_user_tenants","column":"invitedByUserId","type":"number","value":"{{$_SESSION.USER_ID}}"},{"table":"tbl_user_tenants","column":"invitedDate","type":"datetime","value":"{{NOW}}"}]}},"output":true,"outputType":"object"},
      {"name":"assignRoles","module":"core","action":"repeat","options":{"repeat":"{{$_POST.roleIds}}","exec":{"steps":{"name":"assignRole","module":"dbupdater","action":"insert","options":{"connection":"db","sql":{"type":"insert","table":"tbl_user_tenant_roles","returning":"id","values":[{"table":"tbl_user_tenant_roles","column":"userId","type":"number","value":"{{targetUserId}}"},{"table":"tbl_user_tenant_roles","column":"tenantId","type":"number","value":"{{$_SESSION.TENANT_ID}}"},{"table":"tbl_user_tenant_roles","column":"roleId","type":"number","value":"{{$value}}"},{"table":"tbl_user_tenant_roles","column":"isPrimary","type":"boolean","value":"{{$index==0?1:0}}"},{"table":"tbl_user_tenant_roles","column":"isActive","type":"boolean","value":"1"}]}},"output":true,"outputType":"object"}}},"output":true,"outputType":"array"},
      {"name":"auditInvite","module":"dbupdater","action":"insert","options":{"connection":"db","sql":{"type":"insert","table":"tbl_activity_log","returning":"id","values":[{"table":"tbl_activity_log","column":"tenantId","type":"number","value":"{{$_SESSION.TENANT_ID}}"},{"table":"tbl_activity_log","column":"userId","type":"number","value":"{{$_SESSION.USER_ID}}"},{"table":"tbl_activity_log","column":"targetUserId","type":"number","value":"{{targetUserId}}"},{"table":"tbl_activity_log","column":"entityType","type":"text","value":"user"},{"table":"tbl_activity_log","column":"entityId","type":"number","value":"{{targetUserId}}"},{"table":"tbl_activity_log","column":"actionType","type":"text","value":"user.invited"},{"table":"tbl_activity_log","column":"summary","type":"text","value":"{{$_SESSION.DISPLAY_NAME.default('A user')+' invited '+$_POST.email.lowercase().trim()}}"}]}},"output":true,"outputType":"object"}
    ]}},"output":true},
    {"name":"result","module":"core","action":"response","options":{"status":201,"data":{"success":true,"userId":"{{saveInvite.targetUserId}}","membershipId":"{{saveInvite.createMembership.identity}}","message":"User invitation created."}}}
  ]}
}
