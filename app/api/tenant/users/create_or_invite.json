      {"name":"rejectRole","module":"core","action":"condition","options":{"if":"{{validRole.count()==0}}","then":{"steps":{"name":"invalidRole","module":"core","action":"response","options":{"status":403,"data":{"success":false,"errorCode":"ROLE_NOT_ASSIGNABLE","message":"One of the selected roles is not available for you to assign."}}}}},"outputType":"boolean"}
    ]}},"output":true,"outputType":"array"},
    {"name":"existingUser","module":"dbconnector","action":"select","options":{"connection":"db","sql":{"type":"SELECT","columns":[{"table":"tbl_users","column":"id"},{"table":"tbl_users","column":"isActive"}],"table":{"name":"tbl_users"},"primary":"id","joins":[],"params":[{"name":":P1","type":"expression","value":"{{$_POST.email.lowercase().trim()}}"}],"query":"select `id`,`isActive` from `tbl_users` where `email`=? limit 1"}},"output":true,"outputType":"array"},
    {"name":"existingMembership","module":"dbconnector","action":"select","options":{"connection":"db","sql":{"type":"SELECT","columns":[{"table":"tbl_user_tenants","column":"id"},{"table":"tbl_user_tenants","column":"membershipStatus"},{"table":"tbl_user_tenants","column":"isActive"}],"table":{"name":"tbl_user_tenants"},"primary":"id","joins":[],"params":[{"name":":P1","type":"expression","value":"{{existingUser[0].id.default(0)}}"},{"name":":P2","type":"expression","value":"{{$_SESSION.TENANT_ID.default(0)}}"}],"query":"select `id`,`membershipStatus`,`isActive` from `tbl_user_tenants` where `userId`=? and `tenantId`=? limit 1"}},"output":true,"outputType":"array"},
    {"name":"rejectExistingMembership","module":"core","action":"condition","options":{"if":"{{existingMembership.count()>0}}","then":{"steps":{"name":"alreadyMember","module":"core","action":"response","options":{"status":409,"data":{"success":false,"errorCode":"MEMBERSHIP_EXISTS","message":"This user already belongs to this organisation. Open their existing user record to edit or reactivate it."}}}}},"outputType":"boolean"},
