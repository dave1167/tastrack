    {"name":"permissionGrant","module":"dbconnector","action":"select","options":{"connection":"db","sql":{"type":"SELECT","columns":[{"table":"tbl_role_permissions","column":"id","field":"grantId"}],"table":{"name":"tbl_role_permissions"},"primary":"id","joins":[],"params":[{"name":":P1","type":"expression","value":"{{$_SESSION.USER_ID.default(0)}}"},{"name":":P2","type":"expression","value":"{{$_SESSION.TENANT_ID.default(0)}}"}],"query":"select `rp`.`id` as `grantId` from `tbl_user_tenants` `ut` inner join `tbl_user_tenant_roles` `utr` on `utr`.`userId`=`ut`.`userId` and `utr`.`tenantId`=`ut`.`tenantId` and `utr`.`isActive`=1 inner join `tbl_role_permissions` `rp` on `rp`.`roleId`=`utr`.`roleId` inner join `tbl_permissions` `p` on `p`.`id`=`rp`.`permissionId` and `p`.`permissionCode` in ('tenant.users.create','tenant.users.invite') and `p`.`isActive`=1 where `ut`.`userId`=? and `ut`.`tenantId`=? and `ut`.`isActive`=1 and `ut`.`membershipStatus`='active' limit 1"}},"output":true,"outputType":"array"},
    {"name":"requirePermission","module":"core","action":"condition","options":{"if":"{{permissionGrant.count()==0}}","then":{"steps":{"name":"denied","module":"core","action":"response","options":{"status":403,"data":{"success":false,"errorCode":"PERMISSION_DENIED","message":"You do not have permission to create or invite users."}}}}},"outputType":"boolean"},
