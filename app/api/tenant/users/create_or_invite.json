      {"name":"targetUserId","module":"core","action":"setvalue","options":{"value":"{{existingUser[0].id.default(createUser.identity)}}","type":"number"},"output":true,"outputType":"number"},
      {"name":"createMembership","module":"dbupdater","action":"insert","options":{"connection":"db","sql":{"type":"insert","table":"tbl_user_tenants","returning":"id","values":[{"table":"tbl_user_tenants","column":"tenantId","type":"number","value":"{{$_SESSION.TENANT_ID}}"},{"table":"tbl_user_tenants","column":"userId","type":"number","value":"{{targetUserId}}"},{"table":"tbl_user_tenants","column":"membershipStatus","type":"text","value":"invited"},{"table":"tbl_user_tenants","column":"isActive","type":"boolean","value":"1"},{"table":"tbl_user_tenants","column":"invitedByUserId","type":"number","value":"{{$_SESSION.USER_ID}}"},{"table":"tbl_user_tenants","column":"invitedDate","type":"datetime","value":"{{NOW}}"}],"query":"insert into `tbl_user_tenants` (`tenantId`,`userId`,`membershipStatus`,`isActive`,`invitedByUserId`,`invitedDate`) values (?,?,?,?,?,CURRENT_TIMESTAMP)"}},"output":true,"outputType":"object"},
      {"name":"assignRoles","module":"core","action":"repeat","options":{"repeat":"{{$_POST.roleIds}}","exec":{"steps":{"name":"assignRole","module":"dbupdater","action":"insert","options":{"connection":"db","sql":{"type":"insert","table":"tbl_user_tenant_roles","returning":"id","values":[{"table":"tbl_user_tenant_roles","column":"userId","type":"number","value":"{{targetUserId}}"},{"table":"tbl_user_tenant_roles","column":"tenantId","type":"number","value":"{{$_SESSION.TENANT_ID}}"},{"table":"tbl_user_tenant_roles","column":"roleId","type":"number","value":"{{$value}}"},{"table":"tbl_user_tenant_roles","column":"isPrimary","type":"boolean","value":"{{$index==0?1:0}}"},{"table":"tbl_user_tenant_roles","column":"isActive","type":"boolean","value":"1"}],"query":"insert into `tbl_user_tenant_roles` (`userId`,`tenantId`,`roleId`,`isPrimary`,`isActive`) values (?,?,?,?,?)"}},"output":true,"outputType":"object"}}},"output":true,"outputType":"array"},
      {"name":"auditInvite","module":"dbupdater","action":"insert","options":{"connection":"db","sql":{"type":"insert","table":"tbl_activity_log","returning":"id","values":[{"table":"tbl_activity_log","column":"tenantId","type":"number","value":"{{$_SESSION.TENANT_ID}}"},{"table":"tbl_activity_log","column":"userId","type":"number","value":"{{$_SESSION.USER_ID}}"},{"table":"tbl_activity_log","column":"targetUserId","type":"number","value":"{{targetUserId}}"},{"table":"tbl_activity_log","column":"entityType","type":"text","value":"user"},{"table":"tbl_activity_log","column":"entityId","type":"number","value":"{{targetUserId}}"},{"table":"tbl_activity_log","column":"actionType","type":"text","value":"user.invited"},{"table":"tbl_activity_log","column":"summary","type":"text","value":"{{$_SESSION.DISPLAY_NAME.default('A user')+' invited '+$_POST.email.lowercase().trim()}}"}],"query":"insert into `tbl_activity_log` (`tenantId`,`userId`,`targetUserId`,`entityType`,`entityId`,`actionType`,`summary`) values (?,?,?,?,?,?,?)"}},"output":true,"outputType":"object"}
    ]}},"output":true},
    {"name":"result","module":"core","action":"response","options":{"status":201,"data":{"success":true,"userId":"{{createMembershipTransaction.targetUserId}}","membershipId":"{{createMembershipTransaction.createMembership.identity}}","message":"The user membership and selected roles were created. Email delivery can be attached to this invitation record."}}}
