{
  "settings": {
    "options": {
      "nocsrf": true,
      "method": "post"
    }
  },
  "meta": {
    "$_POST": [
      {"type": "text", "name": "username"},
      {"type": "text", "name": "password"}
    ]
  },
  "exec": {
    "steps": [
      {
        "name": "identity",
        "module": "auth",
        "action": "login",
        "options": {
          "provider": "security",
          "username": "{{$_POST.username}}",
          "password": "{{$_POST.password}}",
          "remember": "0"
        },
        "output": true
      },
      {
        "name": "platformAdmin",
        "module": "dbupdater",
        "action": "custom",
        "options": {
          "connection": "db",
          "sql": {
            "query": "SELECT id,fName,lName,displayName FROM tbl_users WHERE id=:userId AND isActive=1 AND isPlatformAdmin=1 LIMIT 1",
            "params": [
              {"name": ":userId", "value": "{{identity}}"}
            ]
          }
        },
        "output": true,
        "outputType": "array"
      },
      {
        "module": "core",
        "action": "condition",
        "options": {
          "if": "{{platformAdmin.count() == 0}}",
          "then": {
            "steps": {
              "module": "core",
              "action": "error",
              "options": {
                "status": 403,
                "message": "This account is not authorised for platform administration."
              }
            }
          }
        }
      },
      {
        "name": "tenantContext",
        "module": "dbupdater",
        "action": "custom",
        "options": {
          "connection": "db",
          "sql": {
            "query": "SELECT ut.tenantId,t.tenantName,r.id roleId,r.roleName,r.roleKey FROM tbl_user_tenants ut INNER JOIN tbl_tenants t ON t.id=ut.tenantId AND t.isActive=1 LEFT JOIN tbl_user_tenant_roles utr ON utr.userId=ut.userId AND utr.tenantId=ut.tenantId AND utr.isActive=1 LEFT JOIN tbl_roles r ON r.id=utr.roleId AND r.isActive=1 WHERE ut.userId=:userId AND ut.isActive=1 AND ut.membershipStatus='active' ORDER BY CASE WHEN ut.tenantId=NULLIF(:currentTenant,0) THEN 0 ELSE 1 END,COALESCE(utr.isPrimary,0) DESC,ut.id DESC,COALESCE(r.id,0) LIMIT 1",
            "params": [
              {"name": ":userId", "value": "{{identity}}"},
              {"name": ":currentTenant", "value": "{{$_SESSION.TENANT_ID.default(0)}}"}
            ]
          }
        },
        "output": true,
        "outputType": "array"
      },
      {
        "name": "USER_ID",
        "module": "core",
        "action": "setsession",
        "options": {"value": "{{identity}}"}
      },
      {
        "name": "FNAME",
        "module": "core",
        "action": "setsession",
        "options": {"value": "{{platformAdmin[0].fName}}"}
      },
      {
        "name": "LNAME",
        "module": "core",
        "action": "setsession",
        "options": {"value": "{{platformAdmin[0].lName}}"}
      },
      {
        "name": "DISPLAY_NAME",
        "module": "core",
        "action": "setsession",
        "options": {"value": "{{platformAdmin[0].displayName}}"}
      },
      {
        "name": "TENANT_ID",
        "module": "core",
        "action": "setsession",
        "options": {"value": "{{tenantContext[0].tenantId.default('')}}"}
      },
      {
        "name": "TENANT_NAME",
        "module": "core",
        "action": "setsession",
        "options": {"value": "{{tenantContext[0].tenantName.default('')}}"}
      },
      {
        "name": "ROLE_ID",
        "module": "core",
        "action": "setsession",
        "options": {"value": "{{tenantContext[0].roleId.default('')}}"}
      },
      {
        "name": "ROLE_NAME",
        "module": "core",
        "action": "setsession",
        "options": {"value": "{{tenantContext[0].roleName.default('')}}"}
      },
      {
        "name": "ROLE_KEY",
        "module": "core",
        "action": "setsession",
        "options": {"value": "{{tenantContext[0].roleKey.default('')}}"}
      },
      {
        "module": "core",
        "action": "redirect",
        "options": {
          "url": "/platform/modules",
          "status": 302
        }
      }
    ]
  }
}
