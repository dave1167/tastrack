{
  "settings": {
    "options": {
      "nocsrf": true,
      "method": "get"
    }
  },
  "exec": {
    "steps": [
      {
        "module": "auth",
        "action": "logout",
        "options": {
          "provider": "security"
        }
      },
      {
        "module": "core",
        "action": "redirect",
        "options": {
          "url": "/platform/login",
          "status": 302
        }
      }
    ]
  }
}
