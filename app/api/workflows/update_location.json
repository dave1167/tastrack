{
  "settings": {
    "options": {"restrict":{"provider":"security"},
      "method": "post"
    }
  },
  "meta": {
    "$_POST": [
      {
        "type": "number",
        "name": "workflowId"
      },
      {
        "type": "number",
        "name": "rowVersion"
      },
      {
        "type": "number",
        "name": "locationId"
      },
      {
        "type": "number",
        "name": "spaceId"
      },
      {
        "type": "number",
        "name": "configurationId"
      }
    ]
  },
  "exec": {
    "steps": [
      {
        "name": "requireLocations",
        "module": "tenantModule",
        "action": "require",
        "options": {"moduleCode": "LOCATIONS", "tenantId": "{{$_SESSION.TENANT_ID.default(0)}}", "userId": "{{$_SESSION.USER_ID.default(0)}}"},
        "output": true
      },
      {
        "name": "locationBefore",
        "module": "dbupdater",
        "action": "custom",
        "options": {
          "connection": "db",
          "sql": {
            "query": "SELECT w.id,w.workflowName,w.locationId,w.spaceId,w.configurationId,w.rowVersion,l.locationName,s.spaceName,c.configurationName FROM tbl_workflows w LEFT JOIN tbl_locations l ON l.id=w.locationId AND l.tenantId=w.tenantId LEFT JOIN tbl_spaces s ON s.id=w.spaceId AND s.tenantId=w.tenantId LEFT JOIN tbl_space_configurations c ON c.id=w.configurationId AND c.tenantId=w.tenantId WHERE w.id=:workflowId AND w.tenantId=:tenantId LIMIT 1",
            "params": [
              {
                "name": ":workflowId",
                "value": "{{$_POST.workflowId}}"
              },
              {
                "name": ":tenantId",
                "value": "{{$_SESSION.TENANT_ID}}"
              }
            ]
          }
        },
        "output": true,
        "outputType": "array"
      },
      {
        "name": "updateLocation",
        "module": "dbupdater",
        "action": "custom",
        "options": {
          "connection": "db",
          "sql": {
            "query": "UPDATE tbl_workflows w SET w.locationId=(SELECT l.id FROM tbl_locations l WHERE l.id=NULLIF(:locationId,'') AND l.tenantId=w.tenantId LIMIT 1),w.spaceId=(SELECT s.id FROM tbl_spaces s WHERE s.id=NULLIF(:spaceId,'') AND s.locationId=NULLIF(:locationId2,'') AND s.tenantId=w.tenantId LIMIT 1),w.configurationId=(SELECT c.id FROM tbl_space_configurations c WHERE c.id=NULLIF(:configurationId,'') AND c.spaceId=NULLIF(:spaceId2,'') AND c.tenantId=w.tenantId LIMIT 1),w.rowVersion=w.rowVersion+1,w.modifiedByUserId=:modifiedByUserId,w.modifiedDate=CURRENT_TIMESTAMP WHERE w.id=:workflowId AND w.tenantId=:tenantId AND w.rowVersion=:rowVersion",
            "params": [
              {
                "name": ":locationId",
                "value": "{{$_POST.locationId.default('')}}"
              },
              {
                "name": ":spaceId",
                "value": "{{$_POST.spaceId.default('')}}"
              },
              {
                "name": ":locationId2",
                "value": "{{$_POST.locationId.default('')}}"
              },
              {
                "name": ":configurationId",
                "value": "{{$_POST.configurationId.default('')}}"
              },
              {
                "name": ":spaceId2",
                "value": "{{$_POST.spaceId.default('')}}"
              },
              {
                "name": ":modifiedByUserId",
                "value": "{{$_SESSION.USER_ID}}"
              },
              {
                "name": ":workflowId",
                "value": "{{$_POST.workflowId}}"
              },
              {
                "name": ":tenantId",
                "value": "{{$_SESSION.TENANT_ID}}"
              },
              {
                "name": ":rowVersion",
                "value": "{{$_POST.rowVersion}}"
              }
            ]
          }
        },
        "output": true
      },
      {
        "name": "rejectLocationConflict",
        "module": "core",
        "action": "condition",
        "options": {
          "if": "{{updateLocation.affectedRows != 1}}",
          "then": {
            "steps": {
              "name": "locationConflictResponse",
              "module": "core",
              "action": "response",
              "options": {
                "status": 409,
                "data": {
                  "success": false,
                  "conflict": true,
                  "message": "This event was changed by another user. The location has not been saved."
                }
              }
            }
          }
        },
        "outputType": "boolean"
      },
      {
        "name": "locationAfter",
        "module": "dbupdater",
        "action": "custom",
        "options": {
          "connection": "db",
          "sql": {
            "query": "SELECT w.locationId,w.spaceId,w.configurationId,l.locationName,s.spaceName,c.configurationName FROM tbl_workflows w LEFT JOIN tbl_locations l ON l.id=w.locationId AND l.tenantId=w.tenantId LEFT JOIN tbl_spaces s ON s.id=w.spaceId AND s.tenantId=w.tenantId LEFT JOIN tbl_space_configurations c ON c.id=w.configurationId AND c.tenantId=w.tenantId WHERE w.id=:workflowId AND w.tenantId=:tenantId LIMIT 1",
            "params": [
              {
                "name": ":workflowId",
                "value": "{{$_POST.workflowId}}"
              },
              {
                "name": ":tenantId",
                "value": "{{$_SESSION.TENANT_ID}}"
              }
            ]
          }
        },
        "output": true,
        "outputType": "array"
      },
      {
        "name": "logWorkflowLocationChanged",
        "module": "dbupdater",
        "action": "custom",
        "options": {
          "connection": "db",
          "sql": {
            "query": "INSERT INTO tbl_activity_log (tenantId,userId,workflowId,entityType,entityId,actionType,summary,beforeJson,afterJson,createdDate) SELECT :tenantId,:userId,:workflowId,'workflow',:entityId,'workflow.location_changed',CONCAT(:actor,' changed the location for ',:workflowName),JSON_OBJECT('version',:oldVersion,'locationId',:oldLocationId,'locationName',:oldLocationName,'spaceId',:oldSpaceId,'spaceName',:oldSpaceName,'configurationId',:oldConfigurationId,'configurationName',:oldConfigurationName),JSON_OBJECT('version',:newVersion,'locationId',:newLocationId,'locationName',:newLocationName,'spaceId',:newSpaceId,'spaceName',:newSpaceName,'configurationId',:newConfigurationId,'configurationName',:newConfigurationName),CURRENT_TIMESTAMP FROM DUAL WHERE :affectedRows=1",
            "params": [
              {
                "name": ":tenantId",
                "value": "{{$_SESSION.TENANT_ID}}"
              },
              {
                "name": ":userId",
                "value": "{{$_SESSION.USER_ID}}"
              },
              {
                "name": ":workflowId",
                "value": "{{$_POST.workflowId}}"
              },
              {
                "name": ":entityId",
                "value": "{{$_POST.workflowId}}"
              },
              {
                "name": ":actor",
                "value": "{{$_SESSION.DISPLAY_NAME.default('A user')}}"
              },
              {
                "name": ":workflowName",
                "value": "{{locationBefore[0].workflowName}}"
              },
              {
                "name": ":oldVersion",
                "value": "{{locationBefore[0].rowVersion}}"
              },
              {
                "name": ":newVersion",
                "value": "{{$_POST.rowVersion + 1}}"
              },
              {
                "name": ":oldLocationId",
                "value": "{{locationBefore[0].locationId}}"
              },
              {
                "name": ":oldLocationName",
                "value": "{{locationBefore[0].locationName}}"
              },
              {
                "name": ":oldSpaceId",
                "value": "{{locationBefore[0].spaceId}}"
              },
              {
                "name": ":oldSpaceName",
                "value": "{{locationBefore[0].spaceName}}"
              },
              {
                "name": ":oldConfigurationId",
                "value": "{{locationBefore[0].configurationId}}"
              },
              {
                "name": ":oldConfigurationName",
                "value": "{{locationBefore[0].configurationName}}"
              },
              {
                "name": ":newLocationId",
                "value": "{{locationAfter[0].locationId}}"
              },
              {
                "name": ":newLocationName",
                "value": "{{locationAfter[0].locationName}}"
              },
              {
                "name": ":newSpaceId",
                "value": "{{locationAfter[0].spaceId}}"
              },
              {
                "name": ":newSpaceName",
                "value": "{{locationAfter[0].spaceName}}"
              },
              {
                "name": ":newConfigurationId",
                "value": "{{locationAfter[0].configurationId}}"
              },
              {
                "name": ":newConfigurationName",
                "value": "{{locationAfter[0].configurationName}}"
              },
              {
                "name": ":affectedRows",
                "value": "{{updateLocation.affectedRows.default(0)}}"
              }
            ]
          }
        },
        "output": true
      },
      {
        "name": "redirectAfterLocationUpdate",
        "module": "core",
        "action": "condition",
        "options": {
          "if": "{{updateLocation.affectedRows == 1}}",
          "then": {
            "steps": {
              "module": "core",
              "action": "redirect",
              "options": {
                "url": "/workflows/view?id={{$_POST.workflowId}}&section=info",
                "status": 302
              }
            }
          }
        },
        "outputType": "boolean"
      }
    ]
  }
}
