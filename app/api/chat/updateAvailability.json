{
  "settings":{"options":{"restrict":{"provider":"security"},"method":"post"}},
  "meta":{"$_POST":[{"type":"text","name":"chatAvailability"},{"type":"text","name":"chatStatusMessage"}]},
  "exec":{"steps":[
    {"name":"validStatus","module":"dbupdater","action":"custom","options":{"connection":"db","sql":{"query":"SELECT :availability chatAvailability,NULLIF(TRIM(:statusMessage),'') chatStatusMessage WHERE :availability2 IN ('available','do_not_disturb','unavailable') AND CHAR_LENGTH(TRIM(:statusMessage2))<=120 AND EXISTS(SELECT 1 FROM tbl_user_tenants ut WHERE ut.userId=:userId AND ut.tenantId=:tenantId AND ut.isActive=1 AND ut.membershipStatus='active')","params":[{"name":":availability","value":"{{$_POST.chatAvailability.default('')}}"},{"name":":statusMessage","value":"{{$_POST.chatStatusMessage.default('')}}"},{"name":":availability2","value":"{{$_POST.chatAvailability.default('')}}"},{"name":":statusMessage2","value":"{{$_POST.chatStatusMessage.default('')}}"},{"name":":userId","value":"{{$_SESSION.USER_ID.default(0)}}"},{"name":":tenantId","value":"{{$_SESSION.TENANT_ID.default(0)}}"}]}} ,"output":true,"outputType":"array"},
    {"name":"requireValidStatus","module":"core","action":"condition","options":{"if":"{{validStatus.count() == 0}}","then":{"steps":{"module":"core","action":"error","options":{"status":422,"message":"Choose a valid availability status. Status messages can contain up to 120 characters."}}}},"outputType":"boolean"},
    {"name":"updateStatus","module":"dbupdater","action":"custom","options":{"connection":"db","sql":{"query":"UPDATE tbl_user_tenants SET chatAvailability=:availability,chatStatusMessage=:statusMessage,chatStatusModifiedDate=CURRENT_TIMESTAMP WHERE userId=:userId AND tenantId=:tenantId AND isActive=1 AND membershipStatus='active'","params":[{"name":":availability","value":"{{validStatus[0].chatAvailability}}"},{"name":":statusMessage","value":"{{validStatus[0].chatStatusMessage}}"},{"name":":userId","value":"{{$_SESSION.USER_ID.default(0)}}"},{"name":":tenantId","value":"{{$_SESSION.TENANT_ID.default(0)}}"}]}} ,"output":true},
    {"name":"refreshStatusClients","module":"sockets","action":"refresh","options":{"action":"chat:changed","params":{"changed":true}}},
    {"name":"response","module":"core","action":"response","options":{"status":200,"data":{"success":true,"message":"Availability updated."}}}
  ]}
}
