  "exec": {
    "steps": [{"name":"requireTenantLifecycleWrite","module":"tenantLifecycle","action":"requireWrite","options":{"tenantId":"{{$_SESSION.TENANT_ID.default(0)}}","userId":"{{$_SESSION.USER_ID.default(0)}}","requireMembership":true},"output":false},
      {"name":"permissionGrant","module":"dbconnector","action":"select","options":{"connection":"db","sql":{"type":"SELECT","columns":[{"table":"tbl_role_permissions","column":"id","field":"grantId"}],"table":{"name":"tbl_role_permissions"},"primary":"id","joins":[],"params":[{"name":":P1","type":"expression","value":"{{$_SESSION.USER_ID.default(0)}}"},{"name":":P2","type":"expression","value":"{{$_SESSION.TENANT_ID.default(0)}}"},{"name":":P3","type":"expression","value":"contacts.manage"}],"query":"select `rp`.`id` as `grantId` from `tbl_user_tenants` as `ut` inner join `tbl_user_tenant_roles` as `utr` on `utr`.`tenantId`=`ut`.`tenantId` and `utr`.`userId`=`ut`.`userId` and `utr`.`isActive`=1 inner join `tbl_roles` as `r` on `r`.`id`=`utr`.`roleId` and `r`.`isActive`=1 and (`r`.`tenantId` is null or `r`.`tenantId`=`ut`.`tenantId`) inner join `tbl_role_permissions` as `rp` on `rp`.`roleId`=`r`.`id` inner join `tbl_permissions` as `p` on `p`.`id`=`rp`.`permissionId` and `p`.`isActive`=1 where `ut`.`userId`=? and `ut`.`tenantId`=? and `ut`.`isActive`=1 and `ut`.`membershipStatus`='active' and `p`.`permissionCode`=? limit 1"}},"output":true,"outputType":"array"},
      {"name":"requirePermission","module":"core","action":"condition","options":{"if":"{{permissionGrant.count() == 0}}","then":{"steps":{"module":"core","action":"response","options":{"status":403,"data":{"success":false,"message":"You do not have permission to create contacts."}}}}},"outputType":"boolean"},
      {
        "name": "insertContact",
        "module": "dbupdater",
        "action": "custom",
        "options": {
          "connection": "db",
          "sql": {
            "query": "INSERT INTO tbl_contacts (tenantId,contactCategoryId,contactType,organisationName,firstName,lastName,displayName,email,phone,addressLine1,addressLine2,city,region,postcode,country,notes,isActive) VALUES (:tenantId,(SELECT c.contactCategoryId FROM tbl_contact_categories c WHERE c.contactCategoryId=:categoryId AND c.tenantId=:categoryTenantId AND c.active=1 LIMIT 1),(SELECT c.categoryName FROM tbl_contact_categories c WHERE c.contactCategoryId=:categoryId2 AND c.tenantId=:categoryTenantId2 AND c.active=1 LIMIT 1),:organisationName,:firstName,:lastName,:displayName,:email,:phone,:addressLine1,:addressLine2,:city,:region,:postcode,:country,:notes,:isActive)",
            "params": [
              {
                "name": ":tenantId",
                "value": "{{$_SESSION.TENANT_ID}}"
              },
              {
                "name": ":categoryId",
                "value": "{{$_POST.contactCategoryId}}"
              },
              {
                "name": ":categoryTenantId",
                "value": "{{$_SESSION.TENANT_ID}}"
              },
              {
                "name": ":categoryId2",
                "value": "{{$_POST.contactCategoryId}}"
              },
              {
                "name": ":categoryTenantId2",
                "value": "{{$_SESSION.TENANT_ID}}"
              },
              {
                "name": ":organisationName",
                "value": "{{$_POST.organisationName}}"
              },
              {
                "name": ":firstName",
                "value": "{{$_POST.firstName.lowercase().capitalize()}}"
              },
              {
                "name": ":lastName",
                "value": "{{$_POST.lastName.lowercase().capitalize()}}"
              },
              {
                "name": ":displayName",
