{
  "settings":{"options":{"nocsrf":true,"method":"get"}},
  "meta":{"$_GET":[{"type":"number","name":"id"}]},
  "exec":{"steps":[
    {"name":"version","module":"dbupdater","action":"custom","options":{"connection":"db","sql":{"query":"SELECT cv.pdfStoragePath,cv.pdfFileName FROM tbl_contract_versions cv WHERE cv.id=:id AND cv.tenantId=:tenantId AND EXISTS(SELECT 1 FROM tbl_user_tenant_roles utr WHERE utr.userId=:userId AND utr.tenantId=cv.tenantId AND utr.isActive=1) LIMIT 1","params":[{"name":":id","value":"{{$_GET.id.default(0)}}"},{"name":":tenantId","value":"{{$_SESSION.TENANT_ID.default(0)}}"},{"name":":userId","value":"{{$_SESSION.USER_ID.default(0)}}"}]}},"output":false,"outputType":"array"},
    {"module":"core","action":"condition","options":{"if":"{{version.count() > 0}}","then":{"steps":[{"module":"fs","action":"download","options":{"path":"{{version[0].pdfStoragePath.startsWith('/') ? version[0].pdfStoragePath : '/' + version[0].pdfStoragePath}}","filename":"{{version[0].pdfFileName}}"}}]},"else":{"steps":[{"module":"core","action":"response","options":{"status":404,"data":"Contract version not found.","contentType":"text/plain"}}]}}}
  ]}
}
