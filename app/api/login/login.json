{
  "settings": {
    "options": {
      "nocsrf": true,
      "method": "post"
    }
  },
  "exec": {
    "steps": [
      {
        "name": "activeAccount",
        "module": "dbconnector",
        "action": "select",
        "options": {
          "connection": "db",
          "sql": {
            "type": "SELECT",
            "columns": [
              {
                "table": "tbl_users",
                "column": "id"
              },
              {
                "table": "tbl_users",
                "column": "email"
              }
            ],
            "table": {
              "name": "tbl_users"
            },
            "primary": "id",
            "joins": [],
            "params": [
              {
                "name": ":P1",
                "type": "expression",
                "value": "{{$_POST.username}}"
              }
            ],
            "query": "select `id`, `email` from `tbl_users` where `email` = ? and `isActive` = 1 limit 1"
          }
        },
        "output": true,
        "outputType": "array"
      },
      {
        "name": "identity",
        "module": "auth",
        "action": "login",
        "options": {
          "provider": "security",
          "username": "{{$_POST.username}}",
          "password": "{{$_POST.password}}",
          "remember": "{{$_POST.remember}}"
        },
        "output": true,
        "meta": []
      },
      {
        "name": "userAccess",
        "module": "dbupdater",
        "action": "custom",
        "options": {
          "connection": "db",
          "sql": {
            "query": "SELECT utr.userId,utr.tenantId,utr.roleId,utr.isPrimary,u.fName,u.lName,u.displayName,t.tenantName,r.roleName,r.roleKey FROM tbl_user_tenants ut INNER JOIN tbl_user_tenant_roles utr ON utr.userId=ut.userId AND utr.tenantId=ut.tenantId AND utr.isActive=1 INNER JOIN tbl_users u ON u.id=ut.userId AND u.isActive=1 INNER JOIN tbl_tenants t ON t.id=ut.tenantId AND t.isActive=1 AND t.lifecycleStatus NOT IN ('suspended','closed') INNER JOIN tbl_roles r ON r.id=utr.roleId AND r.isActive=1 WHERE ut.userId=:userId AND ut.actorType='human' AND ut.isActive=1 AND ut.membershipStatus='active' ORDER BY utr.isPrimary DESC,utr.tenantId,utr.roleId LIMIT 1",
            "params": [
              {
                "name": ":userId",
                "value": "{{identity}}"
              }
            ]
          }
        },
        "output": true,
        "outputType": "array",
        "collapsed": true,
        "meta": []
      },
      {
        "name": "loginRoute",
        "module": "dbupdater",
        "action": "custom",
        "options": {
          "connection": "db",
          "sql": {
            "query": "SELECT COUNT(*) tenantCount,CASE WHEN COUNT(*)=0 THEN '/unauthorised' WHEN COUNT(*)>1 THEN '/login/tenant' ELSE '/' END redirectUrl FROM tbl_user_tenants ut INNER JOIN tbl_tenants t ON t.id=ut.tenantId AND t.isActive=1 AND t.lifecycleStatus NOT IN ('suspended','closed') WHERE ut.userId=:userId AND ut.actorType='human' AND ut.isActive=1 AND ut.membershipStatus='active'",
            "params": [
              {
                "name": ":userId",
                "value": "{{identity}}"
              }
            ]
          }
        },
        "output": true,
        "outputType": "array",
        "meta": [],
        "collapsed": true
      },
      {
        "name": "rejectInactiveOrUnassignedAccount",
        "module": "core",
        "action": "condition",
        "options": {
          "if": "{{userAccess.count()==0}}",
          "then": {
            "steps": {
              "name": "clearRejectedLogin",
              "module": "auth",
              "action": "logout",
              "options": {
                "provider": "security"
              }
            }
          }
        },
        "outputType": "boolean"
      },
      {
        "name": "USER_ID",
        "module": "core",
        "action": "setsession",
        "options": {
          "value": "{{identity}}"
        }
      },
      {
        "name": "TENANT_ID",
        "module": "core",
        "action": "setsession",
        "options": {
          "value": "{{userAccess[0].tenantId}}"
        }
      },
      {
        "name": "ROLE_ID",
        "module": "core",
        "action": "setsession",
        "options": {
          "value": "{{userAccess[0].roleId}}"
        }
      },
      {
        "name": "TENANT_NAME",
        "module": "core",
        "action": "setsession",
        "options": {
          "value": "{{userAccess[0].tenantName}}"
        }
      },
      {
        "name": "FNAME",
        "module": "core",
        "action": "setsession",
        "options": {
          "value": "{{userAccess[0].fName}}"
        }
      },
      {
        "name": "LNAME",
        "module": "core",
        "action": "setsession",
        "options": {
          "value": "{{userAccess[0].lName}}"
        }
      },
      {
        "name": "DISPLAY_NAME",
        "module": "core",
        "action": "setsession",
        "options": {
          "value": "{{userAccess[0].displayName}}"
        }
      },
      {
        "name": "ROLE_NAME",
        "module": "core",
        "action": "setsession",
        "options": {
          "value": "{{userAccess[0].roleName}}"
        }
      },
      {
        "name": "ROLE_KEY",
        "module": "core",
        "action": "setsession",
        "options": {
          "value": "{{userAccess[0].roleKey}}"
        }
      },
      {
        "name": "logSingleTenantLogin",
        "module": "dbupdater",
        "action": "custom",
        "options": {
          "connection": "db",
          "sql": {
            "query": "INSERT INTO tbl_activity_log (tenantId,userId,entityType,entityId,actionType,summary,afterJson,createdDate) SELECT :tenantId,:userId,'user',:userId2,'user.login',CONCAT(:displayName,' logged in to ',:tenantName),JSON_OBJECT('tenantId',:tenantId2,'role',:roleName),CURRENT_TIMESTAMP FROM tbl_activity_types at WHERE :tenantCount=1 AND at.tenantId=:tenantId3 AND at.activityKey='user.login' AND at.isActive=1 LIMIT 1",
            "params": [
              {"name": ":tenantId", "value": "{{userAccess[0].tenantId.default(0)}}"},
              {"name": ":userId", "value": "{{userAccess[0].userId.default(0)}}"},
              {"name": ":userId2", "value": "{{userAccess[0].userId.default(0)}}"},
              {"name": ":displayName", "value": "{{userAccess[0].displayName.default('')}}"},
              {"name": ":tenantName", "value": "{{userAccess[0].tenantName.default('')}}"},
              {"name": ":tenantId2", "value": "{{userAccess[0].tenantId.default(0)}}"},
              {"name": ":roleName", "value": "{{userAccess[0].roleName.default('')}}"},
              {"name": ":tenantCount", "value": "{{loginRoute[0].tenantCount}}"},
              {"name": ":tenantId3", "value": "{{userAccess[0].tenantId.default(0)}}"}
            ]
          }
        },
        "output": true
      },
      {
        "name": "redirectAfterLogin",
        "module": "core",
        "action": "redirect",
        "options": {
          "url": "{{loginRoute[0].redirectUrl.default('/unauthorised')}}",
          "status": 302
        }
      }
    ]
  }
}
