{
  "settings": {
    "options": {"restrict":{"provider":"security"},
      "nocsrf": true,
      "method": "get"
    }
  },
  "exec": {
    "steps": {
      "name": "query",
      "module": "dbupdater",
      "action": "custom",
      "options": {
        "connection": "db",
        "sql": {
          "query": "SELECT t.id AS tenantId,t.tenantName FROM tbl_user_tenants ut INNER JOIN tbl_tenants t ON t.id=ut.tenantId AND t.isActive=1 AND t.lifecycleStatus NOT IN ('suspended','closed') WHERE ut.userId=:userId AND ut.isActive=1 AND ut.membershipStatus='active' ORDER BY t.tenantName",
          "params": [
            {
              "name": ":userId",
              "value": "{{$_SESSION.USER_ID}}"
            }
          ]
        }
      },
      "output": true,
      "outputType": "array",
      "meta": [
        {
          "name": "tenantId",
          "type": "number"
        },
        {
          "name": "tenantName",
          "type": "text"
        }
      ],
      "collapsed": true
    }
  }
}
