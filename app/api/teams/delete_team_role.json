{
  "settings": {
    "options": {
      "restrict": {
        "provider": "security"
      },
      "method": "post"
    }
  },
  "meta": {
    "$_POST": [
      {
        "type": "number",
        "fieldName": "roleId",
        "options": {
          "rules": {
            "core:required": {
              "param": ""
            }
          }
        },
        "name": "roleId"
      }
    ],
    "$_SESSION": [
      {
        "type": "number",
        "name": "TENANT_ID"
      }
    ]
  },
  "exec": {
    "steps": [
      {
        "name": "permissionGrant",
        "module": "dbconnector",
        "action": "select",
        "options": {
          "connection": "db",
          "sql": {
            "type": "SELECT",
            "columns": [
              {
                "table": "tbl_role_permissions",
                "column": "id",
                "field": "grantId"
              }
            ],
            "table": {
              "name": "tbl_role_permissions"
            },
            "primary": "id",
            "joins": [],
            "params": [
              {
                "name": ":P1",
                "type": "expression",
                "value": "{{$_SESSION.USER_ID.default(0)}}"
              },
              {
                "name": ":P2",
                "type": "expression",
                "value": "{{$_SESSION.TENANT_ID.default(0)}}"
              },
              {
                "name": ":P3",
                "type": "expression",
                "value": "tenant.teams.roles.manage"
              }
            ],
            "query": "select `rp`.`id` as `grantId` from `tbl_user_tenants` as `ut` inner join `tbl_user_tenant_roles` as `utr` on `utr`.`tenantId`=`ut`.`tenantId` and `utr`.`userId`=`ut`.`userId` and `utr`.`isActive`=1 inner join `tbl_roles` as `r` on `r`.`id`=`utr`.`roleId` and `r`.`isActive`=1 and (`r`.`tenantId` is null or `r`.`tenantId`=`ut`.`tenantId`) inner join `tbl_role_permissions` as `rp` on `rp`.`roleId`=`r`.`id` inner join `tbl_permissions` as `p` on `p`.`id`=`rp`.`permissionId` and `p`.`isActive`=1 where `ut`.`userId`=? and `ut`.`tenantId`=? and `ut`.`isActive`=1 and `ut`.`membershipStatus`='active' and `p`.`permissionCode`=? limit 1"
          }
        },
        "output": true,
        "outputType": "array"
      },
      {
        "name": "requirePermission",
        "module": "core",
        "action": "condition",
        "options": {
          "if": "{{permissionGrant.count() == 0}}",
          "then": {
            "steps": {
              "name": "permissionDenied",
              "module": "core",
              "action": "response",
              "options": {
                "status": 403,
                "data": {
                  "success": false,
                  "errorCode": "PERMISSION_DENIED",
                  "message": "You do not have permission to perform this action.",
                  "permissionCode": "tenant.teams.roles.manage"
                }
              }
            }
          }
        },
        "outputType": "boolean"
      },
      {
        "name": "qryRoleUsage",
        "module": "dbupdater",
        "action": "custom",
        "options": {
          "connection": "db",
          "sql": {
            "query": "SELECT COUNT(*) AS userCount FROM tbl_team_members tm INNER JOIN tbl_team_roles tr ON tr.tenantId = tm.tenantId AND tr.teamId = tm.teamId AND tr.id = tm.teamRole WHERE tr.id = :roleId AND tr.tenantId = :tenantId",
            "params": [
              {
                "name": ":roleId",
                "value": "{{$_POST.roleId}}"
              },
              {
                "name": ":tenantId",
                "value": "{{$_SESSION.TENANT_ID}}"
              }
            ]
          }
        },
        "output": true,
        "meta": [
          {
            "name": "userCount",
            "type": "number"
          }
        ],
        "outputType": "array",
        "collapsed": true
      },
      {
        "name": "checkRoleUsage",
        "module": "core",
        "action": "condition",
        "options": {
          "if": "{{qryRoleUsage[0].userCount > 0}}",
          "then": {
            "steps": [
              {
                "name": "errRoleInUse",
                "module": "core",
                "action": "error",
                "options": {
                  "message": "This team role cannot be deleted because one or more users are still assigned to it. Move those users to another role first."
                }
              }
            ]
          },
          "else": {
            "steps": []
          }
        },
        "outputType": "boolean",
        "collapsed": true
      },
      {
        "name": "deleteTeamRole",
        "module": "dbupdater",
        "action": "custom",
        "options": {
          "connection": "db",
          "sql": {
            "query": "DELETE FROM tbl_team_roles WHERE id = :roleId AND tenantId = :tenantId",
            "params": [
              {
                "name": ":roleId",
                "value": "{{$_POST.roleId}}"
              },
              {
                "name": ":tenantId",
                "value": "{{$_SESSION.TENANT_ID}}"
              }
            ]
          }
        },
        "output": true,
        "meta": [],
        "outputType": "array",
        "collapsed": true
      }
    ]
  }
}
