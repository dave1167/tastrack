{
  "settings": {
    "options": {
      "restrict": {
        "provider": "security"
      },
      "method": "post"
    }
  },
  "meta": {
    "options": {
      "linkedFile": "/views/teams/team_roles.ejs",
      "linkedForm": "frmTeamRole"
    },
    "$_POST": [
      {
        "type": "number",
        "fieldName": "teamId",
        "options": {
          "rules": {
            "core:required": {
              "param": ""
            }
          }
        },
        "name": "teamId"
      },
      {
        "type": "text",
        "fieldName": "teamRoleName",
        "options": {
          "rules": {
            "core:required": {
              "param": ""
            }
          }
        },
        "name": "teamRoleName"
      }
    ],
    "$_SESSION": [
      {
        "type": "number",
        "name": "TENANT_ID"
      }
    ]
  },
  "exec": {
    "steps": [
      {
        "name": "permissionGrant",
        "module": "dbconnector",
        "action": "select",
        "options": {
          "connection": "db",
          "sql": {
            "type": "SELECT",
            "columns": [
              {
                "table": "tbl_role_permissions",
                "column": "id",
                "field": "grantId"
              }
            ],
            "table": {
              "name": "tbl_role_permissions"
            },
            "primary": "id",
            "joins": [],
            "params": [
              {
                "name": ":P1",
                "type": "expression",
                "value": "{{$_SESSION.USER_ID.default(0)}}"
              },
              {
                "name": ":P2",
                "type": "expression",
                "value": "{{$_SESSION.TENANT_ID.default(0)}}"
              },
              {
                "name": ":P3",
                "type": "expression",
                "value": "tenant.teams.roles.manage"
              }
            ],
            "query": "select `rp`.`id` as `grantId` from `tbl_user_tenants` as `ut` inner join `tbl_user_tenant_roles` as `utr` on `utr`.`tenantId`=`ut`.`tenantId` and `utr`.`userId`=`ut`.`userId` and `utr`.`isActive`=1 inner join `tbl_roles` as `r` on `r`.`id`=`utr`.`roleId` and `r`.`isActive`=1 and (`r`.`tenantId` is null or `r`.`tenantId`=`ut`.`tenantId`) inner join `tbl_role_permissions` as `rp` on `rp`.`roleId`=`r`.`id` inner join `tbl_permissions` as `p` on `p`.`id`=`rp`.`permissionId` and `p`.`isActive`=1 where `ut`.`userId`=? and `ut`.`tenantId`=? and `ut`.`isActive`=1 and `ut`.`membershipStatus`='active' and `p`.`permissionCode`=? limit 1"
          }
        },
        "output": true,
        "outputType": "array"
      },
      {
        "name": "requirePermission",
        "module": "core",
        "action": "condition",
        "options": {
          "if": "{{permissionGrant.count() == 0}}",
          "then": {
            "steps": {
              "name": "permissionDenied",
              "module": "core",
              "action": "response",
              "options": {
                "status": 403,
                "data": {
                  "success": false,
                  "errorCode": "PERMISSION_DENIED",
                  "message": "You do not have permission to perform this action.",
                  "permissionCode": "tenant.teams.roles.manage"
                }
              }
            }
          }
        },
        "outputType": "boolean"
      },
      {
        "name": "insTeamRole",
        "module": "dbupdater",
        "action": "insert",
        "options": {
          "connection": "db",
          "sql": {
            "type": "insert",
            "values": [
              {
                "table": "tbl_team_roles",
                "column": "tenantId",
                "type": "number",
                "value": "{{$_SESSION.TENANT_ID}}"
              },
              {
                "table": "tbl_team_roles",
                "column": "teamId",
                "type": "number",
                "value": "{{$_POST.teamId}}"
              },
              {
                "table": "tbl_team_roles",
                "column": "roleDesc",
                "type": "text",
                "value": "{{$_POST.teamRoleName}}"
              },
              {
                "table": "tbl_team_roles",
                "column": "isActive",
                "type": "boolean",
                "value": "1"
              }
            ],
            "table": "tbl_team_roles",
            "returning": "id",
            "query": "insert into `tbl_team_roles` (`tenantId`, `teamId`, `roleDesc`, `isActive`) values (?, ?, ?, ?)",
            "params": [
              {
                "name": ":P1",
                "type": "expression",
                "value": "{{$_SESSION.TENANT_ID}}",
                "test": "1"
              },
              {
                "name": ":P2",
                "type": "expression",
                "value": "{{$_POST.teamId}}",
                "test": "1"
              },
              {
                "name": ":P3",
                "type": "expression",
                "value": "{{$_POST.teamRoleName}}",
                "test": "Finance Assistant"
              },
              {
                "name": ":P4",
                "type": "expression",
                "value": "1",
                "test": "1"
              }
            ]
          }
        },
        "output": true,
        "meta": [
          {
            "name": "identity",
            "type": "text"
          },
          {
            "name": "affected",
            "type": "number"
          }
        ],
        "outputType": "object"
      }
    ]
  }
}
