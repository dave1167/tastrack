{
  "settings": {
    "options": {
      "restrict": {
        "provider": "security"
      },
      "method": "post"
    }
  },
  "meta": {
    "options": {
      "linkedFile": "/views/teams/create_team.ejs",
      "linkedForm": "frmCreateTeam"
    },
    "$_POST": [
      {
        "type": "text",
        "fieldName": "teamName",
        "options": {
          "rules": {
            "core:required": {
              "param": ""
            }
          }
        },
        "name": "teamName"
      },
      {
        "type": "text",
        "fieldName": "description",
        "name": "description"
      },
      {
        "type": "number",
        "fieldName": "isActive",
        "options": {
          "rules": {
            "core:required": {
              "param": ""
            }
          }
        },
        "name": "isActive"
      }
    ]
  },
  "exec": {
    "steps": [{"name":"requireTenantLifecycleWrite","module":"tenantLifecycle","action":"requireWrite","options":{"tenantId":"{{$_SESSION.TENANT_ID.default(0)}}","userId":"{{$_SESSION.USER_ID.default(0)}}","requireMembership":true},"output":false},
      {
        "name": "permissionGrant",
        "module": "dbconnector",
        "action": "select",
        "options": {
          "connection": "db",
          "sql": {
            "type": "SELECT",
            "columns": [
              {
                "table": "tbl_role_permissions",
                "column": "id",
                "field": "grantId"
              }
            ],
            "table": {
              "name": "tbl_role_permissions"
            },
            "primary": "id",
            "joins": [],
            "params": [
              {
                "name": ":P1",
                "type": "expression",
                "value": "{{$_SESSION.USER_ID.default(0)}}"
              },
              {
                "name": ":P2",
                "type": "expression",
                "value": "{{$_SESSION.TENANT_ID.default(0)}}"
              },
              {
                "name": ":P3",
                "type": "expression",
                "value": "tenant.teams.create"
              }
            ],
            "query": "select `rp`.`id` as `grantId` from `tbl_user_tenants` as `ut` inner join `tbl_user_tenant_roles` as `utr` on `utr`.`tenantId`=`ut`.`tenantId` and `utr`.`userId`=`ut`.`userId` and `utr`.`isActive`=1 inner join `tbl_roles` as `r` on `r`.`id`=`utr`.`roleId` and `r`.`isActive`=1 and (`r`.`tenantId` is null or `r`.`tenantId`=`ut`.`tenantId`) inner join `tbl_role_permissions` as `rp` on `rp`.`roleId`=`r`.`id` inner join `tbl_permissions` as `p` on `p`.`id`=`rp`.`permissionId` and `p`.`isActive`=1 where `ut`.`userId`=? and `ut`.`tenantId`=? and `ut`.`isActive`=1 and `ut`.`membershipStatus`='active' and `p`.`permissionCode`=? limit 1"
          }
        },
        "output": true,
        "outputType": "array"
      },
      {
        "name": "requirePermission",
        "module": "core",
        "action": "condition",
        "options": {
          "if": "{{permissionGrant.count() == 0}}",
          "then": {
            "steps": {
              "name": "permissionDenied",
              "module": "core",
              "action": "response",
              "options": {
                "status": 403,
                "data": {
                  "success": false,
                  "errorCode": "PERMISSION_DENIED",
                  "message": "You do not have permission to perform this action.",
                  "permissionCode": "tenant.teams.create"
                }
              }
            }
          }
        },
        "outputType": "boolean"
      },
      {
        "name": "insertTeam",
        "module": "dbupdater",
        "action": "custom",
        "options": {
          "connection": "db",
          "sql": {
            "query": "INSERT INTO tbl_teams (tenantId, teamName, description, isActive) VALUES (:tenantId, :teamName, :description, :isActive)",
            "params": [
              {
                "name": ":tenantId",
                "value": "{{$_SESSION.TENANT_ID}}",
                "recid": 1
              },
              {
                "name": ":teamName",
                "value": "{{$_POST.teamName}}",
                "recid": 2
              },
              {
                "name": ":description",
                "value": "{{$_POST.description}}",
                "recid": 3
              },
              {
                "name": ":isActive",
                "value": "{{$_POST.isActive.default(1)}}",
                "recid": 4
              }
            ]
          }
        },
        "output": true,
        "meta": [],
        "outputType": "array",
        "collapsed": true
      },
      {
        "module": "core",
        "action": "redirect",
        "options": {
          "url": "/teams/teams",
          "status": 302
        }
      }
    ]
  }
}
